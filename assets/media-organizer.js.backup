					aboutRow( t( 'aboutPluginVersion', 'Versio' ), config.pluginVersion || '' ),
					aboutRow( t( 'aboutPluginAuthor', 'Tekija' ), config.authorName || '' ),
					aboutRow( t( 'aboutPluginCompany', 'Yritys' ), config.companyName || 'Pecodex' ),
					aboutRow( t( 'aboutPluginWebsite', 'Verkkosivusto' ), companyUrl )
				),
			$( '<p />', { 'class': 'description pgm-mo-about-note', text: t( 'aboutBrandNote', 'Legacy PGM-nimet sailyvat vain yhteensopivuuden vuoksi. Uudet kayttoliittymat, endpointit ja paketit kayttavat Pecodex-nimia.' ) } ),
			$actions
		);
	}

	function renderColumnSettings( $body ) {
		var choices = config.columnChoices || {};
		var defaultColumns = Object.keys( choices );
		var $list = $( '<div />', { 'class': 'pgm-mo-columns-list' } );
		var $count = $( '<p />', { 'class': 'pgm-mo-columns-count', role: 'status' } );
		var $message = $( '<p />', { 'class': 'pgm-mo-modal-message', role: 'status' } );
		var $saveButton = $( '<button />', { type: 'button', 'class': 'button button-primary pgm-mo-save-settings' } )
			.append( icon( 'saved' ), $( '<span />', { text: t( 'saveSettings', 'Tallenna asetukset' ) } ) )
			.on( 'click', function() {
				if ( ! state.preferences.listColumns.length ) {
					updateColumnCount();
					return;
				}

				savePreferences( $body.closest( '.pgm-mo-modal' ) );
			} );

		function normalizeColumns( columns ) {
			var seen = {};
			var out = [];

			$.each( columns || [], function( index, column ) {
				if ( choices[ column ] && ! seen[ column ] ) {
					seen[ column ] = true;
					out.push( column );
				}
			} );

			return out;
		}

		function updateColumnCount() {
			var count = state.preferences.listColumns.length;

			$count.text( sprintf( t( 'columnsEnabled', '%d saraketta kÃ¤ytÃ¶ssÃ¤' ), count ) );
			$saveButton.prop( 'disabled', ! count );
			$message
				.toggleClass( 'is-error', ! count )
				.text( count ? '' : t( 'noColumnsSelected', 'Valitse vÃ¤hintÃ¤Ã¤n yksi sarake.' ) );
		}

		function syncColumnChecks() {
			$list.find( 'input[type="checkbox"]' ).each( function() {
				this.checked = state.preferences.listColumns.indexOf( this.value ) !== -1;
			} );
			updateColumnCount();
		}

		function setColumns( columns ) {
			state.preferences.listColumns = normalizeColumns( columns );
			syncColumnChecks();
		}

		state.preferences.listColumns = normalizeColumns( state.preferences.listColumns );

		$.each( choices, function( key, label ) {
			var $checkbox = $( '<input />', {
				type: 'checkbox',
				value: key,
				checked: state.preferences.listColumns.indexOf( key ) !== -1,
			} );

			$checkbox.on( 'change', function() {
				if ( this.checked && state.preferences.listColumns.indexOf( key ) === -1 ) {
					state.preferences.listColumns.push( key );
				}
				if ( ! this.checked ) {
					state.preferences.listColumns = state.preferences.listColumns.filter( function( value ) {
						return value !== key;
					} );
				}
				updateColumnCount();
			} );

			$list.append(
				$( '<label />', { 'class': 'pgm-mo-column-choice' } )
					.append( $checkbox, $( '<span />', { text: label } ) )
			);
		} );

		$body.empty().append(
			$( '<div />', { 'class': 'pgm-mo-columns-header' } )
				.append(
					$( '<button />', { type: 'button', 'class': 'button-link pgm-mo-back-button', text: '< ' + t( 'back', 'Takaisin' ) } )
						.on( 'click', function() {
							renderSettingsMain( $body );
						} ),
					$( '<h3 />', { text: t( 'manageColumns', 'Hallitse sarakkeita' ) } ),
					$( '<p />', { text: t( 'columnsHelp', 'Valitse sarakkeet, jotka nÃ¤kyvÃ¤t listanÃ¤kymÃ¤ssÃ¤.' ) } )
				),
			$( '<div />', { 'class': 'pgm-mo-columns-actions' } )
				.append(
					$( '<button />', { type: 'button', 'class': 'button button-secondary', text: t( 'selectAllColumns', 'Valitse kaikki' ) } )
						.on( 'click', function() {
							setColumns( defaultColumns );
						} ),
					$( '<button />', { type: 'button', 'class': 'button button-secondary', text: t( 'clearColumns', 'TyhjennÃ¤' ) } )
						.on( 'click', function() {
							setColumns( [] );
						} ),
					$( '<button />', { type: 'button', 'class': 'button button-secondary', text: t( 'resetColumns', 'Palauta oletukset' ) } )
						.on( 'click', function() {
							setColumns( defaultColumns );
						} )
				),
			$count,
			$list,
			$saveButton,
			$message
		);

		updateColumnCount();
	}

	function metadataDefaultsSummaryText() {
		var defaults = normalizeDefaultAttributes( state.preferences.defaultAttributes || {} );
		var count = 0;

		$.each( defaults, function( group, fields ) {
			$.each( fields, function( field, value ) {
				if ( String( value || '' ).trim() ) {
					count++;
				}
			} );
		} );

		return sprintf(
			state.preferences.overwriteAttributes
				? t( 'metadataDefaultsSummaryOverwrite', '%d kenttÃ¤Ã¤ kÃ¤ytÃ¶ssÃ¤ Â· korvaa olemassa olevat' )
				: t( 'metadataDefaultsSummary', '%d kenttÃ¤Ã¤ kÃ¤ytÃ¶ssÃ¤' ),
			count
		);
	}

	function renderMetadataDefaultSettings( $body ) {
		var groups = attributeGroups();
		var fields = attributeFields();
		var defaults = normalizeDefaultAttributes( state.preferences.defaultAttributes || {} );
		var $message = $( '<p />', { 'class': 'pgm-mo-modal-message', role: 'status' } );
		var $saveButton = $( '<button />', { type: 'button', 'class': 'button button-primary pgm-mo-save-settings' } )
			.append( icon( 'saved' ), $( '<span />', { text: t( 'saveSettings', 'Tallenna asetukset' ) } ) )
			.on( 'click', function() {
				savePreferences( $body.closest( '.pgm-mo-modal' ) );
			} );
		var $groups = $( '<div />', { 'class': 'pgm-mo-metadata-defaults' } );

		state.preferences.defaultAttributes = defaults;

		$.each( groups, function( group, label ) {
			var $group = $( '<section />', { 'class': 'pgm-mo-metadata-group' } )
				.append( $( '<h4 />', { text: label } ) );

			$.each( fields, function( field, fieldLabel ) {
				var $textarea = $( '<textarea />', {
					rows: 2,
					placeholder: t( 'metadataPlaceholder', 'TyhjÃ¤ kenttÃ¤ ei muuta mediaa.' ),
				} ).val( defaults[ group ][ field ] ).on( 'input', function() {
					state.preferences.defaultAttributes[ group ][ field ] = $( this ).val();
				} );

				$group.append(
					$( '<label />', { 'class': 'pgm-mo-metadata-field' } )
						.append( $( '<span />', { text: fieldLabel } ), $textarea )
				);
			} );

			$groups.append( $group );
		} );

		$body.empty().append(
			$( '<div />', { 'class': 'pgm-mo-subsettings-header' } )
				.append(
					$( '<button />', { type: 'button', 'class': 'button-link pgm-mo-back-button', text: '< ' + t( 'back', 'Takaisin' ) } )
						.on( 'click', function() {
							renderSettingsMain( $body );
						} ),
					$( '<h3 />', { text: t( 'metadataDefaults', 'Oletusmetatiedot' ) } ),
					$( '<p />', { 'class': 'description', text: t( 'metadataDefaultsHelp', 'Dynaamiset tagit: {filename}, {title}, {date}, {site_name}, {mime}, {extension}, {folder}. TyhjÃ¤ kenttÃ¤ ei muuta mediaa.' ) } )
				),
			settingSwitch( t( 'overwriteAttributes', 'Korvaa olemassa olevat kentÃ¤t latauksessa' ), state.preferences.overwriteAttributes, function( value ) {
				state.preferences.overwriteAttributes = value;
			} ),
			$groups,
			$saveButton,
			$message
		);
	}

	function renderDisplayDefaultSettings( $body ) {
		var defaults = normalizeDisplayDefaults( state.preferences.displayDefaults || {} );
		var $message = $( '<p />', { 'class': 'pgm-mo-modal-message', role: 'status' } );
		var $saveButton = $( '<button />', { type: 'button', 'class': 'button button-primary pgm-mo-save-settings' } )
