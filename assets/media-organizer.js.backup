				),
			0 === ( includeChildren ? count : directCount ) ? $( '<p />', { 'class': 'description', text: t( 'exportFolderEmpty', 'Kansiossa ei ole nÃ¤kyviÃ¤ mediatiedostoja. ZIP-lataus voi olla tyhjÃ¤.' ) } ) : $(),
			$( '<div />', { 'class': 'pgm-mo-property-actions' } )
