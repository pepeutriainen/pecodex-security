	function setMessage( $sidebar, message, isError ) {
		$sidebar.find( '.pgm-mo-message' ).first()
			.toggleClass( 'is-error', !! isError )
			.text( message || '' );
	}

	function copyTextToClipboard( text ) {
		var deferred = $.Deferred();
		var $textarea;
		var success = false;

		text = String( text || '' );

		if ( navigator.clipboard && navigator.clipboard.writeText ) {
			navigator.clipboard.writeText( text )
				.then( function() {
					deferred.resolve();
				} )
				.catch( function() {
					deferred.reject();
				} );
			return deferred.promise();
		}

		$textarea = $( '<textarea />', {
			readonly: 'readonly',
			value: text,
		} ).css( {
			position: 'fixed',
			left: '-9999px',
			top: '0',
		} ).appendTo( document.body );

		$textarea[0].select();
		try {
			success = document.execCommand( 'copy' );
		} catch ( error ) {
			success = false;
		}
		$textarea.remove();

		if ( success ) {
			deferred.resolve();
		} else {
			deferred.reject();
		}

		return deferred.promise();
	}

	function clampSidebarWidth( width ) {
		width = parseInt( width, 10 ) || state.preferences.folderTreeWidth || 326;
		return Math.min( 520, Math.max( 220, width ) );
	}

	function applySidebarWidth( width ) {
		width = clampSidebarWidth( width );
		state.preferences.folderTreeWidth = width;
		$( '.pgm-mo-sidebar, .pgm-mo-has-sidebar, .pgm-mo-frame-has-sidebar' ).css( '--pgm-mo-tree-width', width + 'px' );
	}

	function preferencesPayload() {
		return {
			startup_folder: state.preferences.startupFolder,
			infinite_scroll_grid: state.preferences.infiniteScrollGrid ? 1 : 0,
			grid_size: state.preferences.gridSize,
			default_sort: state.preferences.defaultSort || 'date_desc',
			deep_search_default: state.preferences.deepSearchDefault ? 1 : 0,
			display_defaults: normalizeDisplayDefaults( state.preferences.displayDefaults || {} ),
			folder_tree_width: state.preferences.folderTreeWidth,
			show_counts: state.preferences.showCounts ? 1 : 0,
			show_empty_folders: state.preferences.showEmptyFolders ? 1 : 0,
			include_children: state.preferences.includeChildren ? 1 : 0,
			list_columns: state.preferences.listColumns,
			overwrite_attributes: state.preferences.overwriteAttributes ? 1 : 0,
			default_attributes: normalizeDefaultAttributes( state.preferences.defaultAttributes || {} ),
		};
	}

	function privateSettingsPayload() {
		var settings = normalizePrivateSettings( state.privateSettings || {} );

		return {
			enabled: settings.enabled ? 1 : 0,
			login_mode: settings.loginMode,
			custom_login_url: settings.customLoginUrl,
			protect_mode: settings.protectMode,
			protected_extensions: settings.protectedExtensions,
			protect_unknown_uploads: settings.protectUnknownUploads ? 1 : 0,
			move_files_to_private_storage: settings.moveFilesToPrivateStorage ? 1 : 0,
			required_capability: settings.requiredCapability,
		};
	}

	function folderUrl( folderId ) {
		var url = new URL( config.uploadUrl || window.location.href, window.location.origin );
		var params = url.searchParams;

		if ( parseInt( folderId, 10 ) ) {
			params.set( queryArgs.folder, folderId );
		} else {
			params.delete( queryArgs.folder );
		}
		params.delete( queryArgs.legacyFolder );

		if ( state.sort ) {
			params.set( queryArgs.order, state.sort );
		}
		params.delete( queryArgs.legacyOrder );

		if ( state.deepSearch ) {
			params.set( queryArgs.deepSearch, '1' );
		} else {
			params.delete( queryArgs.deepSearch );
		}
		params.delete( queryArgs.legacyDeepSearch );

		return url.toString();
	}

	function mediaQueryProps() {
		var props = {};
		props[ queryArgs.folder ] = parseInt( state.selectedFolder, 10 ) || 0;
		props[ queryArgs.order ] = state.sort || state.preferences.defaultSort || 'date_desc';
		props[ queryArgs.deepSearch ] = state.deepSearch ? 1 : 0;
		props[ queryArgs.refresh ] = Date.now();
		props[ queryArgs.legacyFolder ] = null;
		props[ queryArgs.legacyOrder ] = null;
		props[ queryArgs.legacyDeepSearch ] = null;
		return props;
	}

	function queryParamKey( key ) {
		return 'query[' + key + ']';
	}

	function applyMediaQueryPropsToObject( data ) {
		var props;

		if ( ! data || data.action !== 'query-attachments' ) {
			return false;
		}

		if ( ! data.query || typeof data.query !== 'object' ) {
			data.query = {};
		}

		props = mediaQueryProps();
		$.each( props, function( key, value ) {
			if ( value === null ) {
				delete data.query[ key ];
			} else {
				data.query[ key ] = value;
			}
		} );

		scheduleStateRefreshForFilters( extractMediaQueryFiltersFromObject( data.query ) );

		return true;
	}

	function applyMediaQueryPropsToString( rawData ) {
		var params;
		var props;

		if ( typeof URLSearchParams === 'undefined' || typeof rawData !== 'string' || rawData.indexOf( 'query-attachments' ) === -1 ) {
			return rawData;
		}

		params = new URLSearchParams( rawData );
		if ( params.get( 'action' ) !== 'query-attachments' ) {
			return rawData;
		}

		props = mediaQueryProps();
		$.each( props, function( key, value ) {
			var paramKey = queryParamKey( key );
			if ( value === null ) {
				params.delete( paramKey );
			} else {
				params.set( paramKey, String( value ) );
			}
		} );

		scheduleStateRefreshForFilters( extractMediaQueryFiltersFromObject( {
			type: params.getAll( queryParamKey( 'type' ) + '[]' ).length ? params.getAll( queryParamKey( 'type' ) + '[]' ) : params.get( queryParamKey( 'type' ) ),
			post_mime_type: params.getAll( queryParamKey( 'post_mime_type' ) + '[]' ).length ? params.getAll( queryParamKey( 'post_mime_type' ) + '[]' ) : params.get( queryParamKey( 'post_mime_type' ) ),
			mime_type: params.getAll( queryParamKey( 'mime_type' ) + '[]' ).length ? params.getAll( queryParamKey( 'mime_type' ) + '[]' ) : params.get( queryParamKey( 'mime_type' ) ),
			uploadedTo: params.get( queryParamKey( 'uploadedTo' ) ),
			uploaded_to: params.get( queryParamKey( 'uploaded_to' ) ),
			author: params.get( queryParamKey( 'author' ) ),
			year: params.get( queryParamKey( 'year' ) ),
			monthnum: params.get( queryParamKey( 'monthnum' ) ),
			m: params.get( queryParamKey( 'm' ) ),
			s: params.get( queryParamKey( 's' ) ),
			search: params.get( queryParamKey( 'search' ) ),
