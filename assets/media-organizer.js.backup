	function appendAboutSettingsCard( $body ) {
		var $card = $( '<div />', { 'class': 'pgm-mo-setting-group' } )
			.append( $( '<label />', { text: t( 'aboutPecodex', 'Tietoja ja tuki' ) } ) )
			.append(
				$( '<button />', { type: 'button', 'class': 'pgm-mo-manage-card' } )
					.append(
						$( '<span />' ).append( $( '<strong />', { text: t( 'manageAboutPecodex', 'Pecodex Media Control' ) } ), $( '<small />', { text: t( 'aboutPecodexSummary', 'Versio, tekija ja tukilinkit' ) } ) ),
						$( '<span />', { 'class': 'pgm-mo-card-arrow', text: '>' } )
					)
					.on( 'click', function() {
						renderAboutPecodexSettings( $body );
					} )
			);
		var $save = $body.find( '.pgm-mo-save-settings' ).first();

		if ( $save.length ) {
			$save.before( $card );
		} else {
			$body.append( $card );
		}
	}

	function libraryLayoutSummaryText() {
		var gridChoices = {
			small: t( 'gridSmall', 'Pieni' ),
			medium: t( 'gridMedium', 'Keskikokoinen' ),
			large: t( 'gridLarge', 'Suuri' ),
		};
		var grid = gridChoices[ state.preferences.gridSize ] || state.preferences.gridSize || '-';
		var sort = ( config.sortOptions || {} )[ state.preferences.defaultSort ] || state.preferences.defaultSort || '-';

		return sprintf( t( 'libraryLayoutSettingsSummary', 'Ruudukko: %s Â· jÃ¤rjestys: %s' ), grid, sort );
	}

	function renderLibraryLayoutSettings( $body ) {
