		if ( ! image && ( ! type || type === 'image' ) && $attachment && $attachment.length ) {
			image = $attachment.find( '.thumbnail img, .attachment-preview img' ).not( '.icon, .pgm-mo-file-asset' ).first().attr( 'src' ) || '';
