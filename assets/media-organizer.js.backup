	function attachmentTypeFromFilename( label ) {
		var lower = String( label || '' ).toLowerCase();

		if ( /\.(jpe?g|png|gif|webp|avif|bmp|tiff?|svg)$/.test( lower ) ) {
			return 'image';
		}
		if ( /\.pdf$/.test( lower ) ) {
			return 'pdf';
		}
		if ( /\.(docx?|rtf|odt)$/.test( lower ) ) {
			return 'word';
		}
		if ( /\.(xlsx?|csv|ods)$/.test( lower ) ) {
			return 'excel';
		}
		if ( /\.(pptx?|ppsx?|odp)$/.test( lower ) ) {
			return 'powerpoint';
		}
		if ( /\.(mp3|m4a|ogg|wav|flac)$/.test( lower ) ) {
			return 'audio';
		}
		if ( /\.(mp4|mov|m4v|webm|avi)$/.test( lower ) ) {
			return 'video';
		}
		if ( /\.(zip|rar|7z|tar|gz)$/.test( lower ) ) {
