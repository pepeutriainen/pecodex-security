		if ( ! ids.length ) {
			writeMessage( t( 'noSelection', 'Valitse ensin mediatiedostoja.' ), true );
			return;
		}

		writeMessage( t( 'removingFromFolder', 'Poistetaan kansiosta...' ) );

		ajax( 'pecodex_mo_unassign_attachments', {
			folder_id: folderId,
			attachment_ids: ids,
		} )
			.done( function( response ) {
				if ( ! response || ! response.success ) {
					writeMessage( response && response.data && response.data.message ? response.data.message : t( 'error', 'Action failed.' ), true );
					clearAttachmentSelection( $sidebar );
					return;
				}

				state.folders = response.data.folders || state.folders;
				state.flatFolders = response.data.flatFolders || state.flatFolders; if (response.data && response.data.counts) { state.counts = response.data.counts; }
				writeMessage( response.data.message || t( 'done', 'Done.' ) );
				clearAttachmentSelection( $sidebar );
				renderAllSidebars();
				refreshGridIfPossible( $sidebar );
				window.setTimeout( function() {
					clearAttachmentSelection( $sidebar );
				}, 120 );
				if ( options.onDone ) {
					options.onDone( response );
				}
			} )
			.fail( function( xhr ) {
				var message = xhr.responseJSON && xhr.responseJSON.data && xhr.responseJSON.data.message ? xhr.responseJSON.data.message : t( 'error', 'Action failed.' );
				writeMessage( message, true );
				clearAttachmentSelection( $sidebar );
			} );
	}

	function populateMoveFolderOptions( $select, selectedFolder ) {
		selectedFolder = parseInt( selectedFolder, 10 ) || 0;
		$select.empty();
		$( '<option />', {
			value: 0,
			text: t( 'moveToUncategorized', 'Ilman kansiota' ),
		} ).prop( 'selected', 0 === selectedFolder ).appendTo( $select );

		walkFolders( state.folders, function( folder, depth ) {
			if ( folder.special ) {
				return;
			}
			$( '<option />', {
				value: folder.id,
				text: Array( depth + 1 ).join( '- ' ) + folder.name,
			} ).prop( 'selected', parseInt( folder.id, 10 ) === selectedFolder ).appendTo( $select );
		} );
	}

	function showMoveMediaModal( attachmentIds, $sidebar ) {
		var ids = attachmentIds && attachmentIds.length ? normalizeAttachmentIds( attachmentIds ) : getSelectedAttachmentIds( $sidebar );
		var $overlay;
		var $dialog;
		var $body;
		var $select;
		var $protectionSummary;
		var $message;
		var selectedFolder = parseInt( state.selectedFolder, 10 ) > 0 ? parseInt( state.selectedFolder, 10 ) : 0;

		if ( ! ids.length ) {
			setMessage( $sidebar, t( 'noSelection', 'Valitse ensin mediatiedostoja.' ), true );
			return;
		}

		function close() {
			$( document ).off( '.pgmMoMoveMedia' );
			$overlay.remove();
		}

		function updateMoveProtectionSummary() {
			var targetId = parseInt( $select.val() || 0, 10 ) || 0;
			var targetFolder = targetId > 0 ? folderById( targetId ) : null;
			var effectiveAccess = targetFolder ? folderEffectiveAccess( targetFolder ) : 'public';
			var summaryText = effectiveAccess === 'public'
				? t( 'moveTargetPublicHelp', 'Kohdekansio ei lisÃ¤Ã¤ suojausta. Tiedostojen nykyinen suojaus sÃ¤ilyy ennallaan.' )
				: t( 'moveTargetProtectedHelp', 'Kun tiedostot siirretÃ¤Ã¤n tÃ¤hÃ¤n kansioon, kansion suojaus lukitsee ne automaattisesti.' );

			$protectionSummary
				.attr( 'class', 'pgm-mo-property-protection is-' + effectiveAccess )
				.empty()
				.append(
					$( '<div />' )
						.append( $( '<span />', { text: t( 'targetFolderProtection', 'Kohdekansion suojaus' ) } ) )
						.append( $( '<strong />', { text: targetFolder ? folderAccessLabel( effectiveAccess, false ) : folderAccessLabel( 'public', false ) } ) ),
					$( '<div />' )
						.append( $( '<span />', { text: t( 'selectedFiles', 'Valitut tiedostot' ) } ) )
						.append( $( '<strong />', { text: String( ids.length ) } ) ),
					$( '<p />', { text: summaryText } )
				);
		}

		$overlay = $( '<div />', { 'class': 'pgm-mo-modal-overlay' } );
		$dialog = $( '<div />', { 'class': 'pgm-mo-modal pgm-mo-move-media-modal', role: 'dialog', 'aria-modal': 'true', 'aria-labelledby': 'pgm-mo-move-media-title' } );
		$body = $( '<div />', { 'class': 'pgm-mo-modal-body pgm-mo-move-media' } );
		$select = $( '<select />', { 'class': 'pgm-mo-property-input' } );
		$protectionSummary = $( '<div />' );
		$message = $( '<p />', { 'class': 'pgm-mo-modal-message', role: 'status' } );
		populateMoveFolderOptions( $select, selectedFolder );
		$select.on( 'change', updateMoveProtectionSummary );

		$dialog.append(
			$( '<div />', { 'class': 'pgm-mo-modal-header' } )
				.append( $( '<h2 />', { id: 'pgm-mo-move-media-title', text: t( 'moveToFolderTitle', 'SiirrÃ¤ mediatiedostot kansioon' ) } ) )
				.append( $( '<button />', { type: 'button', 'class': 'pgm-mo-modal-close', text: 'Ã—', title: t( 'close', 'Sulje' ) } ).on( 'click', close ) ),
			$body
		);

		$body.append(
			$( '<div />', { 'class': 'pgm-mo-move-media-summary' } )
				.append( icon( 'folder' ), $( '<strong />', { text: ids.length + ' ' + t( 'selectedFiles', 'valittua' ) } ) )
				.append( $( '<span />', { text: t( 'moveFolderHelp', 'TÃ¤mÃ¤ vaihtaa vain mediakirjaston kansioluokituksen. Varsinaista tiedostoa ei poisteta.' ) } ) ),
			$( '<label />', { 'class': 'pgm-mo-property-row' } )
				.append( $( '<span />', { text: t( 'chooseTargetFolder', 'Kohdekansio' ) } ), $select ),
			$protectionSummary,
			$( '<div />', { 'class': 'pgm-mo-property-actions' } )
				.append(
					$( '<button />', { type: 'button', 'class': 'button', text: t( 'cancel', 'Peruuta' ) } ).on( 'click', close ),
					$( '<button />', { type: 'button', 'class': 'button button-primary' } )
						.append( icon( 'folder' ), $( '<span />', { text: t( 'moveFiles', 'SiirrÃ¤' ) } ) )
						.on( 'click', function() {
							assignAttachmentsToFolder( parseInt( $select.val() || 0, 10 ) || 0, ids, $sidebar, {
								message: t( 'movingFiles', 'SiirretÃ¤Ã¤n tiedostoja...' ),
								clearSelection: true,
								$message: $message,
								onDone: close,
							} );
						} )
				),
			$message
		);

		$overlay.append( $dialog );
		$( document.body ).append( $overlay );
		$overlay.on( 'mousedown', function( event ) {
			if ( event.target === $overlay[0] ) {
				close();
			}
		} );
		$( document ).on( 'keydown.pgmMoMoveMedia', function( event ) {
			if ( event.key === 'Escape' ) {
				close();
			}
		} );
		updateMoveProtectionSummary();
		$select.trigger( 'focus' );
	}

	function showBulkPrivacyModal( intent, $sidebar, attachmentIds ) {
		var ids = attachmentIds && attachmentIds.length ? normalizeAttachmentIds( attachmentIds ) : getSelectedAttachmentIds( $sidebar );
		var isProtect = intent === 'hide';
		var $overlay;
		var $dialog;
		var $body;
		var $message;

		if ( ! ids.length ) {
			setMessage( $sidebar, t( 'noSelection', 'Valitse ensin mediatiedostoja.' ), true );
			return;
		}

		function close() {
			$( document ).off( '.pgmMoBulkPrivacy' );
			$overlay.remove();
		}

		$overlay = $( '<div />', { 'class': 'pgm-mo-modal-overlay' } );
		$dialog = $( '<div />', { 'class': 'pgm-mo-modal pgm-mo-privacy-modal', role: 'dialog', 'aria-modal': 'true', 'aria-labelledby': 'pgm-mo-privacy-title' } );
		$body = $( '<div />', { 'class': 'pgm-mo-modal-body pgm-mo-privacy-action' } );
		$message = $( '<p />', { 'class': 'pgm-mo-modal-message', role: 'status' } );

		$dialog.append(
			$( '<div />', { 'class': 'pgm-mo-modal-header' } )
				.append( $( '<h2 />', {
					id: 'pgm-mo-privacy-title',
					text: isProtect
						? t( 'confirmProtectMediaTitle', 'Suojaa valitut mediatiedostot?' )
						: t( 'confirmUnprotectMediaTitle', 'Poista suojaus valituilta?' ),
				} ) )
				.append( $( '<button />', { type: 'button', 'class': 'pgm-mo-modal-close', text: 'Ã—', title: t( 'close', 'Sulje' ) } ).on( 'click', close ) ),
			$body
		);

		$body.append(
			$( '<div />', { 'class': 'pgm-mo-privacy-summary' } )
				.append( icon( isProtect ? 'lock' : 'unlock' ) )
				.append(
					$( '<div />' )
						.append( $( '<strong />', { text: ids.length + ' ' + t( 'selectedFiles', 'valittua' ) } ) )
						.append( $( '<span />', { text: t( 'privacySelectedFiles', 'Valitut mediatiedostot' ) } ) )
				),
			$( '<p />', {
				'class': 'description',
				text: isProtect
					? t( 'confirmProtectMediaBody', 'Valitut tiedostot merkitÃ¤Ã¤n suojatuiksi ja public uploads -kopio poistetaan, kun private-varasto on valmis.' )
					: t( 'confirmUnprotectMediaBody', 'Valitut tiedostot palautetaan julkisiksi vain, jos kansio tai asetussÃ¤Ã¤ntÃ¶ ei pidÃ¤ niitÃ¤ edelleen suojattuina.' ),
			} ),
			$( '<div />', { 'class': 'pgm-mo-privacy-result is-' + ( isProtect ? 'protect' : 'unprotect' ) } )
				.append( isProtect ? icon( 'lock' ) : wordpressIcon() )
				.append( $( '<span />', {
					text: isProtect
						? t( 'privacyProtectedResult', 'Vanha uploads-linkki ohjataan kirjautumiseen, kun tiedosto on suojattu.' )
						: t( 'privacyUnprotectedResult', 'Julkiseksi palautettu tiedosto toimii taas normaalina WordPress-mediatiedostona.' ),
				} ) ),
			$( '<div />', { 'class': 'pgm-mo-property-actions' } )
				.append(
					$( '<button />', { type: 'button', 'class': 'button', text: t( 'cancel', 'Peruuta' ) } ).on( 'click', close ),
					$( '<button />', {
						type: 'button',
						'class': 'button button-primary' + ( isProtect ? '' : ' pgm-mo-neutral-button' ),
					} )
						.append( icon( isProtect ? 'lock' : 'unlock' ), $( '<span />', {
							text: isProtect
								? t( 'privacyActionProtect', 'Suojaa tiedostot' )
								: t( 'privacyActionUnprotect', 'Poista suojaus' ),
						} ) )
						.on( 'click', function() {
							bulkTogglePrivacy( intent, $sidebar, ids, {
								$message: $message,
								onDone: close,
							} );
						} )
				),
			$message
		);

		$overlay.on( 'mousedown', function( event ) {
			if ( event.target === $overlay[0] ) {
				close();
			}
		} );
		$( document ).on( 'keydown.pgmMoBulkPrivacy', function( event ) {
			if ( event.key === 'Escape' ) {
				close();
			}
		} );

		$overlay.append( $dialog );
		$( document.body ).append( $overlay );
		$dialog.find( '.button' ).first().trigger( 'focus' );
	}

	function bulkTogglePrivacy( intent, $sidebar, attachmentIds, options ) {
		var ids = attachmentIds && attachmentIds.length ? normalizeAttachmentIds( attachmentIds ) : getSelectedAttachmentIds( $sidebar );
		var label = intent === 'hide' ? t( 'bulkProtecting', 'Suojataan valitut...' ) : t( 'bulkUnprotecting', 'Poistetaan suojaus...' );
		var $message;

		options = options || {};
		$message = options.$message || null;

		function writeMessage( message, isError ) {
			if ( $message && $message.length ) {
				$message.toggleClass( 'is-error', !! isError ).text( message );
			}
			setMessage( $sidebar, message, !! isError );
		}

		if ( ! ids.length ) {
			writeMessage( t( 'noSelection', 'Valitse ensin mediatiedostoja.' ), true );
			return;
		}

		writeMessage( label );

		ajax( 'pecodex_bulk_toggle_attachment_privacy', {
			nonce: config.privacyNonce || config.nonce,
			intent: intent,
			attachment_ids: ids,
		} )
			.done( function( response ) {
				if ( ! response || ! response.success ) {
					writeMessage( response && response.data && response.data.message ? response.data.message : t( 'error', 'Action failed.' ), true );
					return;
				}

				writeMessage( response.data.message || t( 'done', 'Done.' ) );
				applyAttachmentDataMapToModels( response.data.attachments );
				forceBrowserCacheReload( response.data.cacheClearUrls );
				clearAttachmentSelection( $sidebar );
				refreshGridIfPossible( $sidebar );
				window.setTimeout( function() {
					clearAttachmentSelection( $sidebar );
				}, 120 );
				if ( options.onDone ) {
					options.onDone( response );
				}
			} )
			.fail( function( xhr ) {
				var message = xhr.responseJSON && xhr.responseJSON.data && xhr.responseJSON.data.message ? xhr.responseJSON.data.message : t( 'error', 'Action failed.' );
				writeMessage( message, true );
				clearAttachmentSelection( $sidebar );
			} );
	}

	function nearestSidebar( $element ) {
		var $sidebar = $element && $element.length ? $element.closest( '.pgm-mo-frame-has-sidebar, .pgm-mo-has-sidebar' ).find( '.pgm-mo-sidebar' ).first() : $();

		if ( ! $sidebar.length ) {
			$sidebar = $( '.pgm-mo-sidebar' ).first();
		}

		return $sidebar;
	}

	function attachmentModel( id ) {
		if ( wp && wp.media && wp.media.attachment ) {
			return wp.media.attachment( id );
		}

		return null;
	}

	function applyAttachmentDataToModel( attachment ) {
		var model;

		if ( ! attachment || ! attachment.id || ! wp || ! wp.media || ! wp.media.attachment ) {
			return;
		}

		model = wp.media.attachment( attachment.id );
		if ( model && model.set ) {
			model.set( attachment );
		}
	}

	function applyAttachmentDataMapToModels( attachments ) {
		if ( ! attachments ) {
			return;
		}

		if ( Array.isArray( attachments ) ) {
			attachments.forEach( applyAttachmentDataToModel );
			return;
		}

		Object.keys( attachments ).forEach( function( key ) {
			applyAttachmentDataToModel( attachments[ key ] );
		} );
	}

	function attachmentEditUrl( id ) {
		var url = new URL( config.uploadUrl || window.location.href, window.location.origin );

		url.pathname = url.pathname.replace( /upload\.php$/, 'post.php' );
		url.search = 'post=' + encodeURIComponent( id ) + '&action=edit';

		return url.toString();
	}

	function attachmentUrlFromModel( model ) {
		if ( ! model || ! model.get ) {
			return '';
		}

		return model.get( 'url' ) || model.get( 'link' ) || '';
	}

	function attachmentLabel( id, $attachment ) {
		var model = attachmentModel( id );
		var label = '';

		if ( model && model.get ) {
			label = model.get( 'filename' ) || model.get( 'title' ) || '';
		}

		if ( ! label && $attachment && $attachment.length ) {
			label = $.trim( $attachment.find( '.filename, .title' ).first().text() );
		}

		return label || 'Mediatiedosto';
	}

	function openAttachmentFile( id ) {
		var model = attachmentModel( id );
		var url = attachmentUrlFromModel( model );
		var newWindow;

		if ( url ) {
			window.open( url, '_blank', 'noopener' );
			return;
		}

		if ( model && model.fetch ) {
			newWindow = window.open( '', '_blank', 'noopener' );
			model.fetch()
				.done( function() {
					var fetchedUrl = attachmentUrlFromModel( model );
					if ( newWindow ) {
						newWindow.location.href = fetchedUrl || attachmentEditUrl( id );
					}
				} )
				.fail( function() {
					if ( newWindow ) {
						newWindow.location.href = attachmentEditUrl( id );
					}
				} );
			return;
		}

		window.open( attachmentEditUrl( id ), '_blank', 'noopener' );
	}

	function openAttachmentDetails( id, context ) {
		var frame = currentMediaFrame( context );
		var model = attachmentModel( id );

		if ( frame && frame.trigger && model ) {
			if ( model.fetch && ! model.get( 'filename' ) ) {
				model.fetch().always( function() {
					frame.trigger( 'edit:attachment', model );
				} );
			} else {
				frame.trigger( 'edit:attachment', model );
			}
			return;
		}

		window.location.href = attachmentEditUrl( id );
	}

	function deleteAttachmentsNow( ids, $sidebar, $message, closeModal ) {
		$message.removeClass( 'is-error' ).text( t( 'saving', 'Tallennetaan...' ) );

		ajax( 'pecodex_bulk_delete_attachments', {
			nonce: config.deleteNonce || config.nonce,
			attachment_ids: ids,
		} )
			.done( function( response ) {
				if ( ! response || ! response.success ) {
					$message.addClass( 'is-error' ).text( response && response.data && response.data.message ? response.data.message : t( 'error', 'Toimintoa ei voitu suorittaa.' ) );
					return;
				}

				clearAttachmentSelection( $sidebar );
				setMessage( $sidebar, response.data.message || t( 'done', 'Valmis.' ) );
				if ( closeModal ) {
					closeModal();
				}
				loadState().always( function() {
					refreshGridIfPossible( $sidebar );
				} );
				window.setTimeout( function() {
					clearAttachmentSelection( $sidebar );
				}, 120 );
			} )
			.fail( function( xhr ) {
				var message = xhr.responseJSON && xhr.responseJSON.data && xhr.responseJSON.data.message ? xhr.responseJSON.data.message : t( 'error', 'Toimintoa ei voitu suorittaa.' );
				$message.addClass( 'is-error' ).text( message );
			} );
	}

	function showDeleteMediaModal( ids, $sidebar ) {
		var normalized = normalizeAttachmentIds( ids );
		var count = normalized.length;
		var $overlay;
		var $dialog;
		var $body;
		var $message;

		if ( ! count ) {
			setMessage( $sidebar, t( 'noSelection', 'Valitse ensin yksi tai useampi mediatiedosto.' ), true );
			return;
		}

		function close() {
			$( document ).off( '.pgmMoDeleteMedia' );
			$overlay.remove();
		}

		$overlay = $( '<div />', { 'class': 'pgm-mo-modal-overlay' } );
		$dialog = $( '<div />', { 'class': 'pgm-mo-modal pgm-mo-delete-media-modal', role: 'dialog', 'aria-modal': 'true', 'aria-labelledby': 'pgm-mo-delete-media-title' } );
		$body = $( '<div />', { 'class': 'pgm-mo-modal-body pgm-mo-delete-media' } );
		$message = $( '<p />', { 'class': 'pgm-mo-modal-message', role: 'status' } );

		$dialog.append(
			$( '<div />', { 'class': 'pgm-mo-modal-header' } )
				.append( $( '<h2 />', { id: 'pgm-mo-delete-media-title', text: t( 'confirmDeleteMediaTitle', 'Poista mediatiedostot?' ) } ) )
				.append( $( '<button />', { type: 'button', 'class': 'pgm-mo-modal-close', text: 'Ã—', title: t( 'close', 'Sulje' ) } ).on( 'click', close ) ),
			$body
		);

		$body.append(
			$( '<p />', {
				'class': 'pgm-mo-delete-media-summary',
				text: count === 1 ? '1 tiedosto valittu.' : count + ' tiedostoa valittu.',
			} ),
			$( '<p />', {
				'class': 'description',
				text: t( 'confirmDeleteMediaBody', 'Tiedostot poistetaan pysyvÃ¤sti Media Librarysta ja palvelimelta.' ),
			} ),
			$( '<div />', { 'class': 'pgm-mo-property-actions' } )
				.append(
					$( '<button />', { type: 'button', 'class': 'button', text: t( 'cancel', 'Peruuta' ) } ).on( 'click', close ),
					$( '<button />', { type: 'button', 'class': 'button button-primary pgm-mo-danger-button', text: t( 'deleteFiles', 'Poista tiedostot' ) } ).on( 'click', function() {
						deleteAttachmentsNow( normalized, $sidebar, $message, close );
					} )
				),
			$message
		);

		$overlay.on( 'mousedown', function( event ) {
			if ( event.target === $overlay[0] ) {
				close();
			}
		} );
		$( document ).on( 'keydown.pgmMoDeleteMedia', function( event ) {
			if ( event.key === 'Escape' ) {
				close();
			}
		} );

		$overlay.append( $dialog );
		$( document.body ).append( $overlay );
		$dialog.find( '.button' ).first().trigger( 'focus' );
	}

	function performCreateFolder( name, parent, access, $sidebar, $message, closeModal ) {
		ajax( 'pecodex_mo_create_folder', {
			name: name,
			parent: parent || 0,
			access: access || 'public',
		} )
			.done( function( response ) {
				if ( response && response.success ) {
					state.folders = response.data.folders || [];
					state.flatFolders = response.data.flatFolders || []; if (response.data && response.data.counts) { state.counts = response.data.counts; }
					state.selectedFolder = parseInt( response.data.selectedFolder || state.selectedFolder, 10 ) || state.selectedFolder;
					state.expanded[ parent || 0 ] = true;
					renderAllSidebars();
					refreshGridIfPossible( $sidebar );
					setMessage( $sidebar, t( 'done', 'Done.' ) );
					if ( closeModal ) {
						closeModal();
					}
				} else {
					$message.addClass( 'is-error' ).text( response && response.data && response.data.message ? response.data.message : t( 'error', 'Action failed.' ) );
				}
			} )
			.fail( function( xhr ) {
				var message = xhr.responseJSON && xhr.responseJSON.data && xhr.responseJSON.data.message ? xhr.responseJSON.data.message : t( 'error', 'Action failed.' );
				$message.addClass( 'is-error' ).text( message );
			} );
	}

	function populateFolderParentOptions( $select, selectedParent, excludedFolderId ) {
		selectedParent = parseInt( selectedParent || 0, 10 ) || 0;
		excludedFolderId = parseInt( excludedFolderId || 0, 10 ) || 0;

		$select.empty().append( $( '<option />', {
			value: 0,
			text: t( 'rootFolder', 'Juuritaso (Kaikki tiedostot)' ),
		} ) );

		walkFolders( state.folders, function( folder, depth ) {
			var id = parseInt( folder.id || 0, 10 ) || 0;
			var prefix;

			if ( id <= 0 || folder.special ) {
				return;
			}
			if ( excludedFolderId && ( id === excludedFolderId || folderIsDescendantOf( id, excludedFolderId ) ) ) {
				return;
			}

			prefix = Array( depth + 1 ).join( '-- ' );
			$( '<option />', {
				value: id,
				text: prefix + folder.name,
			} ).appendTo( $select );
		} );

		if ( $select.find( 'option[value="' + selectedParent + '"]' ).length ) {
			$select.val( String( selectedParent ) );
		} else {
			$select.val( '0' );
		}
	}

	function createFolder( parent, $sidebar, initialName ) {
		var selectedParent = parseInt( parent || 0, 10 ) || 0;
		var $overlay;
		var $dialog;
		var $body;
		var $name;
		var $parent;
		var $access;
		var $effective;
		var $message;

		function close() {
			$( document ).off( '.pgmMoCreateFolder' );
			$overlay.remove();
		}

		function inheritedAccessForParentId( parentId ) {
			var parentFolder = parentId > 0 ? folderById( parentId ) : null;

			return parentFolder ? folderEffectiveAccess( parentFolder ) : 'public';
		}

		function updateCreateEffectiveLabel() {
			var parentId = parseInt( $parent.val() || 0, 10 ) || 0;
			var localAccess = $access.val() || 'public';
			var effectiveAccess = strongestAccess( localAccess, inheritedAccessForParentId( parentId ) );

			$effective
				.text( folderAccessLabel( effectiveAccess, false ) )
				.attr( 'class', 'pgm-mo-property-effective is-' + effectiveAccess );
		}

		function submit() {
			var name = $.trim( $name.val() );
			var parentId = parseInt( $parent.val() || 0, 10 ) || 0;

			if ( ! name ) {
				$message.addClass( 'is-error' ).text( t( 'folderNameRequired', 'Anna kansion nimi.' ) );
				$name.trigger( 'focus' );
				return;
			}

			$message.removeClass( 'is-error' ).text( t( 'saving', 'Saving...' ) );
			performCreateFolder( name, parentId, $access.val() || 'public', $sidebar, $message, close );
		}

		$overlay = $( '<div />', { 'class': 'pgm-mo-modal-overlay' } );
		$dialog = $( '<div />', { 'class': 'pgm-mo-modal pgm-mo-create-folder-modal', role: 'dialog', 'aria-modal': 'true', 'aria-labelledby': 'pgm-mo-create-folder-title' } );
		$body = $( '<div />', { 'class': 'pgm-mo-modal-body pgm-mo-create-folder' } );
		$name = $( '<input />', {
			type: 'text',
			'class': 'pgm-mo-property-input',
			value: initialName || '',
			placeholder: t( 'folderName', 'Kansion nimi' ),
		} );
		$parent = $( '<select />', { 'class': 'pgm-mo-property-input' } );
		$access = $( '<select />', { 'class': 'pgm-mo-property-input' } );
		$effective = $( '<span />' );
		$message = $( '<p />', { 'class': 'pgm-mo-modal-message', role: 'status' } );

		populateFolderParentOptions( $parent, selectedParent );
		$.each( folderAccessChoices(), function( value, choice ) {
			$( '<option />', {
				value: value,
				text: choice.label || value,
			} ).appendTo( $access );
		} );
		$access.val( 'public' );
		$parent.add( $access ).on( 'change', updateCreateEffectiveLabel );

		$dialog.append(
			$( '<div />', { 'class': 'pgm-mo-modal-header' } )
				.append( $( '<h2 />', { id: 'pgm-mo-create-folder-title', text: t( 'createFolderTitle', 'Uusi kansio' ) } ) )
				.append( $( '<button />', { type: 'button', 'class': 'pgm-mo-modal-close', text: 'Ã—', title: t( 'close', 'Sulje' ) } ).on( 'click', close ) ),
			$body
		);

		$body.append(
			$( '<label />', { 'class': 'pgm-mo-property-row' } )
				.append( $( '<span />', { text: t( 'folderName', 'Kansion nimi' ) } ), $name ),
			$( '<label />', { 'class': 'pgm-mo-property-row' } )
				.append( $( '<span />', { text: t( 'folderLocation', 'Sijainti' ) } ), $parent ),
			$( '<label />', { 'class': 'pgm-mo-property-row' } )
				.append( $( '<span />', { text: t( 'folderVisibility', 'Kansion nÃ¤kyvyys' ) } ), $access ),
			$( '<div />', { 'class': 'pgm-mo-property-row' } )
				.append( $( '<span />', { text: t( 'effectiveAccess', 'Voimassa oleva nÃ¤kyvyys' ) } ), $effective ),
			$( '<p />', {
				'class': 'description pgm-mo-create-folder-help',
				text: t( 'folderLocationHelp', 'Valitse juuritaso tai kansio, jonka alle uusi kansio luodaan.' ),
			} ),
			$( '<div />', { 'class': 'pgm-mo-property-actions' } )
				.append(
					$( '<button />', { type: 'button', 'class': 'button', text: t( 'cancel', 'Peruuta' ) } ).on( 'click', close ),
					$( '<button />', { type: 'button', 'class': 'button button-primary', text: t( 'createFolder', 'Luo kansio' ) } ).on( 'click', submit )
				),
			$message
		);

		updateCreateEffectiveLabel();

		$name.add( $parent ).add( $access ).on( 'keydown', function( event ) {
			if ( event.key === 'Enter' ) {
				event.preventDefault(); event.stopPropagation();
				submit();
			}
		} );

		$overlay.on( 'mousedown', function( event ) {
			if ( event.target === $overlay[0] ) {
				close();
			}
		} );
		$( document ).on( 'keydown.pgmMoCreateFolder', function( event ) {
			if ( event.key === 'Escape' ) {
				close();
			}
		} );

		$overlay.append( $dialog );
		$( document.body ).append( $overlay );
		$name.trigger( 'focus' );
		if ( $name[0] && $name[0].select ) {
			$name[0].select();
		}
	}

	function renameFolder( folder, $sidebar ) {
		var $overlay;
		var $dialog;
		var $body;
		var $name;
		var $message;

		if ( ! folder || parseInt( folder.id, 10 ) <= 0 ) {
			return;
		}

		function close() {
			$( document ).off( '.pgmMoRenameFolder' );
			$overlay.remove();
		}

		function submit() {
			var name = $.trim( $name.val() );

			if ( ! name ) {
				$message.addClass( 'is-error' ).text( t( 'folderNameRequired', 'Anna kansion nimi.' ) );
				$name.trigger( 'focus' );
				return;
			}

			if ( name === folder.name ) {
				close();
				return;
			}

			$message.removeClass( 'is-error' ).text( t( 'saving', 'Saving...' ) );

			ajax( 'pecodex_mo_update_folder', {
				folder_id: folder.id,
				name: name,
				parent: parseInt( folder.parent || 0, 10 ) || 0,
			} )
				.done( function( response ) {
					if ( response && response.success ) {
						state.folders = response.data.folders || [];
						state.flatFolders = response.data.flatFolders || []; if (response.data && response.data.counts) { state.counts = response.data.counts; }
						renderAllSidebars();
						setMessage( $sidebar, t( 'done', 'Done.' ) );
						close();
					} else {
						$message.addClass( 'is-error' ).text( response && response.data && response.data.message ? response.data.message : t( 'error', 'Action failed.' ) );
					}
				} )
				.fail( function( xhr ) {
					var message = xhr.responseJSON && xhr.responseJSON.data && xhr.responseJSON.data.message ? xhr.responseJSON.data.message : t( 'error', 'Action failed.' );
					$message.addClass( 'is-error' ).text( message );
				} );
		}

		$overlay = $( '<div />', { 'class': 'pgm-mo-modal-overlay' } );
		$dialog = $( '<div />', { 'class': 'pgm-mo-modal pgm-mo-rename-folder-modal', role: 'dialog', 'aria-modal': 'true', 'aria-labelledby': 'pgm-mo-rename-folder-title' } );
		$body = $( '<div />', { 'class': 'pgm-mo-modal-body pgm-mo-rename-folder' } );
		$name = $( '<input />', {
			type: 'text',
			'class': 'pgm-mo-property-input',
			value: folder.name || '',
			placeholder: t( 'folderName', 'Kansion nimi' ),
		} );
		$message = $( '<p />', { 'class': 'pgm-mo-modal-message', role: 'status' } );

		$dialog.append(
			$( '<div />', { 'class': 'pgm-mo-modal-header' } )
				.append( $( '<h2 />', { id: 'pgm-mo-rename-folder-title', text: t( 'renameFolderTitle', 'NimeÃ¤ kansio uudelleen' ) } ) )
				.append( $( '<button />', { type: 'button', 'class': 'pgm-mo-modal-close', text: 'Ã—', title: t( 'close', 'Sulje' ) } ).on( 'click', close ) ),
			$body
		);

		$body.append(
			$( '<label />', { 'class': 'pgm-mo-property-row' } )
				.append( $( '<span />', { text: t( 'folderName', 'Kansion nimi' ) } ), $name ),
			$( '<div />', { 'class': 'pgm-mo-property-actions' } )
				.append(
					$( '<button />', { type: 'button', 'class': 'button', text: t( 'cancel', 'Peruuta' ) } ).on( 'click', close ),
					$( '<button />', { type: 'button', 'class': 'button button-primary', text: t( 'saveRename', 'Tallenna nimi' ) } ).on( 'click', submit )
				),
			$message
		);

		$name.on( 'keydown', function( event ) {
			if ( event.key === 'Enter' ) {
				event.preventDefault(); event.stopPropagation();
				submit();
			}
		} );

		$overlay.on( 'mousedown', function( event ) {
			if ( event.target === $overlay[0] ) {
				close();
			}
		} );
		$( document ).on( 'keydown.pgmMoRenameFolder', function( event ) {
			if ( event.key === 'Escape' ) {
				close();
			}
		} );

		$overlay.append( $dialog );
		$( document.body ).append( $overlay );
		$name.trigger( 'focus' );
		if ( $name[0] && $name[0].select ) {
			$name[0].select();
		}
	}

	function performDeleteFolder( folder, $sidebar, $message, closeModal, scope ) {
		if ( ! folder || parseInt( folder.id, 10 ) <= 0 ) {
			return;
		}

		if ( $message && $message.length ) {
			$message.removeClass( 'is-error' ).text( t( 'saving', 'Tallennetaan...' ) );
		} else {
			setMessage( $sidebar, t( 'saving', 'Saving...' ) );
		}

		ajax( 'pecodex_mo_delete_folder', {
			folder_id: folder.id,
			scope: scope || 'single',
		} )
			.done( function( response ) {
				if ( response && response.success ) {
					state.folders = response.data.folders || [];
					state.flatFolders = response.data.flatFolders || []; if (response.data && response.data.counts) { state.counts = response.data.counts; }
					state.selectedFolder = parseInt( response.data.selectedFolder || 0, 10 ) || 0;
					renderAllSidebars();
					refreshGridIfPossible( $sidebar );
					setMessage( $sidebar, response.data.message || t( 'done', 'Done.' ) );
					if ( closeModal ) {
						closeModal();
					}
				} else {
					if ( $message && $message.length ) {
						$message.addClass( 'is-error' ).text( response && response.data && response.data.message ? response.data.message : t( 'error', 'Action failed.' ) );
					} else {
						setMessage( $sidebar, response && response.data && response.data.message ? response.data.message : t( 'error', 'Action failed.' ), true );
					}
				}
			} )
			.fail( function( xhr ) {
				var message = xhr.responseJSON && xhr.responseJSON.data && xhr.responseJSON.data.message ? xhr.responseJSON.data.message : t( 'error', 'Action failed.' );
				if ( $message && $message.length ) {
					$message.addClass( 'is-error' ).text( message );
				} else {
					setMessage( $sidebar, message, true );
				}
			} );
	}

	function folderDescendantCount( folder ) {
		var total = 0;

		( folder && folder.children ? folder.children : [] ).forEach( function( child ) {
			total++;
			total += folderDescendantCount( child );
		} );

		return total;
	}

	function showDeleteFolderModal( folder, $sidebar ) {
		var id = folder ? parseInt( folder.id, 10 ) || 0 : 0;
		var childCount = folder && folder.children ? folder.children.length : 0;
		var descendantCount = folderDescendantCount( folder );
		var $overlay;
		var $dialog;
		var $body;
		var $message;
		var $options;
		var summaryText;

		if ( ! id ) {
			return;
		}

		function close() {
			$( document ).off( '.pgmMoDeleteFolder' );
			$overlay.remove();
		}

		function optionCard( value, label, description, checked, danger ) {
			var inputId = 'pgm-mo-delete-folder-' + value + '-' + id;

			return $( '<label />', { 'class': 'pgm-mo-delete-folder-option' + ( checked ? ' is-selected' : '' ) + ( danger ? ' is-danger' : '' ), 'for': inputId } )
				.append(
					$( '<input />', {
						id: inputId,
						type: 'radio',
						name: 'pgm-mo-delete-folder-scope',
						value: value,
					} ).prop( 'checked', !! checked ),
					$( '<span />', { 'class': 'pgm-mo-delete-folder-option-copy' } )
						.append( $( '<strong />', { text: label } ) )
						.append( $( '<span />', { text: description } ) )
				);
		}

		function selectedScope() {
			return $options.find( 'input[name="pgm-mo-delete-folder-scope"]:checked' ).val() || 'single';
		}

		$overlay = $( '<div />', { 'class': 'pgm-mo-modal-overlay' } );
		$dialog = $( '<div />', { 'class': 'pgm-mo-modal pgm-mo-delete-folder-modal', role: 'dialog', 'aria-modal': 'true', 'aria-labelledby': 'pgm-mo-delete-folder-title' } );
		$body = $( '<div />', { 'class': 'pgm-mo-modal-body pgm-mo-delete-folder' } );
		$message = $( '<p />', { 'class': 'pgm-mo-modal-message', role: 'status' } );
		$options = $( '<div />', { 'class': 'pgm-mo-delete-folder-options', role: 'radiogroup', 'aria-label': t( 'deleteFolderScope', 'Poiston laajuus' ) } );
		summaryText = descendantCount ? descendantCount + ' alikansiota tai alialikansiota kansiopuussa.' : t( 'noChildFolders', 'Ei alikansioita.' );

		$options.append(
			optionCard(
				'single',
				t( 'deleteFolderSingleTitle', 'Poista vain tÃ¤mÃ¤ kansio' ),
				childCount
					? t( 'deleteFolderSingleHelp', 'TÃ¤mÃ¤n kansion omat tiedostot siirtyvÃ¤t Ilman kansiota -nÃ¤kymÃ¤Ã¤n. Alikansiot sÃ¤ilyvÃ¤t ja nousevat ylemmÃ¤lle tasolle.' )
					: t( 'deleteFolderSingleNoChildrenHelp', 'TÃ¤mÃ¤n kansion tiedostot siirtyvÃ¤t Ilman kansiota -nÃ¤kymÃ¤Ã¤n. Mediatiedostoja ei poisteta.' ),
				true,
				false
			)
		);

		if ( descendantCount ) {
			$options.append(
				optionCard(
					'tree',
					t( 'deleteFolderTreeTitle', 'Poista myÃ¶s alikansiot kansiopuusta' ),
					t( 'deleteFolderTreeHelp', 'Kaikki tÃ¤mÃ¤n kansion ja alikansioiden tiedostot irrotetaan kansioista, mutta mediatiedostoja ei poisteta.' ),
					false,
					true
				)
			);
		}

		$options.on( 'change', 'input', function() {
			$options.find( '.pgm-mo-delete-folder-option' ).removeClass( 'is-selected' );
			$( this ).closest( '.pgm-mo-delete-folder-option' ).addClass( 'is-selected' );
		} );

		$dialog.append(
			$( '<div />', { 'class': 'pgm-mo-modal-header' } )
				.append( $( '<h2 />', { id: 'pgm-mo-delete-folder-title', text: t( 'confirmDeleteFolderTitle', 'Poista kansio?' ) } ) )
				.append( $( '<button />', { type: 'button', 'class': 'pgm-mo-modal-close', text: 'Ã—', title: t( 'close', 'Sulje' ) } ).on( 'click', close ) ),
			$body
		);

		$body.append(
			$( '<div />', { 'class': 'pgm-mo-delete-folder-summary' } )
				.append( icon( 'trash' ) )
				.append(
					$( '<div />' )
						.append( $( '<strong />', { text: folder.name || t( 'folderName', 'Kansion nimi' ) } ) )
						.append( $( '<span />', {
							text: childCount ? childCount + ' alikansiota sÃ¤ilyy ja siirtyy ylemmÃ¤lle tasolle.' : 'Ei alikansioita.',
						} ) )
				),
			$( '<p />', {
				'class': 'description',
				text: t( 'confirmDeleteFolderBody', 'Tiedostoja ei poisteta palvelimelta. Valitse alta poistetaanko vain tÃ¤mÃ¤ kansio vai koko alipuuhun kuuluva kansiorakenne.' ),
			} ),
			$options,
			$( '<div />', { 'class': 'pgm-mo-property-actions' } )
				.append(
					$( '<button />', { type: 'button', 'class': 'button', text: t( 'cancel', 'Peruuta' ) } ).on( 'click', close ),
					$( '<button />', { type: 'button', 'class': 'button button-primary pgm-mo-danger-button', text: t( 'deleteFolder', 'Poista kansio' ) } ).on( 'click', function() {
						performDeleteFolder( folder, $sidebar, $message, close, selectedScope() );
					} )
				),
			$message
		);

		$overlay.on( 'mousedown', function( event ) {
			if ( event.target === $overlay[0] ) {
				close();
			}
		} );
		$body.find( '.pgm-mo-delete-folder-summary span' ).last().text( summaryText );

		$( document ).on( 'keydown.pgmMoDeleteFolder', function( event ) {
			if ( event.key === 'Escape' ) {
				close();
			}
		} );

		$overlay.append( $dialog );
		$( document.body ).append( $overlay );
		$dialog.find( '.button' ).first().trigger( 'focus' );
	}

	function deleteFolder( folder, $sidebar ) {
		showDeleteFolderModal( folder, $sidebar );
	}

	function reorderFolder( folderId, targetId, position, $sidebar ) {
		var selectedFolder = state.selectedFolder;

		if ( ! folderId || ! targetId || folderId === targetId ) {
			clearFolderDragClasses();
			return;
		}

		setMessage( $sidebar, t( 'saving', 'Saving...' ) );

		ajax( 'pecodex_mo_reorder_folder', {
			folder_id: folderId,
			target_id: targetId,
			position: position || 'after',
		} )
			.done( function( response ) {
				if ( response && response.success ) {
					state.folders = response.data.folders || [];
					state.flatFolders = response.data.flatFolders || []; if (response.data && response.data.counts) { state.counts = response.data.counts; }
					state.selectedFolder = selectedFolder;
					if ( 'inside' === position ) {
						state.expanded[ targetId ] = true;
					}
					renderAllSidebars();
					setMessage( $sidebar, response.data.message || t( 'done', 'Done.' ) );
				} else {
					setMessage( $sidebar, response && response.data && response.data.message ? response.data.message : t( 'error', 'Action failed.' ), true );
				}
			} )
			.fail( function( xhr ) {
				var message = xhr.responseJSON && xhr.responseJSON.data && xhr.responseJSON.data.message ? xhr.responseJSON.data.message : t( 'error', 'Action failed.' );
				setMessage( $sidebar, message, true );
			} )
			.always( function() {
				state.draggedFolderId = 0;
				clearFolderDragClasses();
			} );
	}

	function selectedMediaSummaryText( count ) {
		return 1 === count ? '1 tiedosto valittu.' : count + ' tiedostoa valittu.';
	}

	function duplicateAttachmentsNow( ids, $sidebar, $message, closeModal ) {
		var queue = normalizeAttachmentIds( ids ).slice();
		var total = queue.length;
		var done = 0;
		var failed = 0;

		if ( ! queue.length ) {
			setMessage( $sidebar, t( 'noSelection', 'Select media first.' ), true );
			return;
		}

		function next() {
			var id = queue.shift();
			if ( ! id ) {
				var message = failed ? failed + ' / ' + total + ' ' + t( 'error', 'Action failed.' ) : done + ' ' + t( 'duplicatedFiles', 'tiedostoa monistettiin.' );
				if ( $message && $message.length ) {
					$message.toggleClass( 'is-error', !! failed ).text( message );
				}
				setMessage( $sidebar, message, !! failed );
				loadState().always( function() {
					clearAttachmentSelection( $sidebar );
					refreshGridIfPossible( $sidebar );
				} );
				if ( ! failed && closeModal ) {
					closeModal();
				}
				return;
			}

			ajax( 'pecodex_mo_duplicate_attachment', {
				attachment_id: id,
			} ).done( function( response ) {
				if ( ! response || ! response.success ) {
					failed++;
				}
			} ).fail( function() {
				failed++;
			} ).always( function() {
				done++;
				next();
			} );
		}

		if ( $message && $message.length ) {
			$message.removeClass( 'is-error' ).text( t( 'duplicatingFiles', 'Monistetaan tiedostoja...' ) );
		}
		setMessage( $sidebar, t( 'duplicatingFiles', 'Monistetaan tiedostoja...' ) );
		next();
	}

	function showDuplicateMediaModal( attachmentIds, $sidebar ) {
		var normalized = attachmentIds && attachmentIds.length ? normalizeAttachmentIds( attachmentIds ) : getSelectedAttachmentIds( $sidebar );
		var count = normalized.length;
		var $overlay;
		var $dialog;
		var $body;
		var $message;

		if ( ! count ) {
			setMessage( $sidebar, t( 'noSelection', 'Valitse ensin yksi tai useampi mediatiedosto.' ), true );
			return;
		}

		function close() {
			$( document ).off( '.pgmMoDuplicateMedia' );
			$overlay.remove();
		}

		$overlay = $( '<div />', { 'class': 'pgm-mo-modal-overlay' } );
		$dialog = $( '<div />', { 'class': 'pgm-mo-modal pgm-mo-duplicate-media-modal', role: 'dialog', 'aria-modal': 'true', 'aria-labelledby': 'pgm-mo-duplicate-media-title' } );
		$body = $( '<div />', { 'class': 'pgm-mo-modal-body pgm-mo-media-action-modal' } );
		$message = $( '<p />', { 'class': 'pgm-mo-modal-message', role: 'status' } );

		$dialog.append(
			$( '<div />', { 'class': 'pgm-mo-modal-header' } )
				.append( $( '<h2 />', { id: 'pgm-mo-duplicate-media-title', text: t( 'duplicateMediaTitle', 'Monista mediatiedostot?' ) } ) )
				.append( $( '<button />', { type: 'button', 'class': 'pgm-mo-modal-close', text: 'Ã—', title: t( 'close', 'Sulje' ) } ).on( 'click', close ) ),
			$body
		);

		$body.append(
			$( '<p />', { 'class': 'pgm-mo-media-action-summary', text: selectedMediaSummaryText( count ) } ),
			$( '<p />', { 'class': 'description', text: t( 'duplicateMediaBody', 'Valituista mediatiedostoista luodaan kopiot Media Libraryyn. AlkuperÃ¤iset tiedostot sÃ¤ilyvÃ¤t ennallaan.' ) } ),
			$( '<div />', { 'class': 'pgm-mo-property-actions' } )
				.append(
					$( '<button />', { type: 'button', 'class': 'button', text: t( 'cancel', 'Peruuta' ) } ).on( 'click', close ),
					$( '<button />', { type: 'button', 'class': 'button button-primary', text: t( 'duplicateFiles', 'Monista tiedostot' ) } ).on( 'click', function() {
						duplicateAttachmentsNow( normalized, $sidebar, $message, close );
					} )
				),
			$message
		);

		$overlay.on( 'mousedown', function( event ) {
			if ( event.target === $overlay[0] ) {
				close();
			}
		} );
		$( document ).on( 'keydown.pgmMoDuplicateMedia', function( event ) {
			if ( event.key === 'Escape' ) {
				close();
			}
		} );

		$overlay.append( $dialog );
		$( document.body ).append( $overlay );
		$dialog.find( '.button' ).first().trigger( 'focus' );
	}

