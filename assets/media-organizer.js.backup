			}
		} );
	}

	function expandRootFolders() {
		walkFolders( state.folders, function( folder, depth ) {
			if ( depth < 1 || parseInt( folder.id, 10 ) === parseInt( state.selectedFolder, 10 ) ) {
				state.expanded[ folder.id ] = true;
			}
		} );
	}

	function walkFolders( folders, callback, depth ) {
		depth = depth || 0;
		( folders || [] ).forEach( function( folder ) {
			callback( folder, depth );
			if ( folder.children && folder.children.length ) {
