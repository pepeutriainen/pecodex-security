			public: { label: 'Julkinen', shortLabel: 'Public' },
			logged_in: { label: 'Admin ja kirjautuneet', shortLabel: 'Logged in' },
			admin_only: { label: 'Vain admin', shortLabel: 'Admin' },
		};
	}

	function folderAccessLabel( access, shortLabel ) {
		var choices = folderAccessChoices();
		var choice = choices[ access ] || choices.public || {};

		return String( shortLabel ? ( choice.shortLabel || choice.label || access ) : ( choice.label || access || '' ) );
	}

	function folderEffectiveAccess( folder ) {
		return folder && ( folder.effectiveAccess || folder.access ) ? folder.effectiveAccess || folder.access : 'public';
	}

	function strongestAccess( first, second ) {
		var rank = {
			public: 0,
			logged_in: 1,
			admin_only: 2,
		};
		first = first || 'public';
		second = second || 'public';

		return ( rank[ first ] || 0 ) >= ( rank[ second ] || 0 ) ? first : second;
	}

	function normalizeMediaQueryValue( value ) {
