	}

	function assignAttachmentsToFolder( folderId, attachmentIds, $sidebar, options ) {
		var ids = attachmentIds && attachmentIds.length ? normalizeAttachmentIds( attachmentIds ) : getSelectedAttachmentIds( $sidebar );
		var $message;

		function writeMessage( message, isError ) {
			if ( $message && $message.length ) {
				$message.toggleClass( 'is-error', !! isError ).text( message );
			}
			setMessage( $sidebar, message, !! isError );
		}

		options = options || {};
		$message = options.$message || null;

		if ( ! ids.length ) {
			writeMessage( t( 'noSelection', 'Select media first.' ), true );
			return;
		}

		writeMessage( options.message || t( 'saving', 'Saving...' ) );

		ajax( 'pecodex_mo_assign_attachments', {
			folder_id: folderId,
			attachment_ids: ids,
		} )
			.done( function( response ) {
				if ( ! response || ! response.success ) {
					writeMessage( response && response.data && response.data.message ? response.data.message : t( 'error', 'Action failed.' ), true );
					clearAttachmentSelection( $sidebar );
					return;
				}

				state.folders = response.data.folders || state.folders;
				state.flatFolders = response.data.flatFolders || state.flatFolders; if (response.data && response.data.counts) { state.counts = response.data.counts; }
				writeMessage( response.data.message || t( 'done', 'Done.' ) );
				if ( options.clearSelection ) {
					clearAttachmentSelection( $sidebar );
				}
				renderAllSidebars();
				refreshGridIfPossible( $sidebar );
				if ( options.onDone ) {
					options.onDone( response );
				}
			} )
			.fail( function( xhr ) {
				var message = xhr.responseJSON && xhr.responseJSON.data && xhr.responseJSON.data.message ? xhr.responseJSON.data.message : t( 'error', 'Action failed.' );
				writeMessage( message, true );
			} );
	}

	function assignSelectedToFolder( folderId, $sidebar ) {
		assignAttachmentsToFolder( folderId, null, $sidebar );
	}

	function showRemoveFromFolderModal( attachmentIds, $sidebar ) {
		var ids = attachmentIds && attachmentIds.length ? normalizeAttachmentIds( attachmentIds ) : getSelectedAttachmentIds( $sidebar );
		var folderId = parseInt( state.selectedFolder, 10 ) || 0;
		var folder = folderId > 0 ? folderById( folderId ) : null;
		var $overlay;
		var $dialog;
		var $body;
		var $message;

		if ( folderId <= 0 ) {
			setMessage( $sidebar, t( 'removeFromFolderUnavailable', 'Valitse ensin tavallinen kansio.' ), true );
			clearAttachmentSelection( $sidebar );
			return;
		}

		if ( ! ids.length ) {
			setMessage( $sidebar, t( 'noSelection', 'Valitse ensin mediatiedostoja.' ), true );
			return;
		}

		function close() {
			$( document ).off( '.pgmMoRemoveFromFolder' );
			$overlay.remove();
		}

		$overlay = $( '<div />', { 'class': 'pgm-mo-modal-overlay' } );
		$dialog = $( '<div />', { 'class': 'pgm-mo-modal pgm-mo-remove-folder-modal', role: 'dialog', 'aria-modal': 'true', 'aria-labelledby': 'pgm-mo-remove-folder-title' } );
		$body = $( '<div />', { 'class': 'pgm-mo-modal-body pgm-mo-remove-folder' } );
		$message = $( '<p />', { 'class': 'pgm-mo-modal-message', role: 'status' } );

		$dialog.append(
			$( '<div />', { 'class': 'pgm-mo-modal-header' } )
				.append( $( '<h2 />', { id: 'pgm-mo-remove-folder-title', text: t( 'confirmRemoveFromFolderTitle', 'Poista valitut tÃ¤stÃ¤ kansiosta?' ) } ) )
				.append( $( '<button />', { type: 'button', 'class': 'pgm-mo-modal-close', text: 'Ã—', title: t( 'close', 'Sulje' ) } ).on( 'click', close ) ),
			$body
		);

		$body.append(
			$( '<div />', { 'class': 'pgm-mo-remove-folder-summary' } )
				.append( icon( 'folder-x' ) )
				.append(
					$( '<div />' )
						.append( $( '<strong />', { text: ids.length + ' ' + t( 'selectedFiles', 'valittua' ) } ) )
						.append( $( '<span />', { text: folder && folder.name ? folder.name : t( 'folderName', 'Kansion nimi' ) } ) )
				),
			$( '<p />', {
				'class': 'description',
				text: t( 'confirmRemoveFromFolderBody', 'Tiedostoja ei poisteta Media Librarysta tai palvelimelta. Ne irrotetaan vain tÃ¤stÃ¤ kansiosta ja nÃ¤kyvÃ¤t jatkossa Ilman kansiota -nÃ¤kymÃ¤ssÃ¤, ellei niillÃ¤ ole muuta kansiota.' ),
			} ),
			$( '<div />', { 'class': 'pgm-mo-remove-folder-result' } )
				.append( icon( 'info' ) )
				.append( $( '<span />', { text: t( 'removeFromFolderResult', 'Varsinainen tiedosto, suojaukset ja mediatiedot sÃ¤ilyvÃ¤t ennallaan.' ) } ) ),
			$( '<div />', { 'class': 'pgm-mo-property-actions' } )
				.append(
					$( '<button />', { type: 'button', 'class': 'button', text: t( 'cancel', 'Peruuta' ) } ).on( 'click', close ),
					$( '<button />', { type: 'button', 'class': 'button button-primary pgm-mo-neutral-button' } )
						.append( icon( 'folder-x' ), $( '<span />', { text: t( 'removeFromFolderAction', 'Poista kansiosta' ) } ) )
						.on( 'click', function() {
							removeAttachmentsFromCurrentFolder( ids, $sidebar, {
								$message: $message,
								onDone: close,
							} );
						} )
				),
			$message
		);

		$overlay.on( 'mousedown', function( event ) {
			if ( event.target === $overlay[0] ) {
				close();
			}
		} );
		$( document ).on( 'keydown.pgmMoRemoveFromFolder', function( event ) {
			if ( event.key === 'Escape' ) {
				close();
			}
		} );

		$overlay.append( $dialog );
		$( document.body ).append( $overlay );
		$dialog.find( '.button' ).first().trigger( 'focus' );
	}

	function removeAttachmentsFromCurrentFolder( attachmentIds, $sidebar, options ) {
		var ids = attachmentIds && attachmentIds.length ? normalizeAttachmentIds( attachmentIds ) : getSelectedAttachmentIds( $sidebar );
		var folderId = parseInt( state.selectedFolder, 10 ) || 0;
		var $message;

		options = options || {};
		$message = options.$message || null;

		function writeMessage( message, isError ) {
			if ( $message && $message.length ) {
				$message.toggleClass( 'is-error', !! isError ).text( message );
			}
			setMessage( $sidebar, message, !! isError );
		}

		if ( folderId <= 0 ) {
			writeMessage( t( 'removeFromFolderUnavailable', 'Valitse ensin tavallinen kansio.' ), true );
			clearAttachmentSelection( $sidebar );
			return;
