	function attachmentFileType( $attachment ) {
		var classText = String( $attachment.attr( 'class' ) || '' ).toLowerCase();
		var iconSrc = String( $attachment.find( '.thumbnail img.icon' ).attr( 'src' ) || '' ).toLowerCase();
		var fileText = String( $attachment.find( '.filename' ).text() || $attachment.attr( 'aria-label' ) || '' ).toLowerCase();

		if ( $attachment.hasClass( 'type-image' ) ) {
			return '';
		}
		if ( $attachment.hasClass( 'subtype-pdf' ) || fileText.indexOf( '.pdf' ) !== -1 ) {
			return 'pdf';
		}
		if ( classText.indexOf( 'msword' ) !== -1 || classText.indexOf( 'wordprocessingml' ) !== -1 || fileText.indexOf( '.doc' ) !== -1 || fileText.indexOf( '.rtf' ) !== -1 ) {
			return 'word';
		}
		if ( classText.indexOf( 'excel' ) !== -1 || classText.indexOf( 'spreadsheetml' ) !== -1 || fileText.indexOf( '.xls' ) !== -1 || fileText.indexOf( '.csv' ) !== -1 ) {
			return 'excel';
		}
		if ( classText.indexOf( 'powerpoint' ) !== -1 || classText.indexOf( 'presentationml' ) !== -1 || fileText.indexOf( '.ppt' ) !== -1 ) {
			return 'powerpoint';
		}
		if ( $attachment.hasClass( 'type-audio' ) || /\.(mp3|m4a|ogg|wav|flac)$/.test( fileText ) ) {
			return 'audio';
		}
		if ( $attachment.hasClass( 'type-video' ) || /\.(mp4|mov|m4v|webm|avi)$/.test( fileText ) ) {
			return 'video';
		}
		if ( $attachment.hasClass( 'subtype-zip' ) || $attachment.hasClass( 'subtype-x-zip-compressed' ) || $attachment.hasClass( 'subtype-rar' ) || /\.(zip|rar|7z|tar|gz)$/.test( fileText ) ) {
			return 'archive';
		}
		if ( $attachment.hasClass( 'type-application' ) || $attachment.hasClass( 'type-text' ) || iconSrc.indexOf( '/media/document.svg' ) !== -1 ) {
			return 'document';
		}

		return '';
	}

	function attachmentDataFileType( data ) {
		var privateMedia = data && data.pgmPrivateMedia ? data.pgmPrivateMedia : {};
		var mime = String( data && data.mime || '' ).toLowerCase();
		var subtype = String( data && data.subtype || '' ).toLowerCase();
		var type = String( data && data.type || '' ).toLowerCase();
		var fileText = String( data && ( data.filename || data.name || data.url ) || '' ).toLowerCase() + ' ' + String( privateMedia.originalFilename || privateMedia.fileExtension || '' ).toLowerCase();

		if ( privateMedia.fileType ) {
			return String( privateMedia.fileType );
		}

		if ( type === 'image' ) {
			return '';
		}
		if ( subtype === 'pdf' || mime === 'application/pdf' || fileText.indexOf( '.pdf' ) !== -1 ) {
			return 'pdf';
		}
		if ( mime.indexOf( 'msword' ) !== -1 || mime.indexOf( 'wordprocessingml' ) !== -1 || fileText.indexOf( '.doc' ) !== -1 || fileText.indexOf( '.rtf' ) !== -1 ) {
			return 'word';
		}
		if ( mime.indexOf( 'excel' ) !== -1 || mime.indexOf( 'spreadsheetml' ) !== -1 || fileText.indexOf( '.xls' ) !== -1 || fileText.indexOf( '.csv' ) !== -1 ) {
			return 'excel';
		}
		if ( mime.indexOf( 'powerpoint' ) !== -1 || mime.indexOf( 'presentationml' ) !== -1 || fileText.indexOf( '.ppt' ) !== -1 ) {
			return 'powerpoint';
		}
		if ( type === 'audio' || /\.(mp3|m4a|ogg|wav|flac)$/.test( fileText ) ) {
			return 'audio';
		}
		if ( type === 'video' || /\.(mp4|mov|m4v|webm|avi)$/.test( fileText ) ) {
			return 'video';
		}
		if ( subtype === 'zip' || subtype === 'x-zip-compressed' || subtype === 'rar' || /\.(zip|rar|7z|tar|gz)$/.test( fileText ) ) {
			return 'archive';
		}
		if ( type === 'application' || type === 'text' ) {
			return 'document';
		}

		return '';
	}

	function buildAttachmentIcon( type ) {
		var icons = {
			archive: 'archive',
			audio: 'audio',
			document: 'file-text',
			pdf: 'file-text',
			video: 'video',
		};
		var $icon = $( '<div />', { 'class': 'pgm-mo-attachment-icon is-' + type } );
		var $preview = $( '<div />', { 'class': 'pgm-mo-file-preview is-fallback', 'aria-hidden': 'true' } );
		var $previewContent = $( '<div />', { 'class': 'pgm-mo-file-preview-content' } );

		if ( fileTypeAssetIcons[ type ] && config.iconBaseUrl ) {
			$previewContent.append( $( '<img />', {
					alt: '',
					'class': 'pgm-mo-file-asset',
					draggable: false,
					loading: 'lazy',
					src: config.iconBaseUrl + fileTypeAssetIcons[ type ],
				} ) );
		} else {
			$previewContent.append( icon( icons[ type ] || 'file' ) );
		}
		$preview.append( $previewContent );

		return $icon
			.append( $preview )
			.append( $( '<span />', { 'class': 'pgm-mo-file-label', text: fileTypeLabels[ type ] || 'FILE' } ) );
	}

	function buildCardFileTypeBadge( type ) {
		var icons = {
			archive: 'archive',
			audio: 'audio',
			document: 'file-text',
			pdf: 'file-text',
			video: 'video',
		};
		var $badge = $( '<span />', {
			'class': 'pgm-mo-card-file-type-badge is-' + type,
			'aria-hidden': 'true',
			'title': fileTypeLabels[ type ] || 'FILE',
		} );

		if ( fileTypeAssetIcons[ type ] && config.iconBaseUrl ) {
			$badge.append( $( '<img />', {
				alt: '',
				draggable: false,
				loading: 'lazy',
				src: config.iconBaseUrl + fileTypeAssetIcons[ type ],
			} ) );
		} else {
			$badge.append( icon( icons[ type ] || 'file' ) );
		}

		return $badge;
	}

	function supportsThumbnailPreview( type, data ) {
		var ext = fileExtension( data );

		if ( type === 'pdf' ) {
			return true;
		}
		if ( type === 'word' ) {
			return ext === 'docx';
		}
		if ( type === 'excel' ) {
			return ext === 'xlsx' || ext === 'xlsm' || ext === 'xls' || ext === 'csv';
		}
		if ( type === 'powerpoint' ) {
			return ext === 'pptx' || ext === 'pptm';
		}

		return false;
	}

	function thumbnailPreviewKey( type, data ) {
		return [ type || '', data && data.id || '', fileExtension( data ), attachmentPreviewUrl( data ) ].join( ':' );
	}

	function renderThumbnailFallback( $icon ) {
		var $preview = $icon.find( '.pgm-mo-file-preview' ).first();
		var $contentHost = $preview.children( '.pgm-mo-file-preview-content' ).first();
		var fallbackHtml = $icon.data( 'pgmMoFallbackHtml' );

		if ( fallbackHtml && $contentHost.length && ! $contentHost.children().length ) {
			$contentHost.html( fallbackHtml );
		}

		$icon.removeClass( 'has-preview is-preview-loading' );
		$preview.removeClass( 'has-rendered-preview is-preview-pending' ).addClass( 'is-fallback' );
	}

	function buildThumbnailPreviewLoader() {
		return $( '<div />', {
			'class': 'pgm-mo-thumb-loader',
			'aria-hidden': 'true',
		} )
			.append( $( '<span />', { 'class': 'pgm-mo-thumb-loader-spinner' } ) )
			.append(
				$( '<span />', { 'class': 'pgm-mo-thumb-loader-lines' } )
					.append( $( '<i />' ) )
					.append( $( '<i />' ) )
					.append( $( '<i />' ) )
					.append( $( '<i />' ) )
			);
	}

	function prepareThumbnailPreviewLoading( $icon ) {
		var $preview = $icon.find( '.pgm-mo-file-preview' ).first();
		var $contentHost;

		if ( ! $preview.length ) {
			return;
		}

		$contentHost = $preview.children( '.pgm-mo-file-preview-content' ).first();
		if ( ! $contentHost.length ) {
			$contentHost = $( '<div />', { 'class': 'pgm-mo-file-preview-content' } ).prependTo( $preview );
		}

		if ( ! $icon.data( 'pgmMoFallbackHtml' ) ) {
			$icon.data( 'pgmMoFallbackHtml', $contentHost.html() );
		}

		$contentHost.empty().append( buildThumbnailPreviewLoader() );
		$preview.removeClass( 'is-fallback has-rendered-preview' ).addClass( 'is-preview-pending' );
	}

	function setThumbnailPreviewContent( $icon, $content ) {
		var $preview = $icon.find( '.pgm-mo-file-preview' ).first();
		var $contentHost;

		if ( ! $preview.length ) {
			return;
		}

		$contentHost = $preview.children( '.pgm-mo-file-preview-content' ).first();
		if ( ! $contentHost.length ) {
			$contentHost = $( '<div />', { 'class': 'pgm-mo-file-preview-content' } ).prependTo( $preview );
		}

		$contentHost.empty().append( $content );
		$preview.removeClass( 'is-fallback is-preview-pending' ).addClass( 'has-rendered-preview' );
		$icon.addClass( 'has-preview' ).removeClass( 'is-preview-loading' );
	}

	function renderPdfThumbnailPreview( $icon, data ) {
		var url = attachmentPreviewUrl( data );
		var pdfjsLib = getPdfJsLib();

		if ( ! url || ! pdfjsLib || ! pdfjsLib.getDocument ) {
			return Promise.reject( new Error( 'PDF preview is not available.' ) );
		}

		configurePdfWorker();

		return fetchPreviewArrayBuffer( url )
			.then( function( buffer ) {
				return pdfjsLib.getDocument( { data: buffer } ).promise;
			} )
			.then( function( pdf ) {
				return pdf.getPage( 1 );
			} )
			.then( function( page ) {
				var viewport = page.getViewport( { scale: 1 } );
				var scale = Math.min( 128 / viewport.width, 164 / viewport.height );
				var scaledViewport = page.getViewport( { scale: scale } );
				var canvas = document.createElement( 'canvas' );
				var context = canvas.getContext( '2d', { alpha: false } );

				canvas.width = Math.max( 1, Math.floor( scaledViewport.width ) );
				canvas.height = Math.max( 1, Math.floor( scaledViewport.height ) );
				canvas.className = 'pgm-mo-thumb-canvas';

				return page.render( { canvasContext: context, viewport: scaledViewport } ).promise.then( function() {
					setThumbnailPreviewContent( $icon, $( canvas ) );
				} );
			} );
	}

	function textSnippet( value, limit ) {
		return String( value || '' ).replace( /\s+/g, ' ' ).trim().slice( 0, limit || 220 );
	}

	function renderDocxThumbnailPreview( $icon, data ) {
		var url = attachmentPreviewUrl( data );

		if ( ! url || ! window.mammoth || ( ! window.mammoth.convertToHtml && ! window.mammoth.extractRawText ) ) {
			return Promise.reject( new Error( 'DOCX preview is not available.' ) );
		}

		return fetchPreviewArrayBuffer( url )
			.then( function( buffer ) {
				if ( window.mammoth.convertToHtml ) {
					return window.mammoth.convertToHtml( { arrayBuffer: buffer } ).then( function( result ) {
						return { html: result && result.value || '' };
					} );
				}
				return window.mammoth.extractRawText( { arrayBuffer: buffer } ).then( function( result ) {
					return { text: result && result.value || '' };
				} );
			} )
			.then( function( result ) {
				var text = textSnippet( result && result.text, 420 );
				var $page = $( '<div />', { 'class': 'pgm-mo-thumb-page pgm-mo-thumb-docx-html' } );
				var $sheet = $( '<div />', { 'class': 'pgm-mo-thumb-docx-sheet' } );
				var $content;

				if ( result && result.html ) {
					$content = sanitizePreviewHtml( $( '<div />', { 'class': 'pgm-mo-thumb-docx-content' } ).html( result.html ) );
					if ( ! textSnippet( $content.text(), 20 ) && ! $content.find( 'table,img' ).length ) {
						throw new Error( 'DOCX preview is empty.' );
					}
					$content.find( 'img' ).attr( 'loading', 'lazy' ).attr( 'draggable', 'false' );
					$sheet.append( $content );
					$page.append( $sheet );
					setThumbnailPreviewContent( $icon, $page );
					return;
				}

				if ( ! text ) {
					throw new Error( 'DOCX preview is empty.' );
				}

				text.split( /[.!?]\s+/ ).slice( 0, 6 ).forEach( function( line ) {
					$sheet.append( $( '<p />', { text: line } ) );
				} );
				$page.append( $sheet );
				setThumbnailPreviewContent( $icon, $page );
			} );
	}

	function renderExcelThumbnailPreview( $icon, data ) {
		var url = attachmentPreviewUrl( data );

		if ( ! url || ! window.XLSX || ! window.XLSX.read ) {
			return Promise.reject( new Error( 'Spreadsheet preview is not available.' ) );
		}

		return fetchPreviewArrayBuffer( url )
			.then( function( buffer ) {
				return window.XLSX.read( buffer, { type: 'array' } );
			} )
			.then( function( workbook ) {
				var sheetName = workbook.SheetNames && workbook.SheetNames[0];
				var rows = sheetName ? worksheetRows( workbook.Sheets[ sheetName ] ).slice( 0, 6 ) : [];
				var $table = $( '<table />', { 'class': 'pgm-mo-thumb-sheet' } );
				var $tbody = $( '<tbody />' );

				if ( ! rows.length ) {
					throw new Error( 'Spreadsheet preview is empty.' );
				}

				rows.forEach( function( row, index ) {
					var $tr = $( '<tr />' );
					( row || [] ).slice( 0, 4 ).forEach( function( cell ) {
						$( index === 0 ? '<th />' : '<td />', { text: String( cell == null ? '' : cell ) } ).appendTo( $tr );
					} );
					$tbody.append( $tr );
				} );
				$table.append( $tbody );
				setThumbnailPreviewContent( $icon, $table );
			} );
	}

	function renderPowerPointThumbnailPreview( $icon, data ) {
		var url = attachmentPreviewUrl( data );

		if ( ! url || ! window.JSZip ) {
			return Promise.reject( new Error( 'PowerPoint preview is not available.' ) );
		}

		return fetchPreviewArrayBuffer( url )
			.then( function( buffer ) {
				return window.JSZip.loadAsync( buffer );
			} )
			.then( function( zip ) {
				var firstSlide = null;

				zip.forEach( function( path, file ) {
					if ( ! firstSlide && /^ppt\/slides\/slide1\.xml$/.test( path ) ) {
						firstSlide = file;
					}
				} );
				if ( ! firstSlide ) {
					throw new Error( 'PowerPoint preview is empty.' );
				}

				return firstSlide.async( 'string' );
			} )
			.then( function( xml ) {
				var lines = textFromSlideXml( xml ).filter( Boolean ).slice( 0, 7 );
				var $slide = $( '<div />', { 'class': 'pgm-mo-thumb-page pgm-mo-thumb-ppt' } );

				if ( ! lines.length ) {
					throw new Error( 'PowerPoint preview is empty.' );
				}

				lines.forEach( function( line, index ) {
					$slide.append( $( '<span />', { 'class': index === 0 ? 'is-title' : '', text: textSnippet( line, 70 ) } ) );
				} );
				setThumbnailPreviewContent( $icon, $slide );
			} );
	}

	function renderAttachmentThumbnailPreview( $icon, type, data ) {
		var key;
		var promise;

		if ( ! $icon || ! $icon.length || ! supportsThumbnailPreview( type, data ) ) {
			return;
		}

		key = thumbnailPreviewKey( type, data );
		if ( $icon.data( 'pgmMoThumbPreviewKey' ) === key ) {
			return;
		}

		$icon.data( 'pgmMoThumbPreviewKey', key ).addClass( 'is-preview-loading' );
		prepareThumbnailPreviewLoading( $icon );

		if ( thumbnailPreviewCache[ key ] ) {
			thumbnailPreviewCache[ key ]( $icon );
			return;
		}

		if ( type === 'pdf' ) {
			promise = renderPdfThumbnailPreview( $icon, data );
		} else if ( type === 'word' ) {
			promise = renderDocxThumbnailPreview( $icon, data );
		} else if ( type === 'excel' ) {
			promise = renderExcelThumbnailPreview( $icon, data );
		} else if ( type === 'powerpoint' ) {
			promise = renderPowerPointThumbnailPreview( $icon, data );
		}

		if ( ! promise ) {
			return;
		}

		promise
			.then( function() {
				var $canvas = $icon.find( 'canvas.pgm-mo-thumb-canvas' ).first();
				var html;
				var imageData;

				if ( $canvas.length && $canvas[0].toDataURL ) {
					try {
						imageData = $canvas[0].toDataURL( 'image/png' );
					} catch ( error ) {
						imageData = '';
					}
					if ( imageData ) {
						thumbnailPreviewCache[ key ] = function( $targetIcon ) {
							setThumbnailPreviewContent( $targetIcon, $( '<img />', {
								alt: '',
								'class': 'pgm-mo-thumb-image',
								draggable: false,
								src: imageData,
							} ) );
						};
					}
					return;
				}

				html = $icon.find( '.pgm-mo-file-preview-content' ).html();
				if ( html ) {
					thumbnailPreviewCache[ key ] = function( $targetIcon ) {
						setThumbnailPreviewContent( $targetIcon, $( '<div />' ).html( html ).contents() );
					};
				}
			} )
			.catch( function() {
				renderThumbnailFallback( $icon );
			} );
	}

	function thumbnailHasRenderedFilePreview( $thumbnail ) {
		if ( ! $thumbnail || ! $thumbnail.length ) {
			return false;
		}

		return $thumbnail.children( 'canvas.pgm-pdf-preview-canvas' ).length > 0;
	}

	function enhanceSharedAttachmentCard( $attachment, model ) {
		if ( ! $attachment || ! $attachment.length || 'function' !== typeof window.pecodexEnhanceMediaAttachmentCard ) {
			return;
		}

		try {
			window.pecodexEnhanceMediaAttachmentCard( $attachment[0], model || null );
		} catch ( error ) {}
	}

	function renderCardFileTypeBadge( $attachment, type ) {
		var $preview;

		if ( ! $attachment || ! $attachment.length ) {
			return;
		}

		$attachment.find( '.pgm-mo-card-file-type-badge' ).remove();
		$attachment.removeClass( 'pgm-mo-has-card-file-badge' );

		if ( ! type || ! fileTypeLabels[ type ] ) {
			return;
		}

		$preview = $attachment.find( '.attachment-preview' ).first();
		if ( ! $preview.length ) {
			return;
		}

		$attachment.addClass( 'pgm-mo-has-card-file-badge' );
		$preview.append( buildCardFileTypeBadge( type ) );
	}

	function enhanceAttachmentIcons( root ) {
		$( '.attachments .attachment', root || document ).each( function() {
			var $attachment = $( this );
			var type = attachmentFileType( $attachment );
			var id;
			var model;
			var data;
			var $thumbnail;
			var $existingIcon;
			var $icon;

			id = parseInt( $attachment.attr( 'data-id' ), 10 ) || 0;
			if ( id && wp && wp.media && wp.media.attachment ) {
				model = wp.media.attachment( id );
				data = model && model.toJSON ? model.toJSON() : null;
				type = attachmentDataFileType( data ) || type;
			}

			enhanceSharedAttachmentCard( $attachment, model );

			if ( ! type ) {
				$attachment.find( '.pgm-mo-card-file-type-badge' ).remove();
				$attachment.removeClass( 'pgm-mo-has-card-file-badge' );
				return;
			}

			$thumbnail = $attachment.find( '.thumbnail' ).first();
			if ( ! $thumbnail.length ) {
				return;
			}

			renderCardFileTypeBadge( $attachment, type );

			if ( thumbnailHasRenderedFilePreview( $thumbnail ) ) {
				$attachment.addClass( 'pgm-mo-has-rendered-file-preview' );
				$thumbnail.children( '.pgm-mo-attachment-icon' ).remove();
				return;
			}

			$thumbnail.removeClass( 'pgm-has-rendered-pdf-preview pgm-mo-has-rendered-preview' );

			$attachment
				.removeClass( 'pgm-mo-has-rendered-file-preview' )
				.removeClass( 'pgm-mo-file-pdf pgm-mo-file-document pgm-mo-file-excel pgm-mo-file-powerpoint pgm-mo-file-word pgm-mo-file-archive pgm-mo-file-audio pgm-mo-file-video' )
				.addClass( 'pgm-mo-has-file-icon pgm-mo-file-' + type );
			$existingIcon = $thumbnail.children( '.pgm-mo-attachment-icon.is-' + type ).first();
			if ( $existingIcon.length ) {
				$icon = $existingIcon;
			} else {
				$thumbnail.children( '.pgm-mo-attachment-icon' ).remove();
				$icon = buildAttachmentIcon( type );
				$thumbnail.prepend( $icon );
			}
			$icon.find( '.pgm-mo-file-type-badge' ).remove();
			renderAttachmentThumbnailPreview( $icon, type, data );
		} );
	}

	function attachmentPreviewUrl( data ) {
		var privateMedia = data && data.pgmPrivateMedia ? data.pgmPrivateMedia : {};

		return String( privateMedia.adminPreviewUrl || privateMedia.adminDownloadUrl || data && data.url || '' );
	}

	function fileExtension( data ) {
		var privateMedia = data && data.pgmPrivateMedia ? data.pgmPrivateMedia : {};
		var fileText = String( data && ( data.filename || data.name || data.url ) || '' ).toLowerCase() + ' ' + String( privateMedia.originalFilename || privateMedia.fileExtension || '' ).toLowerCase();
		var match = fileText.match( /\.([a-z0-9]+)(?:[?#].*)?$/ );
		return match ? match[ 1 ] : String( privateMedia.fileExtension || '' );
	}

	function cloneArrayBuffer( buffer ) {
		if ( ! buffer || 'function' !== typeof buffer.slice ) {
			return buffer;
		}

		return buffer.slice( 0 );
	}

	function fetchPreviewArrayBuffer( url ) {
		if ( ! url ) {
			return Promise.reject( new Error( 'Missing file URL.' ) );
		}
		if ( ! window.fetch ) {
			return Promise.reject( new Error( 'This browser does not support live previews.' ) );
		}
		if ( ! previewFileCache[ url ] ) {
			previewFileCache[ url ] = window.fetch( url, { credentials: 'same-origin' } ).then( function( response ) {
				if ( ! response.ok ) {
					throw new Error( 'Preview request failed: ' + response.status );
				}
				return response.arrayBuffer();
			} ).catch( function( error ) {
				delete previewFileCache[ url ];
				throw error;
			} );
		}
		return previewFileCache[ url ].then( function( buffer ) {
			try {
				return cloneArrayBuffer( buffer );
			} catch ( error ) {
				delete previewFileCache[ url ];
				return window.fetch( url, { credentials: 'same-origin' } ).then( function( response ) {
					if ( ! response.ok ) {
						throw new Error( 'Preview request failed: ' + response.status );
					}
					return response.arrayBuffer();
				} );
			}
		} );
	}

	function renderPreviewFallback( $preview, type, filename, message ) {
		$preview
			.empty()
			.removeClass( 'is-loading' )
			.addClass( 'has-fallback' )
			.append( buildAttachmentIcon( type ).addClass( 'is-detail' ) );
		if ( filename ) {
			$preview.append( $( '<div />', { 'class': 'pgm-mo-detail-file-name', text: filename } ) );
		}
		if ( message ) {
			$preview.append( $( '<div />', { 'class': 'pgm-mo-preview-message', text: message } ) );
		}
	}

	function renderPreviewLoading( $preview, label ) {
		$preview
			.empty()
			.addClass( 'is-loading' )
			.append( $( '<div />', { 'class': 'pgm-mo-preview-loading', text: label } ) );
	}

	function sanitizePreviewHtml( $html ) {
		$html.find( 'script, style, iframe, object, embed, form' ).remove();
		$html.find( '*' ).each( function() {
			var element = this;
			$.each( Array.prototype.slice.call( element.attributes || [] ), function( index, attribute ) {
				var name = attribute.name.toLowerCase();
				var value = String( attribute.value || '' ).toLowerCase();
				if ( name.indexOf( 'on' ) === 0 || ( ( name === 'href' || name === 'src' ) && value.indexOf( 'javascript:' ) === 0 ) ) {
					element.removeAttribute( attribute.name );
				}
			} );
		} );
		return $html;
	}

	function getPdfJsLib() {
		return window.pdfjsLib || null;
	}

	function configurePdfWorker() {
		var pdfjsLib = getPdfJsLib();

		if ( pdfjsLib && config.pdfWorkerUrl && ! pdfjsLib.GlobalWorkerOptions.workerSrc ) {
			pdfjsLib.GlobalWorkerOptions.workerSrc = config.pdfWorkerUrl;
		}
	}

	function renderPdfPreview( $preview, data ) {
		var url = attachmentPreviewUrl( data );
		var filename = String( data && data.filename || '' );
		var pdfjsLib = getPdfJsLib();
		var maxPages = 3;

		if ( ! pdfjsLib || ! pdfjsLib.getDocument ) {
			renderPreviewFallback( $preview, 'pdf', filename, 'PDF preview library is not loaded.' );
			return;
		}

		configurePdfWorker();
		renderPreviewLoading( $preview, 'Loading PDF preview...' );

		fetchPreviewArrayBuffer( url )
			.then( function( buffer ) {
				return pdfjsLib.getDocument( { data: buffer } ).promise;
			} )
			.then( function( pdf ) {
				var $pages = $( '<div />', { 'class': 'pgm-mo-pdf-pages' } );
				var pageCount = Math.min( pdf.numPages, maxPages );
				var renders = [];
				var pageNum;

				for ( pageNum = 1; pageNum <= pageCount; pageNum++ ) {
					renders.push(
						pdf.getPage( pageNum ).then( function( page ) {
							var viewport = page.getViewport( { scale: 1.15 } );
							var canvas = document.createElement( 'canvas' );
							var context = canvas.getContext( '2d', { alpha: false } );

							canvas.width = viewport.width;
							canvas.height = viewport.height;
							canvas.className = 'pgm-mo-pdf-page';

							return page.render( { canvasContext: context, viewport: viewport } ).promise.then( function() {
								return canvas;
							} );
						} )
					);
				}

				return Promise.all( renders ).then( function( canvases ) {
					canvases.forEach( function( canvas ) {
						$pages.append( canvas );
					} );
					$preview.empty().removeClass( 'is-loading has-fallback' ).append( $pages );
					if ( pdf.numPages > maxPages ) {
						$preview.append( $( '<div />', { 'class': 'pgm-mo-preview-message', text: 'Showing first ' + maxPages + ' of ' + pdf.numPages + ' pages.' } ) );
					}
				} );
			} )
			.catch( function( error ) {
				renderPreviewFallback( $preview, 'pdf', filename, error.message || 'PDF preview failed.' );
			} );
	}

	function renderDocxPreview( $preview, data ) {
		var url = attachmentPreviewUrl( data );
		var filename = String( data && data.filename || '' );
		var ext = fileExtension( data );

		if ( ext !== 'docx' ) {
			renderPreviewFallback( $preview, 'word', filename, 'DOC preview needs DOCX. This older Word file can still be downloaded.' );
			return;
		}
		if ( ! window.mammoth || ! window.mammoth.convertToHtml ) {
			renderPreviewFallback( $preview, 'word', filename, 'DOCX preview library is not loaded.' );
			return;
		}

		renderPreviewLoading( $preview, 'Loading DOCX preview...' );
		fetchPreviewArrayBuffer( url )
			.then( function( buffer ) {
				return window.mammoth.convertToHtml( { arrayBuffer: buffer } );
			} )
			.then( function( result ) {
				var $content = sanitizePreviewHtml( $( '<div />', { 'class': 'pgm-mo-docx-preview' } ).html( result.value || '' ) );
				$preview.empty().removeClass( 'is-loading has-fallback' ).append( $content );
				if ( result.messages && result.messages.length ) {
					$preview.append( $( '<div />', { 'class': 'pgm-mo-preview-message', text: result.messages.length + ' conversion notes.' } ) );
				}
			} )
			.catch( function( error ) {
				renderPreviewFallback( $preview, 'word', filename, error.message || 'DOCX preview failed.' );
			} );
	}

	function worksheetRows( sheet ) {
		return window.XLSX.utils.sheet_to_json( sheet, {
			blankrows: false,
			defval: '',
			header: 1,
			raw: false,
		} );
	}

	function renderWorksheetTable( $host, rows ) {
		var maxRows = 100;
		var maxCols = 24;
		var $table = $( '<table />', { 'class': 'pgm-mo-sheet-table' } );
		var $tbody = $( '<tbody />' );

		rows.slice( 0, maxRows ).forEach( function( row, rowIndex ) {
			var $tr = $( '<tr />' );
			( row || [] ).slice( 0, maxCols ).forEach( function( cell ) {
				$( rowIndex === 0 ? '<th />' : '<td />', { text: String( cell == null ? '' : cell ) } ).appendTo( $tr );
			} );
			if ( ! $tr.children().length ) {
				$tr.append( $( '<td />', { text: '' } ) );
			}
			$tbody.append( $tr );
		} );

		$table.append( $tbody );
		$host.empty().append( $table );
		if ( rows.length > maxRows ) {
			$host.append( $( '<div />', { 'class': 'pgm-mo-preview-message', text: 'Showing first ' + maxRows + ' rows.' } ) );
		}
	}

	function renderExcelPreview( $preview, data ) {
		var url = attachmentPreviewUrl( data );
		var filename = String( data && data.filename || '' );

		if ( ! window.XLSX || ! window.XLSX.read ) {
			renderPreviewFallback( $preview, 'excel', filename, 'Excel preview library is not loaded.' );
			return;
		}

		renderPreviewLoading( $preview, 'Loading spreadsheet preview...' );
		fetchPreviewArrayBuffer( url )
			.then( function( buffer ) {
				return window.XLSX.read( buffer, { type: 'array' } );
			} )
			.then( function( workbook ) {
				var sheetNames = workbook.SheetNames || [];
				var $tabs = $( '<div />', { 'class': 'pgm-mo-sheet-tabs' } );
				var $tableHost = $( '<div />', { 'class': 'pgm-mo-sheet-host' } );

				function selectSheet( name ) {
					$tabs.children().removeClass( 'is-active' ).filter( function() {
						return $( this ).data( 'sheet' ) === name;
					} ).addClass( 'is-active' );
					renderWorksheetTable( $tableHost, worksheetRows( workbook.Sheets[ name ] ) );
				}

				if ( ! sheetNames.length ) {
					renderPreviewFallback( $preview, 'excel', filename, 'No sheets found.' );
					return;
				}

				sheetNames.slice( 0, 8 ).forEach( function( name, index ) {
					$( '<button />', { type: 'button', 'data-sheet': name, text: name } )
						.on( 'click', function() { selectSheet( name ); } )
						.toggleClass( 'is-active', index === 0 )
						.appendTo( $tabs );
				} );

				$preview.empty().removeClass( 'is-loading has-fallback' ).append( $tabs, $tableHost );
				selectSheet( sheetNames[ 0 ] );
			} )
			.catch( function( error ) {
				renderPreviewFallback( $preview, 'excel', filename, error.message || 'Spreadsheet preview failed.' );
			} );
	}

	function slideNumberFromPath( path ) {
		var match = String( path || '' ).match( /slide(\d+)\.xml$/ );
		return match ? parseInt( match[ 1 ], 10 ) || 0 : 0;
	}

	function textFromSlideXml( xml ) {
		var doc = new window.DOMParser().parseFromString( xml, 'application/xml' );
		var nodes = doc.getElementsByTagName( 'a:t' );
		var text = [];
		var i;
		for ( i = 0; i < nodes.length; i++ ) {
			if ( nodes[ i ].textContent ) {
				text.push( nodes[ i ].textContent );
			}
		}
		return text;
	}

	function renderPowerPointPreview( $preview, data ) {
		var url = attachmentPreviewUrl( data );
		var filename = String( data && data.filename || '' );
		var ext = fileExtension( data );

		if ( ext !== 'pptx' && ext !== 'pptm' ) {
			renderPreviewFallback( $preview, 'powerpoint', filename, 'PowerPoint preview needs PPTX or PPTM.' );
			return;
		}
		if ( ! window.JSZip ) {
			renderPreviewFallback( $preview, 'powerpoint', filename, 'PowerPoint preview library is not loaded.' );
			return;
		}

		renderPreviewLoading( $preview, 'Loading PowerPoint preview...' );
		fetchPreviewArrayBuffer( url )
			.then( function( buffer ) {
				return window.JSZip.loadAsync( buffer );
			} )
			.then( function( zip ) {
				var slideFiles = [];
				var $slides = $( '<div />', { 'class': 'pgm-mo-ppt-slides' } );
				zip.forEach( function( path, file ) {
					if ( /^ppt\/slides\/slide\d+\.xml$/.test( path ) ) {
						slideFiles.push( file );
					}
				} );
				slideFiles.sort( function( a, b ) {
					return slideNumberFromPath( a.name ) - slideNumberFromPath( b.name );
				} );
				return Promise.all( slideFiles.slice( 0, 24 ).map( function( file, index ) {
					return file.async( 'string' ).then( function( xml ) {
						return { index: index + 1, text: textFromSlideXml( xml ) };
					} );
				} ) ).then( function( slides ) {
					if ( ! slides.length ) {
						renderPreviewFallback( $preview, 'powerpoint', filename, 'No slides found.' );
						return;
					}
					slides.forEach( function( slide ) {
						var $slide = $( '<section />', { 'class': 'pgm-mo-ppt-slide' } );
						$slide.append( $( '<div />', { 'class': 'pgm-mo-ppt-slide-title', text: 'Slide ' + slide.index } ) );
						if ( slide.text.length ) {
							slide.text.slice( 0, 18 ).forEach( function( text ) {
								$slide.append( $( '<p />', { text: text } ) );
							} );
						} else {
							$slide.append( $( '<p />', { 'class': 'is-muted', text: 'No text on this slide.' } ) );
						}
						$slides.append( $slide );
					} );
					if ( slideFiles.length > slides.length ) {
						$slides.append( $( '<div />', { 'class': 'pgm-mo-preview-message', text: 'Showing first ' + slides.length + ' slides.' } ) );
					}
					$preview.empty().removeClass( 'is-loading has-fallback' ).append( $slides );
				} );
			} )
			.catch( function( error ) {
				renderPreviewFallback( $preview, 'powerpoint', filename, error.message || 'PowerPoint preview failed.' );
			} );
	}

	function buildAttachmentDetailPreview( data, type ) {
		var url = attachmentPreviewUrl( data );
		var filename = String( data && data.filename || '' );
		var mime = String( data && data.mime || '' );
		var $preview = $( '<div />', { 'class': 'pgm-mo-detail-preview is-' + type } );
		var $media;

		if ( type === 'pdf' && url ) {
			renderPdfPreview( $preview, data );
			return $preview;
		}

		if ( type === 'video' && url ) {
			$media = $( '<video />', {
				'class': 'pgm-mo-detail-media',
				controls: true,
				preload: 'metadata',
			} );
			$media.append( $( '<source />', { src: url, type: mime } ) );
			return $preview.append( $media );
		}

		if ( type === 'audio' && url ) {
			$media = $( '<audio />', {
				'class': 'pgm-mo-detail-media',
				controls: true,
				preload: 'metadata',
			} );
			$media.append( $( '<source />', { src: url, type: mime } ) );
			return $preview.append( $media );
		}

		if ( type === 'word' ) {
			renderDocxPreview( $preview, data );
			return $preview;
		}

		if ( type === 'excel' ) {
			renderExcelPreview( $preview, data );
			return $preview;
		}

		if ( type === 'powerpoint' ) {
			renderPowerPointPreview( $preview, data );
			return $preview;
		}

		$preview.append( buildAttachmentIcon( type ).addClass( 'is-detail' ) );
		if ( filename ) {
			$preview.append( $( '<div />', { 'class': 'pgm-mo-detail-file-name', text: filename } ) );
		}

		return $preview;
	}

	function enhanceAttachmentDetailPreview( root, model ) {
		var data = model && model.toJSON ? model.toJSON() : {};
		var type = attachmentDataFileType( data );
		var $root = $( root || document );
		var $mediaView = $root.find( '.attachment-media-view' ).first();
		var $surface;
		var previewKey;

		if ( ! $mediaView.length ) {
			$mediaView = $root.find( '.attachment-info > .thumbnail' ).first();
		}

		if ( ! $mediaView.length ) {
			return;
		}

		previewKey = [ data.id || '', type || '', attachmentPreviewUrl( data ) ].join( ':' );

		if ( type && $mediaView.data( 'pgmMoPreviewKey' ) === previewKey && $mediaView.find( '.pgm-mo-detail-preview' ).length ) {
			return;
		}

		$mediaView
			.removeClass( 'pgm-mo-has-detail-preview pgm-mo-detail-preview-pdf pgm-mo-detail-preview-audio pgm-mo-detail-preview-video pgm-mo-detail-preview-document pgm-mo-detail-preview-excel pgm-mo-detail-preview-powerpoint pgm-mo-detail-preview-word pgm-mo-detail-preview-archive' )
			.find( '.pgm-mo-detail-preview' )
			.remove();
		$mediaView.removeData( 'pgmMoPreviewKey' );

		if ( ! type ) {
			return;
		}

		$surface = $mediaView.children( '.thumbnail' ).first();
		if ( ! $surface.length ) {
			$surface = $mediaView;
		}

		$mediaView.addClass( 'pgm-mo-has-detail-preview pgm-mo-detail-preview-' + type );
		$mediaView.data( 'pgmMoPreviewKey', previewKey );
		$surface.append( buildAttachmentDetailPreview( data, type ) );
	}

	function visibleAttachmentDetailModel() {
		var frame = wp && wp.media && wp.media.frames ? wp.media.frames.edit : null;
		var selection;

		if ( frame && frame.model ) {
			return frame.model;
		}

		frame = wp && wp.media ? wp.media.frame : null;
		if ( frame && frame.state ) {
			selection = frame.state().get( 'selection' );
			if ( selection && selection.single ) {
				return selection.single();
			}
		}

		return null;
	}

	function enhanceVisibleAttachmentDetailPreviews() {
		var model = visibleAttachmentDetailModel();
		if ( ! model ) {
			return;
		}

		$( '.attachment-details' ).each( function() {
			enhanceAttachmentDetailPreview( this, model );
		} );
	}

	function scheduleAttachmentIconEnhance() {
		window.clearTimeout( attachmentIconTimer );
		attachmentIconTimer = window.setTimeout( function() {
			enhanceAttachmentIcons();
			enhanceVisibleAttachmentDetailPreviews();
		}, 60 );
	}

	function observeAttachmentIcons() {
		enhanceAttachmentIcons();
		if ( attachmentIconObserver || ! window.MutationObserver ) {
			return;
		}

		attachmentIconObserver = new window.MutationObserver( scheduleAttachmentIconEnhance );
		attachmentIconObserver.observe( document.body, {
			childList: true,
			subtree: true,
		} );
	}

	function importCatFolders( $target ) {
		$target.text( t( 'loading', 'Loading...' ) ).removeClass( 'is-error' );
		ajax( 'pecodex_mo_import_catfolders' )
			.done( function( response ) {
				if ( response && response.success ) {
					state.folders = response.data.folders || [];
					state.flatFolders = response.data.flatFolders || []; if (response.data && response.data.counts) { state.counts = response.data.counts; }
					renderAllSidebars();
					$target.text( response.data.message || t( 'done', 'Done.' ) );
				} else {
					$target.addClass( 'is-error' ).text( response && response.data && response.data.message ? response.data.message : t( 'error', 'Action failed.' ) );
				}
			} )
			.fail( function( xhr ) {
				var message = xhr.responseJSON && xhr.responseJSON.data && xhr.responseJSON.data.message ? xhr.responseJSON.data.message : t( 'error', 'Action failed.' );
				$target.addClass( 'is-error' ).text( message );
			} );
	}

	function triggerBulkSelect( $sidebar ) {
		var labels = [
			'bulk select',
			'valitse useita',
			wp && wp.media && wp.media.view && wp.media.view.l10n && wp.media.view.l10n.bulkSelect ? String( wp.media.view.l10n.bulkSelect ).toLowerCase() : '',
		].filter( Boolean );
		var $frameRoot = $sidebar && $sidebar.length ? $sidebar.closest( '.media-frame, .media-modal, .media-modal-content, .upload-php .wrap' ) : $();
		var $searchRoot = $frameRoot.length ? $frameRoot : $( document );
		var $button = $searchRoot.find( '.media-toolbar .media-button-selectModeToggleButton, .media-toolbar .select-mode-toggle-button, .media-toolbar .media-button-select-mode-toggle, .media-frame.mode-grid .bulk-select .button' ).filter( ':visible' ).first();

		if ( ! $button.length ) {
			$button = $searchRoot.find( '.media-toolbar .button, .wp-filter .button, .media-frame .button' ).filter( function() {
				var text = $.trim( $( this ).text() ).toLowerCase();
				return labels.some( function( label ) {
					return text.indexOf( label ) !== -1;
				} );
			} ).first();
		}

		if ( $button.length ) {
			$button.trigger( 'click' );
		} else {
			$( document.body ).toggleClass( 'pgm-mo-manual-bulk-select' );
			$searchRoot.find( '.media-frame, .media-frame-content, .attachments-browser' ).addBack( '.media-frame, .media-frame-content, .attachments-browser' ).toggleClass( 'mode-select' );
		}
	}

	function folderById( id ) {
		var match = null;
		walkFolders( state.folders, function( folder ) {
			if ( String( folder.id ) === String( id ) ) {
				match = folder;
			}
		} );
		return match;
	}

	function clearFolderReorderClasses() {
		$( '.pgm-mo-folder-item' ).removeClass( 'is-folder-drop-before is-folder-drop-after is-folder-drop-inside' );
	}

	function cancelFolderAutoExpand() {
		if ( folderAutoExpandTimer ) {
			window.clearTimeout( folderAutoExpandTimer );
		}
		folderAutoExpandTimer = null;
		folderAutoExpandTargetId = 0;
		$( '.pgm-mo-folder-item' ).removeClass( 'is-folder-auto-expanding' );
	}

	function clearFolderDragClasses() {
		cancelFolderAutoExpand();
		$( '.pgm-mo-folder-item' ).removeClass( 'is-folder-dragging is-folder-drop-before is-folder-drop-after is-folder-drop-inside' );
		$( document.body ).removeClass( 'pgm-mo-folder-sorting' );
	}

	function folderDropPosition( event, element ) {
		var source = event.originalEvent || event;
		var rect = element.getBoundingClientRect();
		var y = source.clientY || 0;
		var edgeZone = Math.max( 5, Math.min( 8, rect.height * 0.22 ) );
		var topZone = rect.top + edgeZone;
		var bottomZone = rect.bottom - edgeZone;

		if ( source.altKey ) {
			return y < rect.top + ( rect.height / 2 ) ? 'before' : 'after';
		}

		if ( y < topZone ) {
			return 'before';
		}
		if ( y > bottomZone ) {
			return 'after';
		}

		return 'inside';
	}

	function folderDropClass( position ) {
		if ( 'inside' === position ) {
			return 'is-folder-drop-inside';
		}

		return 'before' === position ? 'is-folder-drop-before' : 'is-folder-drop-after';
	}

	function folderDragEventSnapshot( event ) {
		var source = event.originalEvent || event;

		return {
			clientX: source.clientX,
			clientY: source.clientY,
			altKey: !! source.altKey,
		};
	}

	function scheduleFolderAutoExpand( folder, position, event ) {
		var id = parseInt( folder && folder.id, 10 ) || 0;
		var snapshot;

		if ( ! id || ! visibleChildren( folder ).length || state.expanded[ id ] ) {
			if ( folderAutoExpandTargetId && folderAutoExpandTargetId !== id ) {
				cancelFolderAutoExpand();
			}
			return;
		}

		if ( folderAutoExpandTargetId === id ) {
			return;
		}

		cancelFolderAutoExpand();
		folderAutoExpandTargetId = id;
		snapshot = folderDragEventSnapshot( event );
		$( '.pgm-mo-folder-button[data-folder-id="' + id + '"]' ).closest( '.pgm-mo-folder-item' ).addClass( 'is-folder-auto-expanding' );
		folderAutoExpandTimer = window.setTimeout( function() {
			var hasActiveDrag = !! state.draggedFolderId || !! ( state.mediaPointerDrag && state.mediaPointerDrag.active );
			var current = folderById( id );

			folderAutoExpandTimer = null;
			$( '.pgm-mo-folder-item' ).removeClass( 'is-folder-auto-expanding' );
			if ( ! hasActiveDrag || folderAutoExpandTargetId !== id || ! current || state.expanded[ id ] || ! visibleChildren( current ).length ) {
				folderAutoExpandTargetId = 0;
				return;
			}

			state.expanded[ id ] = true;
			folderAutoExpandTargetId = 0;
			renderAllSidebars();

			if ( state.folderPointerDrag ) {
				window.requestAnimationFrame( function() {
					updateFolderPointerTarget( { originalEvent: snapshot } );
				} );
			} else if ( state.mediaPointerDrag && state.mediaPointerDrag.active ) {
				window.requestAnimationFrame( function() {
					updateMediaDragTarget( state.mediaPointerDrag, { originalEvent: snapshot } );
				} );
			}
		}, 520 );
	}

	function folderIsDescendantOf( folderId, ancestorId ) {
		var current = folderById( folderId );
		var parentId;

		ancestorId = parseInt( ancestorId, 10 ) || 0;
		while ( current && current.parent ) {
			parentId = parseInt( current.parent, 10 ) || 0;
			if ( parentId === ancestorId ) {
				return true;
			}
			current = folderById( parentId );
		}

		return false;
	}

	function canReorderFolder( dragged, target, position ) {
		var draggedId = dragged ? parseInt( dragged.id, 10 ) || 0 : 0;
		var targetId = target ? parseInt( target.id, 10 ) || 0 : 0;
		var newParent = 0;

		position = position || 'after';
		newParent = 'inside' === position ? targetId : parseInt( target && target.parent || 0, 10 ) || 0;

		return draggedId > 0 &&
			targetId > 0 &&
			draggedId !== targetId &&
			! dragged.special &&
			! target.special &&
			newParent !== draggedId &&
			! folderIsDescendantOf( targetId, draggedId ) &&
			( ! newParent || ! folderIsDescendantOf( newParent, draggedId ) );
	}

	function stopFolderPointerEvent( event ) {
		event.preventDefault(); event.stopPropagation();
		event.stopPropagation();

		if ( event.originalEvent && event.originalEvent.stopPropagation ) {
			event.originalEvent.stopPropagation();
		}
	}

	function folderButtonAtPoint( event ) {
		var source = event.originalEvent || event;
		var element;
		var $button;

		if ( ! source.clientX && source.clientX !== 0 ) {
			return $();
		}

		element = document.elementFromPoint( source.clientX, source.clientY );
		$button = $( element ).closest( '.pgm-mo-folder-button' );
		if ( ! $button.length ) {
			$button = $( element ).closest( '.pgm-mo-folder-row' ).find( '.pgm-mo-folder-button' ).first();
		}

		return $button;
	}

	function updateFolderPointerTarget( event ) {
		var drag = state.folderPointerDrag;
		var draggedFolder;
		var targetFolder;
		var targetId;
		var position;
		var $button;
		var $row;
		var $item;

		if ( ! drag ) {
			return;
		}

		$button = folderButtonAtPoint( event );
		if ( ! $button.length ) {
			drag.targetId = 0;
			cancelFolderAutoExpand();
			clearFolderReorderClasses();
			return;
		}

		targetId = parseInt( $button.attr( 'data-folder-id' ), 10 ) || 0;
		draggedFolder = folderById( drag.folderId );
		targetFolder = folderById( targetId );
		$row = $button.closest( '.pgm-mo-folder-row' );
		$item = $button.closest( '.pgm-mo-folder-item' );
		position = folderDropPosition( event, $row[0] || $button[0] );

		if ( ! canReorderFolder( draggedFolder, targetFolder, position ) ) {
			drag.targetId = 0;
			cancelFolderAutoExpand();
			clearFolderReorderClasses();
			return;
		}

		drag.targetId = targetId;
		drag.position = position;
		clearFolderReorderClasses();
		$item.addClass( folderDropClass( position ) );
		scheduleFolderAutoExpand( targetFolder, position, event );
	}

	function startFolderPointerDrag( folder, $item, $sidebar, event ) {
		var folderId = folder ? parseInt( folder.id, 10 ) || 0 : 0;

		if ( ! folderId ) {
			return;
		}

		stopFolderPointerEvent( event );
		state.draggedFolderId = folderId;
		state.draggedIds = [];
		state.folderPointerDrag = {
			folderId: folderId,
			targetId: 0,
			position: 'after',
			sidebar: $sidebar,
		};

		clearFolderReorderClasses();
		$( document.body ).addClass( 'pgm-mo-folder-sorting' );
		$item.addClass( 'is-folder-dragging' );

		$( document )
			.off( '.pgmMoFolderPointer' )
			.on( 'mousemove.pgmMoFolderPointer', function( moveEvent ) {
				stopFolderPointerEvent( moveEvent );
				updateFolderPointerTarget( moveEvent );
			} )
			.on( 'mouseup.pgmMoFolderPointer', function( upEvent ) {
				var drag = state.folderPointerDrag;

				stopFolderPointerEvent( upEvent );
				$( document ).off( '.pgmMoFolderPointer' );
				state.folderPointerDrag = null;
				state.draggedFolderId = 0;
				cancelFolderAutoExpand();

				if ( drag && drag.targetId ) {
					reorderFolder( drag.folderId, drag.targetId, drag.position, drag.sidebar );
					return;
				}

				clearFolderDragClasses();
			} );
	}

	function inheritedAccessForFolder( folder ) {
		var parent = folder && folder.parent ? folderById( folder.parent ) : null;

		return parent ? folderEffectiveAccess( parent ) : 'public';
	}

	function visibleChildren( folder ) {
		return ( folder.children || [] ).filter( function( child ) {
			return folderVisible( child );
		} );
	}

	function hasActiveMediaQueryFilters() {
		return !! ( state.mediaQueryFilters && Object.keys( state.mediaQueryFilters ).length );
	}

	function folderVisible( folder ) {
		var needle = String( state.filterText || '' ).toLowerCase();
		var hasMatchingChild = ( folder.children || [] ).some( folderVisible );
		var folderCount = parseInt( folder.count || 0, 10 ) || 0;
		var hideEmptyForView = hasActiveMediaQueryFilters() || ! state.preferences.showEmptyFolders;

		if ( folder.special ) {
			return true;
		}

		if ( parseInt( folder.id, 10 ) === parseInt( state.selectedFolder, 10 ) ) {
			return true;
		}

		if ( needle && String( folder.name || '' ).toLowerCase().indexOf( needle ) === -1 && ! hasMatchingChild ) {
			return false;
		}

		if ( hideEmptyForView && ! folderCount && ! hasMatchingChild ) {
			return false;
		}

		return true;
	}

	function folderLabel( folder ) {
		var label = folder.name || '';
		if ( state.preferences.showCounts && ! folder.special ) {
			label += ' (' + ( folder.count || 0 ) + ')';
		}
		return label;
	}

	function renderFolderNode( folder, $list, depth, $sidebar ) {
		var id = folder.id;
		var idNumber = parseInt( id, 10 ) || 0;
		var children = visibleChildren( folder );
		var hasChildren = children.length > 0;
		var isExpanded = !! state.expanded[ id ];
		var isActive = idNumber === parseInt( state.selectedFolder, 10 );
		var effectiveAccess = folderEffectiveAccess( folder );
		var isReorderable = idNumber > 0 && ! folder.special;
		var $item = $( '<li />', {
			'class': 'pgm-mo-folder-item depth-' + Math.min( depth, 5 ) + ( isActive ? ' is-active' : '' ) + ( folder.special ? ' is-special' : '' ) + ( idNumber === parseInt( state.draggedFolderId, 10 ) ? ' is-folder-dragging' : '' ) + ( ! folder.special && effectiveAccess !== 'public' ? ' is-access-' + effectiveAccess : '' ),
		} );
		var $row = $( '<div />', { 'class': 'pgm-mo-folder-row' } );
		var $toggle = $( '<button />', {
			type: 'button',
			'class': 'pgm-mo-disclosure',
			'aria-label': hasChildren ? 'Toggle folder' : '',
			disabled: ! hasChildren,
		} ).append( hasChildren ? icon( isExpanded ? 'arrow-down-alt2' : 'arrow-right-alt2' ) : '' );
		var $button = $( '<button />', {
			type: 'button',
			'class': 'pgm-mo-folder-button' + ( isReorderable ? ' has-drag-handle' : '' ),
			'aria-haspopup': 'menu',
			'data-folder-id': id,
		} ).append(
			icon( folder.special === 'all' ? 'media-default' : folder.special === 'uncategorized' ? 'category' : 'portfolio' ),
			$( '<span />', { 'class': 'pgm-mo-folder-label', text: folderLabel( folder ) } )
		);

		if ( ! folder.special && effectiveAccess !== 'public' ) {
			$button.append( $( '<span />', {
				'class': 'pgm-mo-access-badge is-' + effectiveAccess,
				text: folderAccessLabel( effectiveAccess, true ),
				title: folderAccessLabel( effectiveAccess, false ),
			} ) );
		}

		if ( isReorderable ) {
			$( '<span />', {
				'class': 'pgm-mo-folder-drag-handle',
				draggable: 'false',
				title: t( 'dragToReorder', 'Drag to reorder' ),
				'aria-label': t( 'dragToReorder', 'Drag to reorder' ),
			} )
				.append( icon( 'grip-vertical' ) )
				.on( 'click', function( event ) {
					event.stopPropagation();
				} )
				.on( 'mousedown', function( event ) {
					startFolderPointerDrag( folder, $item, $sidebar, event );
				} )
				.on( 'dragstart', function( event ) {
					stopFolderPointerEvent( event );
					return false;
				} )
				.appendTo( $button );
		}

		$toggle.on( 'click', function( event ) {
			event.stopPropagation();
			state.expanded[ id ] = ! state.expanded[ id ];
			renderAllSidebars();
		} );

		$button.on( 'click', function( event ) {
			event.preventDefault(); event.stopPropagation();
			if ( hasChildren && ! state.expanded[ id ] ) {
				state.expanded[ id ] = true;
			}
			selectFolder( idNumber, $sidebar );
		} );
		$button.on( 'dblclick', function() {
			renameFolder( folder, $sidebar );
		} );
		$row.on( 'contextmenu', function( event ) {
			event.preventDefault(); event.stopPropagation();
			if ( idNumber > 0 ) {
				showContextMenu( folder, $sidebar, event.clientX, event.clientY, $item );
			}
		} );
		$button.on( 'keydown', function( event ) {
			var rect;
			if ( event.key === 'ContextMenu' || ( event.shiftKey && event.key === 'F10' ) ) {
				event.preventDefault(); event.stopPropagation();
				if ( idNumber > 0 ) {
					rect = this.getBoundingClientRect();
					showContextMenu( folder, $sidebar, rect.left + 20, rect.bottom - 2, $item );
				}
			}
		} );
		$button.on( 'dragover', function( event ) {
			var draggedFolder;
			var position;

			if ( state.draggedFolderId ) {
				draggedFolder = folderById( state.draggedFolderId );
				position = folderDropPosition( event, $row[0] );
				if ( canReorderFolder( draggedFolder, folder, position ) ) {
					event.preventDefault(); event.stopPropagation();
					if ( event.originalEvent && event.originalEvent.dataTransfer ) {
						event.originalEvent.dataTransfer.dropEffect = 'move';
					}
					clearFolderReorderClasses();
