		var $actions = $( '<div />', { 'class': 'pgm-mo-about-actions' } )
			.append(
				$( '<a />', { 'class': 'button button-primary', href: companyUrl, target: '_blank', rel: 'noopener noreferrer' } )
					.append( icon( 'external-link' ), $( '<span />', { text: t( 'aboutOpenWebsite', 'Avaa pecodex.fi' ) } ) )
			);

		$body.empty().append(
			$( '<div />', { 'class': 'pgm-mo-subsettings-header' } )
				.append(
