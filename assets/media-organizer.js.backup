	function renderPrivateMediaSettings( $body ) {
		var settings = normalizePrivateSettings( state.privateSettings || {} );
		var loginChoices = config.privateMediaChoices && config.privateMediaChoices.loginModes ? config.privateMediaChoices.loginModes : {};
		var protectChoices = config.privateMediaChoices && config.privateMediaChoices.protectModes ? config.privateMediaChoices.protectModes : {};
		var $message = $( '<p />', { 'class': 'pgm-mo-modal-message', role: 'status' } );
		var $saveButton = $( '<button />', { type: 'button', 'class': 'button button-primary pgm-mo-save-settings' } )
			.append( icon( 'saved' ), $( '<span />', { text: t( 'saveSettings', 'Tallenna asetukset' ) } ) )
			.on( 'click', function() {
				savePrivateSettings( $body.closest( '.pgm-mo-modal' ) );
			} );

		state.privateSettings = settings;

		$body.empty().append(
			$( '<div />', { 'class': 'pgm-mo-subsettings-header' } )
				.append(
					$( '<button />', { type: 'button', 'class': 'button-link pgm-mo-back-button', text: '< ' + t( 'back', 'Takaisin' ) } )
						.on( 'click', function() {
							renderSettingsMain( $body );
						} ),
					$( '<h3 />', { text: t( 'privateMediaSettings', 'Suojaus ja kirjautuminen' ) } ),
					$( '<p />', { 'class': 'description', text: t( 'privateMediaSettingsHelp', 'NÃ¤mÃ¤ asetukset ohjaavat miten suojatut mediatiedostot avataan, kenelle ne nÃ¤kyvÃ¤t ja poistetaanko public uploads -kopio.' ) } )
				),
			settingSwitch( t( 'privateMediaEnabled', 'Ota suojaus kÃ¤yttÃ¶Ã¶n' ), settings.enabled, function( value ) {
				state.privateSettings.enabled = value;
			} ),
			settingSelect( t( 'privateMediaLoginMode', 'Kirjautumaton kÃ¤yttÃ¤jÃ¤ ohjataan' ), loginChoices, settings.loginMode, function( value ) {
				state.privateSettings.loginMode = value || 'auto';
			} ),
			settingTextInput( t( 'privateMediaCustomLoginUrl', 'Oma kirjautumisosoite' ), settings.customLoginUrl, function( value ) {
				state.privateSettings.customLoginUrl = value;
			}, window.location.origin + '/kirjaudu/', 'url' ),
			settingSelect( t( 'privateMediaProtectMode', 'Suojaustapa' ), protectChoices, settings.protectMode, function( value ) {
				state.privateSettings.protectMode = value || 'marked';
			} ),
			settingTextInput( t( 'privateMediaProtectedExtensions', 'Suojattavat tiedostopÃ¤Ã¤tteet' ), settings.protectedExtensions, function( value ) {
				state.privateSettings.protectedExtensions = value;
			}, 'pdf,doc,docx,xls,xlsx,ppt,pptx,zip' ),
			settingTextInput( t( 'privateMediaRequiredCapability', 'Vaadittu kÃ¤yttÃ¶oikeus' ), settings.requiredCapability, function( value ) {
				state.privateSettings.requiredCapability = value;
			}, 'read' ),
			settingSwitch( t( 'privateMediaProtectUnknownUploads', 'Suojaa myÃ¶s tuntemattomat upload-tiedostot endpointin kautta' ), settings.protectUnknownUploads, function( value ) {
				state.privateSettings.protectUnknownUploads = value;
			} ),
			settingSwitch( t( 'privateMediaMoveFiles', 'Piilota yksityiset mediatiedostot julkisilta salattuun uploads-varastoon' ), settings.moveFilesToPrivateStorage, function( value ) {
				state.privateSettings.moveFilesToPrivateStorage = value;
			} ),
			$( '<p />', { 'class': 'description pgm-mo-private-help', text: t( 'privateMediaMoveFilesHelp', 'Vahvin tila: public uploads -kopio poistetaan ja tiedosto puretaan vain Pecodexin suojatun endpointin kautta.' ) } ),
			$( '<div />', { 'class': 'pgm-mo-security-actions' } )
				.append(
					$( '<div />' ).append(
						$( '<strong />', { text: t( 'privateMediaSyncStorage', 'SiirrÃ¤ odottavat tiedostot nyt' ) } ),
						$( '<small />', { text: t( 'privateMediaSyncStorageHelp', 'Ajaa lÃ¤pi yksityiseksi merkityt mediat ja siirtÃ¤Ã¤ public-kopiot private-varastoon.' ) } )
					),
					$( '<button />', { type: 'button', 'class': 'button button-secondary', disabled: ! settings.syncStorageUrl } )
						.append( icon( 'lock' ), $( '<span />', { text: t( 'privateMediaSyncStorage', 'SiirrÃ¤ odottavat tiedostot nyt' ) } ) )
						.on( 'click', function() {
							if ( state.privateSettings.syncStorageUrl ) {
								window.location.href = state.privateSettings.syncStorageUrl;
							}
						} )
				),
			$saveButton,
			$message
		);
	}

	function privateDiagnosticMetric( label, value, tone ) {
		return $( '<div />', { 'class': 'pgm-mo-diagnostic-metric' + ( tone ? ' is-' + tone : '' ) } )
			.append(
				$( '<strong />', { text: String( value ) } ),
				$( '<span />', { text: label } )
			);
	}

	function renderPrivateDiagnosticsSettings( $body ) {
		var diagnostics = normalizePrivateDiagnostics( state.privateDiagnostics || config.privateMediaDiagnostics || {} );
		var counts = diagnostics.counts;
		var statusClass = diagnostics.enabled && diagnostics.health !== 'warning' ? 'is-ok' : 'is-warning';
		var statusText = diagnostics.enabled
			? ( diagnostics.health === 'warning' ? t( 'privateMediaDiagnosticsAttention', 'Tarkistettavia kohteita lÃ¶ytyi.' ) : t( 'privateMediaDiagnosticsHealthy', 'Suojaus nÃ¤yttÃ¤Ã¤ hyvÃ¤ltÃ¤.' ) )
			: t( 'privateMediaDiagnosticsDisabled', 'Suojaus ei ole kÃ¤ytÃ¶ssÃ¤.' );
		var $actions = $( '<div />', { 'class': 'pgm-mo-diagnostic-actions' } );

		state.privateDiagnostics = diagnostics;

		if ( diagnostics.syncStorageUrl ) {
			$actions.append(
				$( '<button />', { type: 'button', 'class': 'button button-primary' } )
					.append( icon( 'lock' ), $( '<span />', { text: t( 'privateMediaDiagnosticsSync', 'Synkronoi suojatut tiedostot' ) } ) )
					.on( 'click', function() {
						window.location.href = diagnostics.syncStorageUrl;
					} )
			);
		}

		if ( diagnostics.diagnosticsUrl ) {
			$actions.append(
				$( '<a />', { 'class': 'button button-secondary', href: diagnostics.diagnosticsUrl } )
					.append( icon( 'external-link' ), $( '<span />', { text: t( 'privateMediaDiagnosticsOpenFull', 'Avaa tÃ¤ysi diagnostiikka' ) } ) )
			);
		}

		$body.empty().append(
			$( '<div />', { 'class': 'pgm-mo-subsettings-header' } )
				.append(
					$( '<button />', { type: 'button', 'class': 'button-link pgm-mo-back-button', text: '< ' + t( 'back', 'Takaisin' ) } )
						.on( 'click', function() {
							renderSettingsMain( $body );
						} ),
					$( '<h3 />', { text: t( 'privateMediaDiagnostics', 'Diagnostiikka ja korjaus' ) } ),
					$( '<p />', { 'class': 'description', text: t( 'privateMediaDiagnosticsHelp', 'Yhteenveto kertoo ovatko suojatut tiedostot fyysisesti pois public uploads -kansiosta ja onko linkkisynkka ajan tasalla.' ) } )
				),
			$( '<div />', { 'class': 'pgm-mo-diagnostic-status ' + statusClass } )
				.append( icon( diagnostics.health === 'warning' || ! diagnostics.enabled ? 'info' : 'lock' ), $( '<strong />', { text: statusText } ) ),
			$( '<div />', { 'class': 'pgm-mo-diagnostic-grid' } )
				.append(
					privateDiagnosticMetric( t( 'privateMediaDiagnosticProtectedFiles', 'Suojatut liitteet' ), counts.total ),
					privateDiagnosticMetric( t( 'privateMediaDiagnosticHiddenFiles', 'Piilotettu publicista' ), counts.hidden, 'ok' ),
					privateDiagnosticMetric( t( 'privateMediaDiagnosticLinkOnly', 'Public-kopio tarkistettava' ), counts.linkOnly ),
					privateDiagnosticMetric( t( 'privateMediaDiagnosticPublicCopies', 'Public-kopioita' ), counts.publicCopies, counts.publicCopies ? 'warning' : '' ),
					privateDiagnosticMetric( t( 'privateMediaDiagnosticPrivateCopies', 'Private-kopioita' ), counts.privateCopies ),
					privateDiagnosticMetric( t( 'privateMediaDiagnosticDirectBlocked', 'Suorat uploads-URLit estetty' ), counts.directUploadsBlocked, 'ok' ),
					privateDiagnosticMetric( t( 'privateMediaDiagnosticDirectOpen', 'Suorat uploads-URLit avoinna' ), counts.directUploadsOpen, counts.directUploadsOpen ? 'warning' : 'ok' ),
					privateDiagnosticMetric( t( 'privateMediaDiagnosticAttentionCount', 'Huomiot' ), counts.attention, counts.attention ? 'warning' : 'ok' ),
					privateDiagnosticMetric( t( 'privateMediaDiagnosticOriginalUrlMemory', 'AlkuperÃ¤isiÃ¤ URL-muisteja' ), counts.originalUrlMemory ),
					privateDiagnosticMetric( t( 'privateMediaDiagnosticActiveProtected', 'Aktiivisia suojalinkkejÃ¤' ), counts.activeProtected ),
					privateDiagnosticMetric( t( 'privateMediaDiagnosticContentPrivate', 'Private-linkkisynkkia' ), counts.contentPrivate )
				),
			$( '<div />', { 'class': 'pgm-mo-diagnostic-env' } )
				.append(
					privateDiagnosticMetric( t( 'privateMediaDiagnosticOpenSsl', 'OpenSSL' ), diagnostics.opensslAvailable ? 'OK' : 'Puuttuu', diagnostics.opensslAvailable ? 'ok' : 'warning' ),
					privateDiagnosticMetric( t( 'privateMediaDiagnosticStorage', 'Private-varasto' ), diagnostics.storageExists ? 'OK' : 'Ei vielÃ¤', diagnostics.storageExists ? 'ok' : 'warning' )
				)
				.append( diagnostics.storageStatusText ? $( '<p />', { text: diagnostics.storageStatusText } ) : $() ),
			$actions
		);
	}

	function renderImportExportSettings( $body ) {
		var $message = $( '<p />', { 'class': 'pgm-mo-modal-message', role: 'status' } );
		var $fileName = $( '<span />', { text: t( 'chooseZipFile', 'Valitse ZIP-tiedosto' ) } );
		var $fileInput = $( '<input />', {
			type: 'file',
			id: 'pgm-mo-modal-zip-file',
			name: 'pgm_mo_zip',
			accept: '.zip,application/zip',
		} ).on( 'change', function() {
			var file = this.files && this.files[0] ? this.files[0] : null;
			$fileName.text( file ? file.name : t( 'chooseZipFile', 'Valitse ZIP-tiedosto' ) );
			$message.removeClass( 'is-error' ).text( '' );
		} );

		var $zipForm = $( '<form />', {
			method: 'post',
			action: config.adminPostUrl,
			enctype: 'multipart/form-data',
			'class': 'pgm-mo-modal-zip-form',
		} ).append(
			$( '<input />', { type: 'hidden', name: 'action', value: config.zipImportAction || 'pecodex_mo_import_zip' } ),
			$( '<input />', { type: 'hidden', name: '_wpnonce', value: config.zipImportNonce || config.nonce } ),
			$( '<label />', { 'class': 'pgm-mo-file-picker', 'for': 'pgm-mo-modal-zip-file' } )
				.append( icon( 'archive' ), $fileName, $fileInput ),
			$( '<button />', { type: 'submit', 'class': 'button button-secondary' } )
				.append( icon( 'archive' ), $( '<span />', { text: t( 'importZip', 'Tuo ZIP' ) } ) )
		).on( 'submit', function( event ) {
			if ( ! $fileInput[0].files || ! $fileInput[0].files.length ) {
				event.preventDefault(); event.stopPropagation();
				$message.addClass( 'is-error' ).text( t( 'zipFileRequired', 'Valitse ensin ZIP-tiedosto.' ) );
				return;
			}

			$message.removeClass( 'is-error' ).text( t( 'zipImportSubmitting', 'LÃ¤hetetÃ¤Ã¤n ZIP-tuonti...' ) );
		} );

		$body.empty().append(
			$( '<div />', { 'class': 'pgm-mo-subsettings-header' } )
				.append(
					$( '<button />', { type: 'button', 'class': 'button-link pgm-mo-back-button', text: '< ' + t( 'back', 'Takaisin' ) } )
						.on( 'click', function() {
							renderSettingsMain( $body );
						} ),
					$( '<h3 />', { text: t( 'importExportTools', 'Tuonti, vienti ja ZIP' ) } ),
					$( '<p />', { 'class': 'description', text: t( 'importExportToolsHelp', 'Tuo olemassa olevia kansioita, vie mediakirjasto ZIPiksi tai rakenna kansiopuu ZIP-tiedostosta.' ) } )
				),
			$( '<div />', { 'class': 'pgm-mo-tools-list' } )
				.append(
					$( '<section />', { 'class': 'pgm-mo-tool-card' } )
						.append(
							$( '<div />', { 'class': 'pgm-mo-tool-copy' } )
								.append(
									$( '<strong />', { text: t( 'importCatFoldersTitle', 'Tuo CatFoldersista' ) } ),
									$( '<small />', { text: t( 'importCatFoldersHelp', 'Kopioi CatFolders-kansiot ja medialiitokset Pecodex Media Libraryyn. Nykyiset Pecodex-kansiot sÃ¤ilyvÃ¤t.' ) } )
								),
							$( '<button />', { type: 'button', 'class': 'button button-secondary' } )
								.append( icon( 'folder-plus' ), $( '<span />', { text: t( 'importCatFolders', 'Tuo CatFolders' ) } ) )
								.on( 'click', function() {
									importCatFolders( $message );
								} )
						),
					$( '<section />', { 'class': 'pgm-mo-tool-card' } )
						.append(
							$( '<div />', { 'class': 'pgm-mo-tool-copy' } )
								.append(
									$( '<strong />', { text: t( 'exportLibraryZip', 'Vie koko mediakirjasto ZIPiksi' ) } ),
									$( '<small />', { text: t( 'exportLibraryZipHelp', 'Lataa kaikki mediat nykyisellÃ¤ kansiorakenteella. Alikansiot sisÃ¤llytetÃ¤Ã¤n vientiin.' ) } )
								),
							$( '<button />', { type: 'button', 'class': 'button button-secondary' } )
								.append( icon( 'download' ), $( '<span />', { text: t( 'download', 'Lataa ZIP' ) } ) )
								.on( 'click', function() {
									window.location.href = config.libraryExportUrl || exportUrl( 0 );
								} )
						),
					$( '<section />', { 'class': 'pgm-mo-tool-card is-stack' } )
						.append(
							$( '<div />', { 'class': 'pgm-mo-tool-copy' } )
								.append(
									$( '<strong />', { text: t( 'zipImportTitle', 'Tuo ZIP ja luo kansiorakenne' ) } ),
									$( '<small />', { text: t( 'zipImportHelp', 'ZIPin kansiorakenne luodaan mediakansioiksi ja tiedostot lisÃ¤tÃ¤Ã¤n Media Libraryyn.' ) } )
								),
							$zipForm
						)
				),
			$message
		);
	}

	function settingSelect( label, choices, selected, onChange ) {
		var $select = $( '<select />' );
		$.each( choices, function( value, text ) {
			$( '<option />', { value: value, text: text } ).prop( 'selected', String( value ) === String( selected ) ).appendTo( $select );
		} );
		$select.on( 'change', function() {
			onChange( $( this ).val() );
		} );
		return $( '<div />', { 'class': 'pgm-mo-setting-group' } ).append( $( '<label />', { text: label } ), $select );
	}

	function settingSwitch( label, checked, onChange ) {
		var $input = $( '<input />', { type: 'checkbox', checked: !! checked } );
		$input.on( 'change', function() {
			onChange( !! this.checked );
		} );
		return $( '<label />', { 'class': 'pgm-mo-switch-row' } )
			.append( $( '<span />', { text: label } ), $( '<span />', { 'class': 'pgm-mo-switch' } ).append( $input, $( '<span />' ) ) );
	}

	function settingTextInput( label, value, onChange, placeholder, type ) {
		var $input = $( '<input />', {
			type: type || 'text',
			value: value || '',
			placeholder: placeholder || '',
		} );
		$input.on( 'input', function() {
			onChange( $( this ).val() );
		} );
		return $( '<label />', { 'class': 'pgm-mo-setting-group pgm-mo-text-field' } )
			.append( $( '<span />', { text: label } ), $input );
	}

	function folderSelectChoices() {
		var choices = {
			0: t( 'allFiles', 'All Files' ),
			'-1': t( 'uncategorized', 'Uncategorized' ),
		};
		walkFolders( state.folders, function( folder, depth ) {
			if ( ! folder.special ) {
				choices[ folder.id ] = Array( depth + 1 ).join( '- ' ) + folder.name;
			}
		} );
		return choices;
	}

	function displayLinkChoices() {
		return $.extend( {
			none: t( 'displayLinkNone', 'Ei linkkiÃ¤' ),
			file: t( 'displayLinkFile', 'Mediatiedosto' ),
			post: t( 'displayLinkPost', 'Liitesivu' ),
		}, config.displayLinkChoices || {} );
	}

	function displayAlignChoices() {
		return $.extend( {
			none: t( 'displayAlignNone', 'Ei mitÃ¤Ã¤n' ),
			left: t( 'displayAlignLeft', 'Vasen' ),
			center: t( 'displayAlignCenter', 'KeskellÃ¤' ),
			right: t( 'displayAlignRight', 'Oikea' ),
		}, config.displayAlignChoices || {} );
	}

	function imageSizeChoices() {
		return $.extend( {
			thumbnail: t( 'galleryImageSizeThumbnail', 'Pienoiskuva' ),
			medium: t( 'galleryImageSizeMedium', 'Keskikokoinen' ),
			large: t( 'galleryImageSizeLarge', 'Suuri' ),
			full: t( 'galleryImageSizeFull', 'TÃ¤ysikokoinen' ),
		}, config.imageSizeChoices || {} );
	}

	function displayDefaultsSummaryText() {
		var defaults = normalizeDisplayDefaults( state.preferences.displayDefaults || {} );
		var links = displayLinkChoices();
		var sizes = imageSizeChoices();
		var aligns = displayAlignChoices();

		return sprintf(
			t( 'displayDefaultsSummary', 'Linkki: %s Â· Koko: %s Â· Tasaus: %s' ),
			links[ defaults.link ] || defaults.link,
			sizes[ defaults.size ] || defaults.size,
			aligns[ defaults.align ] || defaults.align
		);
	}

	function savePreferences( $modal ) {
		var $message = $modal.find( '.pgm-mo-modal-message' ).last();
		$message.removeClass( 'is-error' ).text( t( 'saving', 'Saving...' ) );

		ajax( 'pecodex_mo_save_preferences', {
			preferences: preferencesPayload(),
		} )
			.done( function( response ) {
				if ( ! response || ! response.success ) {
					$message.addClass( 'is-error' ).text( response && response.data && response.data.message ? response.data.message : t( 'error', 'Action failed.' ) );
					return;
				}
				config.options = response.data.options || config.options;
				state.preferences = normalizeOptions( config.options || {} );
				applyBodyClasses();
				applyColumnVisibility();
				renderAllSidebars();
				refreshGridIfPossible( nearestSidebar( $modal ) );
				$message.text( response.data.message || t( 'done', 'Done.' ) );
			} )
			.fail( function( xhr ) {
				var message = xhr.responseJSON && xhr.responseJSON.data && xhr.responseJSON.data.message ? xhr.responseJSON.data.message : t( 'error', 'Action failed.' );
				$message.addClass( 'is-error' ).text( message );
			} );
	}

	function savePrivateSettings( $modal ) {
		var $message = $modal.find( '.pgm-mo-modal-message' ).last();
		$message.removeClass( 'is-error' ).text( t( 'saving', 'Saving...' ) );

		ajax( 'pecodex_mo_save_private_settings', {
			private_settings: privateSettingsPayload(),
		} )
			.done( function( response ) {
				if ( ! response || ! response.success ) {
					$message.addClass( 'is-error' ).text( response && response.data && response.data.message ? response.data.message : t( 'error', 'Action failed.' ) );
					return;
				}

				config.privateMediaSettings = response.data.privateMediaSettings || config.privateMediaSettings;
				state.privateSettings = normalizePrivateSettings( config.privateMediaSettings || {} );
				$message.text( response.data.message || t( 'done', 'Done.' ) );
			} )
			.fail( function( xhr ) {
				var message = xhr.responseJSON && xhr.responseJSON.data && xhr.responseJSON.data.message ? xhr.responseJSON.data.message : t( 'error', 'Action failed.' );
				$message.addClass( 'is-error' ).text( message );
			} );
	}

	function renderUploadSidebar() {
		var $wrap;
		var $existing;
		var $sidebar;

		if ( window.location.href.indexOf( 'upload.php' ) === -1 || isOrganizerPage() ) {
			return;
		}

		$wrap = $( '.upload-php .wrap' ).first();
		if ( ! $wrap.length ) {
			return;
		}

		$existing = $wrap.children( '.pgm-mo-sidebar' );
		$sidebar = buildSidebar();
		$sidebar.data( 'pgmMoFrame', currentMediaFrame() );
		if ( $existing.length ) {
			$existing.replaceWith( $sidebar );
		} else {
			$wrap.addClass( 'pgm-mo-has-sidebar' ).prepend( $sidebar );
		}
		applySidebarWidth( state.preferences.folderTreeWidth );
	}

	function renderFrameSidebar( browser ) {
		var $browser = browser && browser.$el ? browser.$el : $( '.media-frame-content .attachments-browser' ).first();
		var browserView;
		var frame;
		var $existing;
		var $sidebar;

		if ( ! $browser.length ) {
			return;
		}
		

		browserView = browser && ( browser.collection || browser.controller || browser.options ) ? browser : $browser.data( 'pgmMoBrowserView' );
		if ( browserView ) {
			$browser.data( 'pgmMoBrowserView', browserView );
		}
		frame = frameFromBrowser( browserView ) || activeMediaFrame || currentMediaFrame();
		if ( frame ) {
			$browser.data( 'pgmMoFrame', frame );
		}
		scheduleStateRefreshForFilters( mediaQueryFilters( browserView || frame || $browser ) );
		$sidebar = buildSidebar().addClass( 'pgm-mo-frame-sidebar' );
		if ( browserView ) {
			$sidebar.data( 'pgmMoBrowserView', browserView );
		}
		if ( frame ) {
			$sidebar.data( 'pgmMoFrame', frame );
		}
		$existing = $browser.children( '.pgm-mo-frame-sidebar' );
		if ( $existing.length ) {
			$existing.replaceWith( $sidebar );
		} else {
			$browser.addClass( 'pgm-mo-frame-has-sidebar' ).prepend( $sidebar );
		}
		applySidebarWidth( state.preferences.folderTreeWidth );
	}

	function renderAllSidebars() {
		renderUploadSidebar();
		if ( isUploadLibraryScreen() ) {
			$( '.media-frame-content .attachments-browser' ).each( function() {
				var $browser = $( this );
				renderFrameSidebar( { $el: $browser } );
			} );
			return;
		}

		$( '.media-frame-content .attachments-browser' ).each( function() {
			var $browser = $( this );
			$browser.children( '.pgm-mo-frame-sidebar' ).remove();
			$browser.removeClass( 'pgm-mo-frame-has-sidebar' );
			renderFrameSidebar( { $el: $browser } );
		} );
	}

	function patchAttachmentsBrowser() {
		var View;
		var originalRender;

		if ( ! wp || ! wp.media || ! wp.media.view || ! wp.media.view.AttachmentsBrowser ) {
			return;
		}

		View = wp.media.view.AttachmentsBrowser;
		if ( View.prototype.pgmMediaOrganizerPatched ) {
			return;
		}

		originalRender = View.prototype.render;
		View.prototype.render = function() {
			var result = originalRender.apply( this, arguments );
			var browser = this;
			window.setTimeout( function() {
				// Tallennetaan kokoelmaviite suoraan browser-instanssista.
				// browser.collection tai browser.options.library on Backbone
				// Attachments-kokoelma jolla on props.set() ja reset().
				var lib = browser.collection ||
					( browser.options && browser.options.library ) ||
					null;
				if ( lib && lib.props ) {
					activeMediaLibrary = lib;
				}
				if ( browser.$el && browser.$el.length ) {
					browser.$el.data( 'pgmMoBrowserView', browser );
				}
				renderFrameSidebar( browser );
				enhanceAttachmentIcons( browser.$el );
			}, 0 );
			return result;
		};
		View.prototype.pgmMediaOrganizerPatched = true;
	}

	function patchAttachmentDetailsView( View ) {
		var originalRender;

		if ( ! View || ! View.prototype || View.prototype.pgmMediaOrganizerPreviewPatched ) {
			return false;
		}

		originalRender = View.prototype.render;
		if ( ! originalRender ) {
			return false;
		}

		View.prototype.render = function() {
			var result = originalRender.apply( this, arguments );
			var detailView = this;

			window.setTimeout( function() {
				enhanceAttachmentDetailPreview( detailView.$el, detailView.model );
			}, 0 );

			return result;
		};
		View.prototype.pgmMediaOrganizerPreviewPatched = true;
		return true;
	}

	function patchAttachmentDetailsPreview() {
		var patched = false;

		if ( ! wp || ! wp.media || ! wp.media.view || ! wp.media.view.Attachment || ! wp.media.view.Attachment.Details ) {
			return;
		}

		patched = patchAttachmentDetailsView( wp.media.view.Attachment.Details ) || patched;
		if ( wp.media.view.Attachment.Details.TwoColumn ) {
			patched = patchAttachmentDetailsView( wp.media.view.Attachment.Details.TwoColumn ) || patched;
		}

		if ( detailPreviewPatchTimer ) {
			window.clearTimeout( detailPreviewPatchTimer );
		}
		if ( ! wp.media.view.Attachment.Details.TwoColumn ) {
			detailPreviewPatchTimer = window.setTimeout( patchAttachmentDetailsPreview, 250 );
		}

		if ( patched ) {
			enhanceVisibleAttachmentDetailPreviews();
		}
	}

	function patchDisplayDefaults() {
		var View;
		var originalRender;

		if ( ! wp || ! wp.media || ! wp.media.view || ! wp.media.view.Settings || ! wp.media.view.Settings.AttachmentDisplay ) {
			return;
		}

		View = wp.media.view.Settings.AttachmentDisplay;
		if ( View.prototype.pgmMediaOrganizerDisplayPatched ) {
			return;
		}

		originalRender = View.prototype.render;
		View.prototype.render = function() {
			var defaults = state.preferences.displayDefaults || {};
			if ( this.model && ! this.model.get( 'pgmMoDefaultsApplied' ) ) {
				if ( defaults.link ) {
					this.model.set( 'link', defaults.link );
				}
				if ( defaults.size ) {
					this.model.set( 'size', defaults.size );
				}
				if ( defaults.align ) {
					this.model.set( 'align', defaults.align );
				}
				this.model.set( 'pgmMoDefaultsApplied', true );
			}
			return originalRender.apply( this, arguments );
		};
		View.prototype.pgmMediaOrganizerDisplayPatched = true;
	}

	function enableDragging() {
		$( document ).on( 'mouseenter', '.attachments .attachment', function() {
			$( this ).attr( 'draggable', 'false' );
			$( this ).find( 'img, a' ).attr( 'draggable', 'false' );
		} );

		$( document ).on( 'mousedown', '.attachments .attachment[data-id]', startMediaPointerDrag );

		$( document ).on( 'dragstart', '.attachments .attachment, .attachments .attachment img, .attachments .attachment a', function( event ) {
			state.draggedIds = [];
			event.preventDefault(); event.stopPropagation();
			return false;
		} );

		$( document ).on( 'dragover', function( event ) {
			if ( state.mediaPointerDrag && state.mediaPointerDrag.active ) {
				event.preventDefault(); event.stopPropagation();
				event.stopPropagation();
				return false;
			}
		} );

		$( document ).on( 'dragend drop', function() {
			state.draggedIds = [];
			state.mediaPointerDrag = null;
			state.draggedFolderId = 0;
			$( document.body ).removeClass( 'pgm-mo-media-moving' );
			clearMediaDragTarget();
			clearFolderDragClasses();
		} );
	}

	function enableMediaContextMenu() {
		$( document ).on( 'contextmenu', '.attachments .attachment[data-id]', function( event ) {
			var $attachment = $( this );
			var id = parseInt( $attachment.attr( 'data-id' ), 10 ) || 0;
			var selectedIds;
			var ids;

			if ( ! id || state.mediaPointerDrag || state.marqueeSelect ) {
				return;
			}

			event.preventDefault(); event.stopPropagation();
			event.stopPropagation();

			selectedIds = getSelectedAttachmentIds( $attachment );
			if ( $attachment.hasClass( 'selected' ) && selectedIds.indexOf( id ) !== -1 ) {
				ids = selectedIds;
			} else {
				ids = [ id ];
				syncAttachmentSelection( ids, $attachment );
			}

			showMediaContextMenu( $attachment, ids, nearestSidebar( $attachment ), event.clientX, event.clientY );
			return false;
		} );
	}

	function enableMarqueeSelection() {
		$( document ).on( 'mousedown', '.attachments', startMarqueeSelection );
	}

	function initSettingsPage() {
		var $button = $( '#pgm-mo-import-catfolders' );
		if ( ! $button.length ) {
			return;
		}

		$button.on( 'click', function() {
			importCatFolders( $( '#pgm-mo-import-result' ) );
		} );
	}

	function applyBodyClasses() {
		$( document.body )
			.removeClass( 'pgm-mo-grid-small pgm-mo-grid-medium pgm-mo-grid-large' )
			.addClass( 'pgm-mo-enabled' )
			.addClass( 'pecodex-media-library-enabled' )
			.addClass( 'pgm-mo-grid-' + state.preferences.gridSize )
			.toggleClass( 'pgm-mo-infinite-scroll-disabled', ! state.preferences.infiniteScrollGrid );
	}

	function applyColumnVisibility() {
		var enabled = state.preferences.listColumns || [];
		var map = {
			icon: '.column-icon',
			title: '.column-title',
			author: '.column-author',
			parent: '.column-parent',
			comments: '.column-comments',
			pgm_media_folder: '.column-pgm_media_folder',
			pgm_public_visibility: '.column-pgm_public_visibility',
			date: '.column-date',
		};

		$.each( map, function( key, selector ) {
			$( selector ).toggle( enabled.indexOf( key ) !== -1 );
		} );
	}

	function loadStateIfNeeded( context ) {
		var signature = mediaQuerySignatureFromFilters( mediaQueryFilters( context ) );

		if ( state.folders && state.folders.length && signature === state.mediaQuerySignature ) {
			// Kansiodata on jo ladattu â€“ rendataan sivupalkki uudelleen
			renderAllSidebars();
			return;
		}
		loadState( context );
	}

	function onFrameOpen( frame ) {
		// Tallennetaan aktiivinen frame heti â€“ ei viivellÃ¤ â€“
		// jotta currentMediaFrame() lÃ¶ytÃ¤Ã¤ sen vÃ¤littÃ¶mÃ¤sti.
		if ( frame && typeof frame.state === 'function' ) {
			activeMediaFrame = frame;
		}
		// Nollataan edellinen library-viite jotta se pÃ¤ivittyy
		// uuden render()-kutsun kautta.
		activeMediaLibrary = null;
		// PienetÃ¤Ã¤n viivettÃ¤: 150ms jotta AttachmentsBrowser-view
		// ehtii renderÃ¶ityÃ¤ ja wp.media.view.* on saatavilla.
		window.setTimeout( function() {
			applyBodyClasses();
			patchAttachmentsBrowser();
			patchAttachmentDetailsPreview();
			patchDisplayDefaults();
			loadStateIfNeeded( frame );
		}, 150 );
	}

	function hookWpMediaFrames() {
		// Wrappaa wp.media() factory kuuntelemaan uusien frameiden avautumista.
		// TÃ„RKEÃ„Ã„: tÃ¤mÃ¤ ajetaan heti skriptin latautuessa (ei DOM-readyÃ¤),
		// koska Gutenberg saattaa kutsua wp.media() jo ennen DOM-readyÃ¤.
		if ( ! wp || ! wp.media || typeof wp.media !== 'function' ) {
			return;
		}

		// EstÃ¤Ã¤n kaksinkertainen wrappaus
		if ( wp.media.pgmHooked ) {
			return;
		}

		var originalMedia = wp.media;

		wp.media = function() {
			var frame = originalMedia.apply( this, arguments );

			if ( frame && typeof frame.on === 'function' ) {
				frame.on( 'open', function() { onFrameOpen( frame ); } );
				frame.on( 'content:activate', function() { onFrameOpen( frame ); } );
			}

			return frame;
		};

		$.extend( wp.media, originalMedia );
		wp.media.pgmHooked = true;
	}

	function hookWpMediaFrames() {
		// Wrappaa wp.media() factory kuuntelemaan uusien frameiden avautumista.
		// TÃ„RKEÃ„Ã„: tÃ¤mÃ¤ ajetaan heti skriptin latautuessa (ei DOM-readyÃ¤),
		// koska Gutenberg saattaa kutsua wp.media() jo ennen DOM-readyÃ¤.
		if ( ! wp || ! wp.media || typeof wp.media !== 'function' ) {
			return;
		}

		// EstÃ¤Ã¤n kaksinkertainen wrappaus
		if ( wp.media.pgmHooked ) {
			return;
		}

		var originalMedia = wp.media;

		wp.media = function() {
			var frame = originalMedia.apply( this, arguments );

			if ( frame && typeof frame.on === 'function' ) {
				// 'open' = normaali avaus, 'content' = Gutenberg vaihtaa sisÃ¤ltÃ¶Ã¤
				frame.on( 'open', function() { onFrameOpen( frame ); } );
				frame.on( 'content:activate', function() { onFrameOpen( frame ); } );
				// TyhjennetÃ¤Ã¤n aktiivinen viite kun frame suljetaan
				frame.on( 'close', function() {
					if ( activeMediaFrame === frame ) {
						activeMediaFrame = null;
					}
				} );
			}

			return frame;
		};

		// Kopioidaan kaikki wp.media:n ominaisuudet ja metodit wrapperiin
		$.extend( wp.media, originalMedia );
		wp.media.pgmHooked = true;
	}

	// hookWpMediaFrames ajetaan HETI â€“ ennen DOM-readyÃ¤ â€“ jotta wrapper
	// on paikalla kun Gutenberg kutsuu wp.media() ensimmÃ¤istÃ¤ kertaa.
	if ( state.preferences.showFolderTree ) {
		installMediaQueryFilterBridge();
		hookWpMediaFrames();
	}

	$( function() {
		if ( ! state.preferences.showFolderTree ) {
			return;
		}

		applyBodyClasses();
		applyColumnVisibility();
		installMediaQueryFilterBridge();
		patchAttachmentsBrowser();
		patchAttachmentDetailsPreview();
		patchDisplayDefaults();
		enableMarqueeSelection();
		enableMediaContextMenu();
		enableDragging();
		initSettingsPage();
		observeAttachmentIcons();
		loadState();

		$( document ).on( 'pgmMoFolderStateUpdate', function( event, data ) {
			if ( data && data.folders ) {
				state.folders = data.folders;
				if ( data.flatFolders ) {
					state.flatFolders = data.flatFolders;
				}
				if ( data.counts ) {
					state.counts = data.counts;
				}
				renderAllSidebars();
				if ( typeof refreshGridIfPossible === 'function' ) {
					refreshGridIfPossible();
				}
			}
		} );
					var PGMShareModal = wp.media.View.extend({
			tagName: 'div',
			className: 'pgm-mo-modal-overlay',
			events: {
				'click': 'closeOnOverlay',
				'click .pgm-mo-close-btn': 'close',
				'click .pgm-mo-done-btn': 'close',
				'click .pgm-mo-copy-btn': 'copyLink',
				'input .pgm-mo-search-input': 'onSearchInput',
				'click .pgm-mo-search-item': 'onSelectUser',
				'click .pgm-mo-remove-link-btn': 'removeLink',
				'click .pgm-mo-send-invite-btn': 'onSendInvite'
			},

			initialize: function(options) {
				this.attachmentId = options.attachmentId;
				this.shareLinks = options.shareLinks || [];
				this.filename = options.filename || 'Tiedosto';
				this.secureUrl = options.secureUrl || '';
				this.publicUrl = options.publicUrl || '';
				this.isPrivate = options.isPrivate || false;
				this.debounceTimer = null;
				this.selectedEmailToShare = null;
				if (options.model) {
					this.model = options.model;
					this.filename = this.model.get('filename') || this.model.get('title') || this.filename;
				}
			},

			render: function() {
				var self = this;
				this.$el.html('<div class="pgm-mo-modal-content"><div class="pgm-mo-modal-header"><h3>Jaa tiedosto: ' + this.filename + '</h3><button type="button" class="pgm-mo-close-btn">&times;</button></div><div class="pgm-mo-modal-body">Ladataan...</div></div>');
				window.jQuery(document.body).append(this.$el).addClass('modal-open');

				wp.ajax.post('pecodex_get_share_links', {
					id: this.attachmentId,
					_wpnonce: window.pecodexMediaLibraryAdmin ? window.pecodexMediaLibraryAdmin.nonce : config.nonce
				}).done(function(res) {
					if (res && res.links) {
						self.shareLinks = res.links;
						self.renderContent();
					}
				}).fail(function() {
					self.$('.pgm-mo-modal-body').html('<p style="color:red">Virhe haettaessa tietoja.</p>');
				});

				return this;
			},

			renderContent: function() {
				var html = '';
				
				html += '<div style="margin-bottom: 20px;">';
				html += '<h4 style="margin-top:0;">Hae käyttäjä:</h4>';
				html += '<div class="pgm-mo-search-container" style="position:relative;">';
				html += '<input type="text" class="pgm-mo-search-input" placeholder="Kirjoita nimi tai email..." style="width:100%;">';
				html += '<div class="pgm-mo-search-results" style="position:absolute; top:100%; left:0; width:100%; background:#fff; border:1px solid #ccc; max-height:200px; overflow-y:auto; display:none; z-index:10000;"></div>';
				html += '</div>';
				html += '</div>';

				var shareUrl = '';
				if (this.isPrivate) {
					shareUrl = this.secureUrl || (this.model && this.model.get('adminDownloadUrl')) || '';
				}
				if (!shareUrl) shareUrl = this.publicUrl || (this.model && this.model.get('url')) || '';

				html += '<div style="margin-bottom: 20px; display:flex; align-items:center;">';
				html += '<input type="text" readonly class="pgm-mo-share-url-input" value="' + shareUrl + '" style="flex:1; margin-right:10px;">';
				html += '<button type="button" class="button pgm-mo-copy-btn"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2-2v1"></path></svg> Kopioi</button>';
				html += '</div>';

				html += '<div style="margin-bottom: 20px; display:flex; justify-content:flex-end;">';
				html += '<button type="button" class="button button-primary pgm-mo-send-invite-btn" style="background-color: #e6005c; border-color: #e6005c;"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg> Lähetä</button>';
				html += '</div>';

				if (this.shareLinks.length > 0) {
					html += '<div class="pgm-mo-share-list" style="border-top:1px solid #ddd; padding-top:15px;">';
					html += '<h4 style="margin-top:0;">Oikeudet:</h4>';
					for (var i=0; i<this.shareLinks.length; i++) {
						var link = this.shareLinks[i];
						var isUser = !!link.user_id;
						var identifier = isUser ? (link.user_email || link.user_login) : 'Kaikki (Julkinen)';
						var initials = '??';
						if (isUser && link.user_email) {
							initials = link.user_email.substring(0, 2).toUpperCase();
						}

						var expText = '';
						if (link.expires > 0) {
							var d = new Date(link.expires * 1000);
							expText = 'Vanhenee: ' + d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], {hour: "2-digit", minute:"2-digit"});
						}
						if (link.single_use == '1') {
							if (expText) expText += ' - ';
							expText += 'Kertakäyttöinen' + (link.used == '1' ? ' (Käytetty)' : '');
						}

						html += '<div class="pgm-mo-share-item" style="display:flex; align-items:center; padding:10px 0; border-bottom:1px solid #eee;">';
						html += '<div style="width:32px; height:32px; border-radius:50%; background:#e0e0e0; display:flex; align-items:center; justify-content:center; margin-right:10px; font-weight:bold; color:#555;">' + initials + '</div>';
						html += '<div style="flex:1;">';
						html += '<div style="font-weight:bold;">' + identifier + '</div>';
						if (expText) html += '<div style="font-size:12px; color:#777;">' + expText + '</div>';
						html += '</div>';
						html += '<div>';
						html += '<button type="button" class="button pgm-mo-remove-link-btn" data-token="' + link.token + '" style="color:#d63638; border-color:#d63638; background:transparent;">Poista</button>';
						html += '</div>';
						html += '</div>';
					}
					html += '</div>';
				}

				html += '<div style="margin-top:20px; text-align:right;">';
				html += '<button type="button" class="button pgm-mo-done-btn">Valmis</button>';
				html += '</div>';

				this.$('.pgm-mo-modal-body').html(html);
			},

			closeOnOverlay: function(e) {
				if (window.jQuery(e.target).hasClass('pgm-mo-modal-overlay')) {
					this.close();
				}
			},

			removeLink: function(e) {
				var btn = window.jQuery(e.currentTarget);
				var token = btn.data('token');
				var self = this;
				btn.prop('disabled', true).text('...');
				
				var n = window.pecodexMediaLibraryAdmin ? window.pecodexMediaLibraryAdmin.nonce : config.nonce;
				wp.ajax.post('pecodex_revoke_share_link', {
					id: this.attachmentId,
					token: token,
					_wpnonce: n,
					pgm_toggle_attachment_privacy: n
				}).done(function(res) {
					if (res && res.success) {
						self.shareLinks = self.shareLinks.filter(function(l) { return l.token !== token; });
						self.renderContent();
						if (typeof refreshGridIfPossible === 'function') {
							refreshGridIfPossible();
						}
						self.showToast('Käyttöoikeus poistettu.');
					}
				}).fail(function() {
					btn.prop('disabled', false).text('Poista');
				});
			},

			onSearchInput: function(e) {
				var val = window.jQuery(e.currentTarget).val().trim();
				var dropdown = this.$('.pgm-mo-search-results');
				
				this.selectedEmailToShare = val; 

				if (val.length < 2) {
					dropdown.removeClass('active').empty();
					return;
				}

				if (this.debounceTimer) clearTimeout(this.debounceTimer);
				
				var self = this;
				this.debounceTimer = setTimeout(function() {
					wp.ajax.post('pecodex_search_users', {
						term: val,
						_wpnonce: window.pecodexMediaLibraryAdmin ? window.pecodexMediaLibraryAdmin.nonce : config.nonce
					}).done(function(res) {
						var itemsHtml = '';
						if (res && res.users && res.users.length > 0) {
							for (var i=0; i<res.users.length; i++) {
								var u = res.users[i];
								itemsHtml += '<div class="pgm-mo-search-item" data-email="'+u.email+'" style="padding:10px; cursor:pointer; border-bottom:1px solid #eee;">' + u.name + ' (' + u.email + ')</div>';
							}
						}
						if (itemsHtml) {
							dropdown.html(itemsHtml).show();
						} else {
							dropdown.hide().empty();
						}
					});
				}, 300);
			},

			onSelectUser: function(e) {
				var item = window.jQuery(e.currentTarget);
				var email = item.data('email');
				this.$('.pgm-mo-search-input').val(email);
				this.selectedEmailToShare = email;
				this.$('.pgm-mo-search-results').hide().empty();
			},

			onSendInvite: function(e) {
				var email = this.selectedEmailToShare || this.$('.pgm-mo-search-input').val().trim();
				if (!email) {
					this.showToast('Syötä sähköposti ensin.');
					return;
				}

				var btn = window.jQuery(e.currentTarget);
				var input = this.$('.pgm-mo-search-input');
				var self = this;
				
				btn.prop('disabled', true).text('Lähetetään...');
				input.prop('disabled', true);

				var n = window.pecodexMediaLibraryAdmin ? window.pecodexMediaLibraryAdmin.nonce : config.nonce;
				wp.ajax.post('pecodex_create_share_link', {
					id: this.attachmentId,
					user_email: email,
					_wpnonce: n,
					pgm_toggle_attachment_privacy: n
				}).done(function(res) {
					if (res && res.success && res.link) {
						self.shareLinks.push(res.link);
						self.selectedEmailToShare = null;
						self.renderContent();
						if (typeof refreshGridIfPossible === 'function') {
							refreshGridIfPossible();
						}
					}
					self.showToast('Käyttäjä lisätty ja kutsu lähetetty!');
				}).fail(function() {
					input.prop('disabled', false).focus();
					btn.prop('disabled', false).html('<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg> Lähetä');
				});
			},

			copyLink: function() {
				var url = this.$('.pgm-mo-share-url-input').val();
				
				var self = this;
				if (navigator.clipboard) {
					navigator.clipboard.writeText(url).then(function() { self.showToast('Linkki kopioitu leikepöydälle!'); });
				} else {
					var textArea = document.createElement("textarea");
					textArea.value = url;
					document.body.appendChild(textArea);
					textArea.select();
					try {
						document.execCommand('copy');
						self.showToast('Linkki kopioitu leikepöydälle!');
					} catch (err) {}
					document.body.removeChild(textArea);
				}
			},

			showToast: function(msg) {
				var t = window.jQuery('<div style="position:fixed; bottom:20px; right:20px; background:#333; color:#fff; padding:10px 20px; border-radius:4px; z-index:999999; opacity:0; transition:opacity 0.3s;">'+msg+'</div>');
				window.jQuery(document.body).append(t);
				setTimeout(function(){ t.css('opacity','1'); }, 10);
				setTimeout(function(){ t.css('opacity','0'); setTimeout(function(){ t.remove(); }, 300); }, 3000);
			},

			close: function() {
				window.jQuery(document.body).removeClass('modal-open');
				this.remove();
			}
		});

				var PGMShareModal = wp.media.View.extend({
