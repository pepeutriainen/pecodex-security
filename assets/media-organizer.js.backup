						.on( 'click', function() {
							renderSettingsMain( $body );
						} ),
					$( '<h3 />', { text: t( 'aboutPecodex', 'Tietoja ja tuki' ) } ),
					$( '<p />', { 'class': 'description', text: t( 'aboutPecodexHelp', 'Tama lisaosa on Pecodexin mediatiedostojen hallinta- ja suojaustyokalu WordPressiin.' ) } )
				),
