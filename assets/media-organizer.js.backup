						.on( 'click', function() {
							renderSettingsMain( $body );
						} ),
					$( '<h3 />', { text: t( 'displayDefaults', 'LisÃ¤yksen nÃ¤yttÃ¶oletukset' ) } ),
					$( '<p />', { 'class': 'description', text: t( 'displayDefaultsHelp', 'NÃ¤mÃ¤ asetukset esitÃ¤yttÃ¤vÃ¤t WordPressin mediavalitsimen, kun media lisÃ¤tÃ¤Ã¤n sisÃ¤ltÃ¶Ã¶n.' ) } )
				),
			settingSelect( t( 'displayLink', 'Linkki' ), displayLinkChoices(), defaults.link, function( value ) {
				state.preferences.displayDefaults.link = value || 'none';
			} ),
			settingSelect( t( 'displaySize', 'Koko' ), imageSizeChoices(), defaults.size, function( value ) {
				state.preferences.displayDefaults.size = value || 'medium';
			} ),
			settingSelect( t( 'displayAlign', 'Tasaus' ), displayAlignChoices(), defaults.align, function( value ) {
				state.preferences.displayDefaults.align = value || 'none';
			} ),
			$saveButton,
