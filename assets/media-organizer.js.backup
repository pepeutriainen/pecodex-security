				}
				return;
			}

			event.preventDefault(); event.stopPropagation();
			$item.addClass( 'is-drop-target' );
		} );
		$button.on( 'dragleave', function() {
			$item.removeClass( 'is-drop-target is-folder-drop-before is-folder-drop-after is-folder-drop-inside' );
		} );
		$button.on( 'drop', function( event ) {
			var draggedFolder;
			var position;

			event.preventDefault(); event.stopPropagation();
			$item.removeClass( 'is-drop-target' );

			if ( state.draggedFolderId ) {
				draggedFolder = folderById( state.draggedFolderId );
				position = folderDropPosition( event, $row[0] );
				if ( canReorderFolder( draggedFolder, folder, position ) ) {
					reorderFolder( state.draggedFolderId, idNumber, position, $sidebar );
				} else {
					state.draggedFolderId = 0;
					clearFolderDragClasses();
				}
				return;
			}

			assignSelectedToFolder( idNumber, $sidebar );
		} );

		$row.append( $toggle, $button );
		$item.append( $row );
		$list.append( $item );

		if ( hasChildren && isExpanded ) {
			children.forEach( function( child ) {
				renderFolderNode( child, $list, depth + 1, $sidebar );
			} );
		}
	}

	function closeContextMenu() {
		$( '.pgm-mo-context-menu' ).each( function() {
			var $item = $( this ).data( 'pgmMoFolderItem' );
			var $attachment = $( this ).data( 'pgmMoAttachmentItem' );
			if ( $item && $item.length ) {
				$item.removeClass( 'is-context-open' );
			}
			if ( $attachment && $attachment.length ) {
				$attachment.removeClass( 'is-context-open' );
			}
		} ).remove();
		$( document ).off( '.pgmMoContext' );
		$( window ).off( '.pgmMoContext' );
	}

	function positionContextMenu( $menu, x, y ) {
		var menuWidth;
		var menuHeight;
		var left;
		var top;

		$( document.body ).append( $menu.css( { left: 0, top: 0, visibility: 'hidden' } ) );
		menuWidth = $menu.outerWidth();
		menuHeight = $menu.outerHeight();
		left = Math.max( 8, Math.min( Math.max( 8, x ), window.innerWidth - menuWidth - 8 ) );
		top = Math.max( 8, Math.min( Math.max( 8, y ), window.innerHeight - menuHeight - 8 ) );

		$menu.css( {
			left: left + 'px',
			top: top + 'px',
			visibility: 'visible',
		} );

		window.setTimeout( function() {
			$menu.find( '.pgm-mo-context-action' ).first().trigger( 'focus' );
			$( document ).on( 'mousedown.pgmMoContext contextmenu.pgmMoContext', function( event ) {
				if ( ! $( event.target ).closest( '.pgm-mo-context-menu' ).length ) {
					closeContextMenu();
				}
			} );
			$( document ).on( 'keydown.pgmMoContext', function( event ) {
				handleContextMenuKeydown( event );
			} );
			$( window ).on( 'resize.pgmMoContext scroll.pgmMoContext', closeContextMenu );
		}, 0 );
	}

	function focusContextMenuAction( $menu, index ) {
		var $actions = $menu.find( '.pgm-mo-context-action' );
		var count = $actions.length;

		if ( ! count ) {
			return;
		}

		index = ( ( index % count ) + count ) % count;
		$actions.eq( index ).trigger( 'focus' );
	}

	function handleContextMenuKeydown( event ) {
		var key = event.key;
		var $target = $( event.target );
		var $menu = $target.closest( '.pgm-mo-context-menu' );
		var $actions;
		var currentIndex;

		if ( ! $menu.length ) {
			$menu = $( '.pgm-mo-context-menu' ).first();
		}

		if ( ! $menu.length ) {
			return;
		}

		if ( 'Escape' === key ) {
			event.preventDefault(); event.stopPropagation();
			closeContextMenu();
			return;
		}

		$actions = $menu.find( '.pgm-mo-context-action' );
		currentIndex = $actions.index( document.activeElement );

		if ( -1 === currentIndex ) {
			currentIndex = 0;
		}

		if ( 'ArrowDown' === key ) {
			event.preventDefault(); event.stopPropagation();
			focusContextMenuAction( $menu, currentIndex + 1 );
		} else if ( 'ArrowUp' === key ) {
			event.preventDefault(); event.stopPropagation();
			focusContextMenuAction( $menu, currentIndex - 1 );
		} else if ( 'Home' === key ) {
			event.preventDefault(); event.stopPropagation();
			focusContextMenuAction( $menu, 0 );
		} else if ( 'End' === key ) {
			event.preventDefault(); event.stopPropagation();
			focusContextMenuAction( $menu, $actions.length - 1 );
		} else if ( 'Enter' === key || ' ' === key ) {
			event.preventDefault(); event.stopPropagation();
			if ( $target.hasClass( 'pgm-mo-context-action' ) ) {
				$target.trigger( 'click' );
			} else {
				$actions.eq( currentIndex ).trigger( 'focus' ).trigger( 'click' );
			}
		}
	}

	function appendContextAction( $menu, action ) {
		if ( action.separator ) {
			$( '<div />', { 'class': 'pgm-mo-context-separator', role: 'separator' } ).appendTo( $menu );
			return;
		}

		var $action = $( '<button />', {
			type: 'button',
			role: 'menuitem',
			'class': 'pgm-mo-context-action is-' + action.key + ( action.danger ? ' is-danger' : '' ),
		} )
			.append(
				icon( action.icon ),
				$( '<span />', { 'class': 'pgm-mo-context-label', text: action.label } )
			)
			.on( 'click', function( event ) {
				event.preventDefault(); event.stopPropagation();
				closeContextMenu();
				action.run();
			} );

		if ( action.badge ) {
			$action.append( $( '<span />', { 'class': 'pgm-mo-context-badge', text: action.badge } ) );
		}

		$action.appendTo( $menu );
	}

	function compactContextActions( actions ) {
		var compacted = [];

		( actions || [] ).forEach( function( action ) {
			if ( action.separator ) {
				if ( ! compacted.length || compacted[ compacted.length - 1 ].separator ) {
					return;
				}
			}
			compacted.push( action );
		} );

		while ( compacted.length && compacted[ compacted.length - 1 ].separator ) {
			compacted.pop();
		}

		return compacted;
	}

	function showFolderProtectionModal( folder, $sidebar, initialAccess ) {
		var id = folder ? parseInt( folder.id, 10 ) || 0 : 0;
		var parentId = folder ? parseInt( folder.parent || 0, 10 ) || 0 : 0;
		var parentFolder = parentId > 0 ? folderById( parentId ) : null;
		var inheritedAccess = parentFolder ? folderEffectiveAccess( parentFolder ) : 'public';
		var selectedAccess = initialAccess || ( folder && folder.access ? folder.access : 'public' );
		var $overlay;
		var $dialog;
		var $body;
		var $options;
		var $summary;
		var $message;

		if ( ! id || ! folder || folder.special ) {
			return;
		}

		function close() {
			$( document ).off( '.pgmMoFolderProtection' );
			$overlay.remove();
		}

		function protectionHelp( access ) {
			if ( 'admin_only' === access ) {
				return t( 'folderProtectionAdminHelp', 'Nykyiset tiedostot, alikansioiden tiedostot ja myÃ¶hemmin tÃ¤hÃ¤n siirretyt tiedostot avataan vain yllÃ¤pitÃ¤jille.' );
			}
			if ( 'logged_in' === access ) {
				return t( 'folderProtectionLoggedInHelp', 'Nykyiset tiedostot, alikansioiden tiedostot ja myÃ¶hemmin tÃ¤hÃ¤n siirretyt tiedostot avataan vain kirjautuneille kÃ¤yttÃ¤jille.' );
			}

			return inheritedAccess === 'public'
				? t( 'folderProtectionPublicModalHelp', 'TÃ¤mÃ¤n kansion oma suojaus poistetaan. Tiedostot voivat silti olla suojattuja yksittÃ¤isen lukon kautta.' )
				: t( 'folderProtectionInheritedHelp', 'YlÃ¤kansion suojaus pysyy voimassa, vaikka tÃ¤mÃ¤n kansion oma suojaus olisi julkinen.' );
		}

		function optionCard( access, title, checked ) {
			var inputId = 'pgm-mo-folder-protection-' + access + '-' + id;

			return $( '<label />', { 'class': 'pgm-mo-folder-protection-option' + ( checked ? ' is-selected' : '' ), 'for': inputId } )
				.append(
					$( '<input />', {
						id: inputId,
						type: 'radio',
						name: 'pgm-mo-folder-protection-access',
						value: access,
					} ).prop( 'checked', !! checked ),
					$( '<span />', { 'class': 'pgm-mo-folder-protection-option-copy' } )
						.append( $( '<strong />', { text: title } ) )
						.append( $( '<span />', { text: protectionHelp( access ) } ) )
				);
		}

		function currentAccess() {
			return $options.find( 'input[name="pgm-mo-folder-protection-access"]:checked' ).val() || 'public';
		}

		function updateSummary() {
			var localAccess = currentAccess();
			var effectiveAccess = strongestAccess( localAccess, inheritedAccess );
			var inheritedLabel = inheritedAccess === 'public'
				? t( 'noInheritedProtection', 'Ei perittyÃ¤ suojausta' )
				: folderAccessLabel( inheritedAccess, false );
			var helperText = effectiveAccess === 'public'
				? t( 'folderProtectionEffectivePublicHelp', 'Kansion tiedostot ovat julkisia, ellei yksittÃ¤inen tiedosto suojaa niitÃ¤.' )
				: t( 'folderProtectionActiveHelp', 'TÃ¤mÃ¤n kansion nykyiset tiedostot, alikansioiden tiedostot ja tÃ¤hÃ¤n myÃ¶hemmin siirretyt tiedostot suojataan automaattisesti.' );

			$summary
				.attr( 'class', 'pgm-mo-property-protection is-' + effectiveAccess )
				.empty()
				.append(
					$( '<div />' )
						.append( $( '<span />', { text: t( 'currentFolderProtection', 'Kansion oma suojaus' ) } ) )
						.append( $( '<strong />', { text: folderAccessLabel( localAccess, false ) } ) ),
					$( '<div />' )
						.append( $( '<span />', { text: t( 'inheritedFolderProtection', 'YlÃ¤kansion suojaus' ) } ) )
						.append( $( '<strong />', { text: inheritedLabel } ) ),
					$( '<div />' )
						.append( $( '<span />', { text: t( 'effectiveFolderProtection', 'Voimassa oleva suojaus' ) } ) )
						.append( $( '<strong />', { text: folderAccessLabel( effectiveAccess, false ) } ) ),
					$( '<p />', { text: helperText } )
				);
		}

		$overlay = $( '<div />', { 'class': 'pgm-mo-modal-overlay' } );
		$dialog = $( '<div />', { 'class': 'pgm-mo-modal pgm-mo-folder-protection-modal', role: 'dialog', 'aria-modal': 'true', 'aria-labelledby': 'pgm-mo-folder-protection-title' } );
		$body = $( '<div />', { 'class': 'pgm-mo-modal-body pgm-mo-folder-protection' } );
		$options = $( '<div />', { 'class': 'pgm-mo-folder-protection-options', role: 'radiogroup', 'aria-label': t( 'folderProtectionScope', 'Suojaustaso' ) } );
		$summary = $( '<div />' );
		$message = $( '<p />', { 'class': 'pgm-mo-modal-message', role: 'status' } );

		$options.append(
			optionCard( 'public', t( 'folderProtectionPublicTitle', 'Julkinen kansio' ), selectedAccess === 'public' ),
			optionCard( 'logged_in', t( 'folderProtectionLoggedInTitle', 'Vain kirjautuneet' ), selectedAccess === 'logged_in' ),
			optionCard( 'admin_only', t( 'folderProtectionAdminTitle', 'Vain yllÃ¤pitÃ¤jÃ¤t' ), selectedAccess === 'admin_only' )
		);
		$options.on( 'change', 'input', function() {
			$options.find( '.pgm-mo-folder-protection-option' ).removeClass( 'is-selected' );
			$( this ).closest( '.pgm-mo-folder-protection-option' ).addClass( 'is-selected' );
			updateSummary();
		} );

		$dialog.append(
			$( '<div />', { 'class': 'pgm-mo-modal-header' } )
				.append( $( '<h2 />', { id: 'pgm-mo-folder-protection-title', text: t( 'folderProtectionTitle', 'Kansion suojaus' ) } ) )
				.append( $( '<button />', { type: 'button', 'class': 'pgm-mo-modal-close', text: 'Ã—', title: t( 'close', 'Sulje' ) } ).on( 'click', close ) ),
			$body
		);

		$body.append(
			$( '<div />', { 'class': 'pgm-mo-folder-protection-summary' } )
				.append( icon( 'lock' ) )
				.append(
					$( '<div />' )
						.append( $( '<strong />', { text: folder.name || t( 'folderName', 'Kansion nimi' ) } ) )
						.append( $( '<span />', { text: t( 'folderProtectionBody', 'Valitse miten tÃ¤mÃ¤n kansion nykyiset ja myÃ¶hemmin tÃ¤hÃ¤n siirrettÃ¤vÃ¤t tiedostot suojataan.' ) } ) )
				),
			$options,
			$summary,
			$( '<div />', { 'class': 'pgm-mo-property-actions' } )
				.append(
					$( '<button />', { type: 'button', 'class': 'button', text: t( 'cancel', 'Peruuta' ) } ).on( 'click', close ),
					$( '<button />', { type: 'button', 'class': 'button button-primary' } )
						.append( icon( 'lock' ), $( '<span />', { text: t( 'saveFolderProtection', 'Tallenna suojaus' ) } ) )
						.on( 'click', function() {
							setFolderAccess( folder, currentAccess(), $sidebar, {
								$message: $message,
								onDone: close,
							} );
						} )
				),
			$message
		);

		$overlay.on( 'mousedown', function( event ) {
			if ( event.target === $overlay[0] ) {
				close();
			}
		} );
		$( document ).on( 'keydown.pgmMoFolderProtection', function( event ) {
			if ( event.key === 'Escape' ) {
				close();
			}
		} );

		$overlay.append( $dialog );
		$( document.body ).append( $overlay );
		updateSummary();
		$dialog.find( 'input[name="pgm-mo-folder-protection-access"]:checked' ).trigger( 'focus' );
	}

	function setFolderAccess( folder, access, $sidebar, options ) {
		var $message;

		if ( ! folder || folder.special || parseInt( folder.id, 10 ) <= 0 ) {
			return;
		}

		options = options || {};
		$message = options.$message || null;

		function writeMessage( message, isError ) {
			if ( $message && $message.length ) {
				$message.toggleClass( 'is-error', !! isError ).text( message );
			}
			setMessage( $sidebar, message, !! isError );
		}

		writeMessage( t( 'saving', 'Saving...' ) );
			ajax( 'pecodex_mo_update_folder', {
			folder_id: folder.id,
			name: folder.name || '',
			parent: parseInt( folder.parent || 0, 10 ) || 0,
			access: access || 'public',
		} )
			.done( function( response ) {
				if ( ! response || ! response.success ) {
					writeMessage( response && response.data && response.data.message ? response.data.message : t( 'error', 'Action failed.' ), true );
					return;
				}

				state.folders = response.data.folders || [];
				state.flatFolders = response.data.flatFolders || []; if (response.data && response.data.counts) { state.counts = response.data.counts; }
				renderAllSidebars();
				refreshGridIfPossible( $sidebar );
				writeMessage( response.data.message || t( 'folderProtectionSaved', 'Kansion suojaus tallennettiin.' ) );
				if ( options.onDone ) {
					options.onDone( response );
				}
			} )
			.fail( function( xhr ) {
				var message = xhr.responseJSON && xhr.responseJSON.data && xhr.responseJSON.data.message ? xhr.responseJSON.data.message : t( 'error', 'Action failed.' );
				writeMessage( message, true );
			} );
	}

	function showMediaContextMenu( $attachment, ids, $sidebar, x, y ) {
		var firstId = ids[0];
		var title = ids.length > 1 ? ids.length + ' ' + t( 'selectedFiles', 'valittua' ) : attachmentLabel( firstId, $attachment );
		var $menu = $( '<div />', { 'class': 'pgm-mo-context-menu is-media-menu', role: 'menu', 'aria-orientation': 'vertical', 'aria-label': t( 'mediaActions', 'Mediatiedoston toiminnot' ) } );
		var canRemoveFromFolder = parseInt( state.selectedFolder, 10 ) > 0;
		var actions = [
			{ key: 'open-file', label: t( 'openFile', 'Avaa tiedosto' ), icon: 'external-link', badge: ids.length > 1 ? '1' : '', run: function() { openAttachmentFile( firstId ); } },
			{ key: 'details', label: t( 'openDetails', 'Avaa tiedot' ), icon: 'info-outline', badge: ids.length > 1 ? '1' : '', run: function() { openAttachmentDetails( firstId, $sidebar ); } },
			{ key: 'move-folder', label: t( 'moveToFolder', 'SiirrÃ¤ kansioon' ), icon: 'folder', run: function() { showMoveMediaModal( ids, $sidebar ); } },
			{ key: 'duplicate-media', label: t( 'duplicate', 'Monista' ), icon: 'files', run: function() { showDuplicateMediaModal( ids, $sidebar ); } },
			{ key: 'export-media', label: t( 'exportSelected', 'Vie valitut ZIPiksi' ), icon: 'download', badge: 'ZIP', run: function() { showExportZipModal( ids, $sidebar ); } },
			{ separator: true },
			{ key: 'protect', label: t( 'protectSelected', 'Suojaa' ), icon: 'lock', run: function() { showBulkPrivacyModal( 'hide', $sidebar, ids ); } },
			{ key: 'unprotect', label: t( 'unprotectSelected', 'Poista suojaus' ), icon: 'unlock', run: function() { showBulkPrivacyModal( 'make_public', $sidebar, ids ); } },
			{ separator: true },
			{ key: 'delete-media', label: t( 'deletePermanently', 'Poista pysyvÃ¤sti' ), icon: 'trash', danger: true, run: function() { showDeleteMediaModal( ids, $sidebar ); } },
		];

		if ( canRemoveFromFolder ) {
			actions.splice( 3, 0, {
				key: 'remove-folder',
				label: t( 'removeFromFolder', 'Poista kansiosta' ),
				icon: 'folder-x',
				run: function() {
					showRemoveFromFolderModal( ids, $sidebar );
				},
			} );
		}
		actions = compactContextActions( actions );

		closeContextMenu();
		$attachment.addClass( 'is-context-open' );
		$menu.data( 'pgmMoAttachmentItem', $attachment );
		$menu.append( $( '<div />', { 'class': 'pgm-mo-context-title', text: title } ) );
		actions.forEach( function( action ) {
			appendContextAction( $menu, action );
		} );
		positionContextMenu( $menu, x, y );
	}

	function showContextMenu( folder, $sidebar, x, y, $item ) {
		var $menu = $( '<div />', { 'class': 'pgm-mo-context-menu', role: 'menu', 'aria-orientation': 'vertical', 'aria-label': folder.name || 'Folder actions' } );
		var localAccess = folder && folder.access ? folder.access : 'public';
		var actions = [
			{ key: 'child', label: t( 'newFolder', 'Uusi kansio' ), icon: 'folder-plus', run: function() { createFolder( folder.id, $sidebar ); } },
			{ key: 'rename', label: t( 'rename', 'NimeÃ¤ uudelleen' ), icon: 'edit', run: function() { renameFolder( folder, $sidebar ); } },
			{ key: 'properties', label: t( 'properties', 'Ominaisuudet' ), icon: 'info-outline', run: function() { showProperties( folder, $sidebar ); } },
			{ separator: true },
			{ key: 'protect-folder', label: t( 'protectFolderLoggedIn', 'Suojaa kansio kirjautuneille' ), icon: 'lock', run: function() { showFolderProtectionModal( folder, $sidebar, 'logged_in' ); } },
			{ key: 'admin-folder', label: t( 'protectFolderAdmin', 'Suojaa kansio yllÃ¤pitÃ¤jille' ), icon: 'lock', run: function() { showFolderProtectionModal( folder, $sidebar, 'admin_only' ); } },
			{ key: 'public-folder', label: t( 'clearFolderProtection', 'Poista kansion oma suojaus' ), icon: 'unlock', run: function() { showFolderProtectionModal( folder, $sidebar, 'public' ); } },
			{ separator: true },
			{ key: 'download', label: t( 'download', 'Lataa ZIP' ), icon: 'download', badge: 'ZIP', run: function() { showExportFolderZipModal( folder, $sidebar ); } },
			{ separator: true },
			{ key: 'delete', label: t( 'delete', 'Poista' ), icon: 'trash', danger: true, run: function() { deleteFolder( folder, $sidebar ); } },
		];

		actions = compactContextActions( actions.filter( function( action ) {
			if ( 'protect-folder' === action.key ) {
				return 'logged_in' !== localAccess;
			}
			if ( 'admin-folder' === action.key ) {
				return 'admin_only' !== localAccess;
			}
			if ( 'public-folder' === action.key ) {
				return 'public' !== localAccess;
			}
			return true;
		} ) );

		closeContextMenu();
		if ( $item && $item.length ) {
			$item.addClass( 'is-context-open' );
			$menu.data( 'pgmMoFolderItem', $item );
		}

		actions.forEach( function( action ) {
			appendContextAction( $menu, action );
		} );

		positionContextMenu( $menu, x, y );
	}

	function gallerySizeChoices() {
		return {
			thumbnail: t( 'galleryImageSizeThumbnail', 'Pienoiskuva' ),
			medium: t( 'galleryImageSizeMedium', 'Keskikokoinen' ),
			large: t( 'galleryImageSizeLarge', 'Suuri' ),
			full: t( 'galleryImageSizeFull', 'TÃ¤ysikokoinen' ),
		};
	}

	function galleryLinkChoices() {
		return {
			file: t( 'galleryLinkFile', 'Mediatiedosto' ),
			none: t( 'galleryLinkNone', 'Ei linkkiÃ¤' ),
			post: t( 'galleryLinkPost', 'Liitesivu' ),
		};
	}

	function parseShortcodeOptions( shortcode ) {
		var options = {};
		var pattern = /(\w+)="([^"]*)"/g;
		var match;

		while ( ( match = pattern.exec( String( shortcode || '' ) ) ) ) {
			options[ match[1] ] = match[2];
		}

		return options;
	}

	function buildGalleryShortcode( folderId, options ) {
		var sizes = gallerySizeChoices();
		var links = galleryLinkChoices();
		var size;
		var link;
		var columns;
		var limit;

		options = options || {};
		size = sizes[ options.size ] ? options.size : 'medium';
		link = links[ options.link ] ? options.link : 'file';
		columns = Math.min( 8, Math.max( 1, parseInt( options.columns, 10 ) || 3 ) );
		limit = Math.min( 500, Math.max( 1, parseInt( options.limit, 10 ) || 100 ) );

		return '[pecodex_media_gallery folder="' + parseInt( folderId, 10 ) + '" size="' + size + '" columns="' + columns + '" link="' + link + '" limit="' + limit + '"]';
	}

	function appendOptionChoices( $select, choices, selected ) {
		$.each( choices, function( value, label ) {
			$( '<option />', { value: value, text: label } ).prop( 'selected', String( value ) === String( selected ) ).appendTo( $select );
		} );
	}

	function showGalleryShortcodeBuilder( folder, currentShortcode, onApply ) {
		var folderId = folder ? parseInt( folder.id, 10 ) || 0 : 0;
		var initial = parseShortcodeOptions( currentShortcode );
		var $overlay;
		var $dialog;
		var $body;
		var $size;
		var $link;
		var $columns;
		var $limit;
		var $preview;
		var $message;

		if ( ! folderId ) {
			return;
		}

		function currentOptions() {
			return {
				size: $size.val() || 'medium',
				link: $link.val() || 'file',
				columns: $columns.val() || 3,
				limit: $limit.val() || 100,
			};
		}

		function currentShortcodeValue() {
			return buildGalleryShortcode( folderId, currentOptions() );
		}

		function updatePreview() {
			$preview.val( currentShortcodeValue() );
		}

		function close() {
			$( document ).off( '.pgmMoGalleryShortcode' );
			$overlay.remove();
		}

		$overlay = $( '<div />', { 'class': 'pgm-mo-modal-overlay' } );
		$dialog = $( '<div />', { 'class': 'pgm-mo-modal pgm-mo-gallery-shortcode-modal', role: 'dialog', 'aria-modal': 'true', 'aria-labelledby': 'pgm-mo-gallery-shortcode-title' } );
		$body = $( '<div />', { 'class': 'pgm-mo-modal-body pgm-mo-gallery-shortcode-builder' } );
		$size = $( '<select />', { 'class': 'pgm-mo-property-input' } );
		$link = $( '<select />', { 'class': 'pgm-mo-property-input' } );
		$columns = $( '<input />', { type: 'number', min: 1, max: 8, step: 1, 'class': 'pgm-mo-property-input', value: initial.columns || 3 } );
		$limit = $( '<input />', { type: 'number', min: 1, max: 500, step: 1, 'class': 'pgm-mo-property-input', value: initial.limit || 100 } );
		$preview = $( '<input />', { type: 'text', readonly: 'readonly', 'class': 'pgm-mo-property-input pgm-mo-shortcode-input' } );
		$message = $( '<p />', { 'class': 'pgm-mo-modal-message', role: 'status' } );

		appendOptionChoices( $size, gallerySizeChoices(), initial.size || 'medium' );
		appendOptionChoices( $link, galleryLinkChoices(), initial.link || 'file' );
		$size.add( $link ).add( $columns ).add( $limit ).on( 'change input', updatePreview );

		$dialog.append(
			$( '<div />', { 'class': 'pgm-mo-modal-header' } )
				.append( $( '<h2 />', { id: 'pgm-mo-gallery-shortcode-title', text: t( 'galleryShortcodeTitle', 'Galleria-shortcoden asetukset' ) } ) )
				.append( $( '<button />', { type: 'button', 'class': 'pgm-mo-modal-close', text: 'Ã—', title: t( 'close', 'Sulje' ) } ).on( 'click', close ) ),
			$body
		);

		$body.append(
			$( '<p />', { 'class': 'description', text: t( 'galleryShortcodeHelp', 'SÃ¤Ã¤dÃ¤ shortcodea ennen kopiointia. TÃ¤mÃ¤ ei muuta kansion tiedostoja tai asetuksia.' ) } ),
			$( '<div />', { 'class': 'pgm-mo-shortcode-builder-grid' } )
				.append(
					$( '<label />', { 'class': 'pgm-mo-property-row' } ).append( $( '<span />', { text: t( 'galleryImageSize', 'Kuvakoko' ) } ), $size ),
					$( '<label />', { 'class': 'pgm-mo-property-row' } ).append( $( '<span />', { text: t( 'galleryColumns', 'Sarakkeet' ) } ), $columns ),
					$( '<label />', { 'class': 'pgm-mo-property-row' } ).append( $( '<span />', { text: t( 'galleryLink', 'Linkki' ) } ), $link ),
					$( '<label />', { 'class': 'pgm-mo-property-row' } ).append( $( '<span />', { text: t( 'galleryLimit', 'MÃ¤Ã¤rÃ¤' ) } ), $limit )
				),
			$( '<label />', { 'class': 'pgm-mo-property-row' } )
				.append( $( '<span />', { text: t( 'galleryShortcodePreview', 'Shortcode' ) } ), $preview ),
			$( '<div />', { 'class': 'pgm-mo-property-actions' } )
				.append(
					$( '<button />', { type: 'button', 'class': 'button', text: t( 'cancel', 'Peruuta' ) } ).on( 'click', close ),
					$( '<button />', { type: 'button', 'class': 'button' } )
						.append( icon( 'copy' ), $( '<span />', { text: t( 'copyShortcode', 'Kopioi' ) } ) )
						.on( 'click', function() {
							copyTextToClipboard( currentShortcodeValue() )
								.done( function() {
									$message.removeClass( 'is-error' ).text( t( 'shortcodeCopied', 'Shortcode kopioitu.' ) );
								} )
								.fail( function() {
									$message.addClass( 'is-error' ).text( t( 'shortcodeCopyFailed', 'Shortcodea ei voitu kopioida.' ) );
								} );
						} ),
					$( '<button />', { type: 'button', 'class': 'button button-primary', text: t( 'useShortcode', 'KÃ¤ytÃ¤ shortcodea' ) } ).on( 'click', function() {
						if ( onApply ) {
							onApply( currentShortcodeValue() );
						}
						close();
					} )
				),
			$message
		);

		updatePreview();
		$overlay.on( 'mousedown', function( event ) {
			if ( event.target === $overlay[0] ) {
				close();
			}
		} );
		$( document ).on( 'keydown.pgmMoGalleryShortcode', function( event ) {
			if ( event.key === 'Escape' ) {
				close();
			}
		} );

		$overlay.append( $dialog );
		$( document.body ).append( $overlay );
		$size.trigger( 'focus' );
	}

	function showProperties( folder, $sidebar ) {
		var $overlay;
		var $dialog;
		var $body;
		var $name;
		var $parent;
		var $access;
		var $effective;
		var $protectionSummary;
		var $message;
		var shortcode;
		var $shortcodeInput;

		if ( ! folder || folder.special || parseInt( folder.id, 10 ) <= 0 ) {
			return;
		}

		function close() {
			$( document ).off( '.pgmMoProperties' );
			$overlay.remove();
		}

		function updateEffectiveLabel() {
			var parentId = parseInt( $parent.val() || 0, 10 ) || 0;
			var parentFolder = parentId > 0 ? folderById( parentId ) : null;
			var inheritedAccess = parentFolder ? folderEffectiveAccess( parentFolder ) : 'public';
			var localAccess = $access.val() || 'public';
			var effectiveAccess = strongestAccess( localAccess, inheritedAccess );
			var summaryText = effectiveAccess === 'public'
				? t( 'folderProtectionPublicHelp', 'TÃ¤mÃ¤n kansion tiedostot ovat julkisia, ellei tiedostoa ole suojattu muusta lÃ¤hteestÃ¤.' )
				: t( 'folderProtectionActiveHelp', 'TÃ¤mÃ¤n kansion nykyiset tiedostot, alikansioiden tiedostot ja tÃ¤hÃ¤n myÃ¶hemmin siirretyt tiedostot suojataan automaattisesti.' );
			$effective
				.text( folderAccessLabel( effectiveAccess, false ) )
				.attr( 'class', 'pgm-mo-property-effective is-' + effectiveAccess );
			$protectionSummary
				.attr( 'class', 'pgm-mo-property-protection is-' + effectiveAccess )
				.empty()
				.append(
					$( '<div />' )
						.append( $( '<span />', { text: t( 'localFolderProtection', 'Kansion oma suojaus' ) } ) )
						.append( $( '<strong />', { text: folderAccessLabel( localAccess, false ) } ) ),
					$( '<div />' )
						.append( $( '<span />', { text: t( 'inheritedFolderProtection', 'Peritty suojaus' ) } ) )
						.append( $( '<strong />', { text: parentFolder ? folderAccessLabel( inheritedAccess, false ) : t( 'none', 'Ei' ) } ) ),
					$( '<p />', { text: summaryText } )
				);
		}

		$overlay = $( '<div />', { 'class': 'pgm-mo-modal-overlay' } );
		$dialog = $( '<div />', { 'class': 'pgm-mo-modal pgm-mo-properties-modal', role: 'dialog', 'aria-modal': 'true' } );
		$body = $( '<div />', { 'class': 'pgm-mo-modal-body pgm-mo-folder-properties' } );
		$name = $( '<input />', {
			type: 'text',
			'class': 'pgm-mo-property-input',
			value: folder.name || '',
		} );
		$parent = $( '<select />', { 'class': 'pgm-mo-property-input' } );
		$access = $( '<select />', { 'class': 'pgm-mo-property-input' } );
		$effective = $( '<span />' );
		$protectionSummary = $( '<div />' );
		$message = $( '<p />', { 'class': 'pgm-mo-modal-message', role: 'status' } );
		shortcode = buildGalleryShortcode( folder.id, { columns: 3, size: 'medium', link: 'file', limit: 100 } );
		$shortcodeInput = $( '<input />', {
			type: 'text',
			readonly: 'readonly',
			'class': 'pgm-mo-property-input pgm-mo-shortcode-input',
			value: shortcode,
		} );

		populateFolderParentOptions( $parent, parseInt( folder.parent || 0, 10 ) || 0, parseInt( folder.id, 10 ) || 0 );
		$.each( folderAccessChoices(), function( value, choice ) {
			$( '<option />', {
				value: value,
				text: choice.label || value,
			} ).prop( 'selected', String( value ) === String( folder.access || 'public' ) ).appendTo( $access );
		} );

		$parent.add( $access ).on( 'change', updateEffectiveLabel );

		$dialog.append(
			$( '<div />', { 'class': 'pgm-mo-modal-header' } )
				.append( $( '<h2 />', { text: t( 'properties', 'Ominaisuudet' ) } ) )
				.append( $( '<button />', { type: 'button', 'class': 'pgm-mo-modal-close', text: 'Ã—', title: t( 'close', 'Sulje' ) } ).on( 'click', close ) ),
			$body
		);

		$body.append(
			$( '<label />', { 'class': 'pgm-mo-property-row' } )
				.append( $( '<span />', { text: t( 'folderName', 'Kansion nimi' ) } ), $name ),
			$( '<div />', { 'class': 'pgm-mo-property-grid' } )
				.append(
					$( '<div />' ).append( $( '<span />', { text: t( 'propertyId', 'ID' ) } ), $( '<strong />', { text: folder.id } ) ),
					$( '<div />' ).append( $( '<span />', { text: t( 'propertyParent', 'YlÃ¤kansio' ) } ), $( '<strong />', { text: folder.parent || 0 } ) ),
					$( '<div />' ).append( $( '<span />', { text: t( 'propertyFiles', 'Tiedostot' ) } ), $( '<strong />', { text: folder.count || 0 } ) )
				),
			$( '<label />', { 'class': 'pgm-mo-property-row' } )
				.append( $( '<span />', { text: t( 'folderLocation', 'Sijainti' ) } ), $parent ),
			$( '<label />', { 'class': 'pgm-mo-property-row' } )
				.append( $( '<span />', { text: t( 'folderVisibility', 'Kansion nÃ¤kyvyys' ) } ), $access ),
			$( '<div />', { 'class': 'pgm-mo-property-row' } )
				.append( $( '<span />', { text: t( 'effectiveAccess', 'Voimassa oleva nÃ¤kyvyys' ) } ), $effective ),
			$protectionSummary,
			$( '<div />', { 'class': 'pgm-mo-property-row pgm-mo-shortcode-row' } )
				.append(
					$( '<span />', { text: t( 'galleryShortcode', 'Galleria-shortcode' ) } ),
					$( '<div />', { 'class': 'pgm-mo-shortcode-control' } )
						.append(
							$shortcodeInput,
							$( '<button />', { type: 'button', 'class': 'button pgm-mo-customize-shortcode' } )
								.append( icon( 'settings' ), $( '<span />', { text: t( 'customizeShortcode', 'Muokkaa' ) } ) )
								.on( 'click', function() {
									showGalleryShortcodeBuilder( folder, shortcode, function( nextShortcode ) {
										shortcode = nextShortcode;
										$shortcodeInput.val( shortcode );
										$message.removeClass( 'is-error' ).text( t( 'done', 'Valmis.' ) );
									} );
								} ),
							$( '<button />', { type: 'button', 'class': 'button pgm-mo-copy-shortcode' } )
								.append( icon( 'copy' ), $( '<span />', { text: t( 'copyShortcode', 'Kopioi' ) } ) )
								.on( 'click', function() {
									copyTextToClipboard( shortcode )
										.done( function() {
											$message.removeClass( 'is-error' ).text( t( 'shortcodeCopied', 'Shortcode kopioitu.' ) );
											$shortcodeInput.trigger( 'focus' ).trigger( 'select' );
										} )
										.fail( function() {
											$message.addClass( 'is-error' ).text( t( 'shortcodeCopyFailed', 'Shortcodea ei voitu kopioida.' ) );
										} );
								} )
						)
				),
			$( '<div />', { 'class': 'pgm-mo-property-actions' } )
				.append(
					$( '<button />', { type: 'button', 'class': 'button', text: t( 'delete', 'Poista' ) } )
						.on( 'click', function() {
							close();
							deleteFolder( folder, $sidebar );
						} ),
					$( '<button />', { type: 'button', 'class': 'button button-primary', text: t( 'saveProperties', 'Tallenna ominaisuudet' ) } )
						.on( 'click', function() {
							var name = $.trim( $name.val() );
							if ( ! name ) {
								$message.addClass( 'is-error' ).text( t( 'folderNameRequired', 'Anna kansion nimi.' ) );
								return;
							}

							$message.removeClass( 'is-error' ).text( t( 'saving', 'Saving...' ) );
							ajax( 'pecodex_mo_update_folder', {
								folder_id: folder.id,
								name: name,
								parent: parseInt( $parent.val() || 0, 10 ) || 0,
								access: $access.val() || 'public',
							} )
								.done( function( response ) {
									if ( ! response || ! response.success ) {
										$message.addClass( 'is-error' ).text( response && response.data && response.data.message ? response.data.message : t( 'error', 'Action failed.' ) );
										return;
									}

									state.folders = response.data.folders || [];
									state.flatFolders = response.data.flatFolders || []; if (response.data && response.data.counts) { state.counts = response.data.counts; }
									renderAllSidebars();
									refreshGridIfPossible( $sidebar );
									setMessage( $sidebar, response.data.message || t( 'done', 'Done.' ) );
									close();
								} )
								.fail( function( xhr ) {
									var message = xhr.responseJSON && xhr.responseJSON.data && xhr.responseJSON.data.message ? xhr.responseJSON.data.message : t( 'error', 'Action failed.' );
									$message.addClass( 'is-error' ).text( message );
								} );
						} )
				),
			$message
		);

		$overlay.append( $dialog );
		$( document.body ).append( $overlay );
		$overlay.on( 'mousedown', function( event ) {
			if ( event.target === $overlay[0] ) {
				close();
			}
		} );
		$( document ).on( 'keydown.pgmMoProperties', function( event ) {
			if ( event.key === 'Escape' ) {
				close();
			}
		} );
		updateEffectiveLabel();
		$name.trigger( 'focus' );
		if ( $name[0] && $name[0].select ) {
			$name[0].select();
		}
	}

	function persistSidebarWidth() {
		ajax( 'pecodex_mo_save_preferences', {
			preferences: preferencesPayload(),
		} )
			.done( function( response ) {
				if ( response && response.success ) {
					config.options = response.data.options || config.options;
					state.preferences = normalizeOptions( config.options || {} );
					applySidebarWidth( state.preferences.folderTreeWidth );
				}
			} );
	}

	function buildSidebarResizer( $sidebar ) {
		return $( '<span />', {
			'class': 'pgm-mo-sidebar-resizer',
			role: 'separator',
			'aria-orientation': 'vertical',
			'aria-label': t( 'resizeSidebar', 'Muuta sivupalkin leveyttÃ¤' ),
			title: t( 'resizeSidebar', 'Muuta sivupalkin leveyttÃ¤' ),
		} )
			.on( 'mousedown', function( event ) {
				var source = event.originalEvent || event;
				var startX = source.clientX;
				var startWidth = clampSidebarWidth( state.preferences.folderTreeWidth || $sidebar.outerWidth() );

				event.preventDefault(); event.stopPropagation();
				event.stopPropagation();
				$( document.body ).addClass( 'pgm-mo-resizing-sidebar' );

				$( document )
					.off( '.pgmMoSidebarResize' )
					.on( 'mousemove.pgmMoSidebarResize', function( moveEvent ) {
						var moveSource = moveEvent.originalEvent || moveEvent;
						moveEvent.preventDefault();
						moveEvent.stopPropagation();
						applySidebarWidth( startWidth + moveSource.clientX - startX );
					} )
					.on( 'mouseup.pgmMoSidebarResize', function( upEvent ) {
						upEvent.preventDefault();
						upEvent.stopPropagation();
						$( document ).off( '.pgmMoSidebarResize' );
						$( document.body ).removeClass( 'pgm-mo-resizing-sidebar' );
						persistSidebarWidth();
					} );
			} )
			.on( 'dragstart', function( event ) {
				event.preventDefault(); event.stopPropagation();
				event.stopPropagation();
				return false;
			} );
	}

	function buildSidebar() {
		var $sidebar = $( '<aside />', { 'class': 'pgm-mo-sidebar pecodex-media-library-sidebar', 'aria-label': brandName } );
		var $tree = $( '<ul />', { 'class': 'pgm-mo-tree' } );
		var $folderName = $( '<input />', {
			type: 'text',
			'class': 'pgm-mo-folder-search',
			placeholder: t( 'folderSearchPlaceholder', 'Kirjoita kansion nimi...' ),
			value: state.filterText,
		} );

		$folderName.on( 'input', function() {
			state.filterText = $( this ).val();
			renderSidebarTree( $sidebar );
		} );
		$folderName.on( 'keydown', function( event ) {
			if ( event.key === 'Enter' && $.trim( this.value ) ) {
				createFolder( state.selectedFolder > 0 ? state.selectedFolder : 0, $sidebar, $.trim( this.value ) );
				this.value = '';
				state.filterText = '';
			}
		} );

		$sidebar.append(
			$( '<div />', { 'class': 'pgm-mo-header' } )
				.append( $( '<strong />', { text: brandName } ) )
				.append(
					$( '<button />', { type: 'button', 'class': 'pgm-mo-icon-button', title: t( 'settings', 'Asetukset' ) } )
						.append( icon( 'admin-generic' ) )
						.on( 'click', openSettingsModal )
				),
			buildPrimaryToolbar( $sidebar ),
			buildSecondaryToolbar( $sidebar ),
			buildBulkPrivacyToolbar( $sidebar ),
			$( '<div />', { 'class': 'pgm-mo-search-wrap' } ).append( $folderName ),
			$tree,
			$( '<p />', { 'class': 'pgm-mo-message', role: 'status' } ),
			buildSidebarResizer( $sidebar )
		);

		renderSidebarTree( $sidebar );

		$sidebar.css( '--pgm-mo-tree-width', clampSidebarWidth( state.preferences.folderTreeWidth ) + 'px' );
		return $sidebar;
	}

	function renderSidebarTree( $sidebar ) {
		var $tree = $sidebar.find( '.pgm-mo-tree' ).empty();

		state.folders.forEach( function( folder ) {
			if ( folderVisible( folder ) ) {
				renderFolderNode( folder, $tree, 0, $sidebar );
			}
		} );
	}

	function buildPrimaryToolbar( $sidebar ) {
		var $toolbar = $( '<div />', { 'class': 'pgm-mo-toolbar pgm-mo-toolbar-primary' } );

		$( '<button />', { type: 'button', 'class': 'button button-primary pgm-mo-new-folder' } )
			.append( icon( 'plus' ), $( '<span />', { text: t( 'newFolder', 'Uusi kansio' ) } ) )
			.on( 'click', function() {
				createFolder( state.selectedFolder > 0 ? state.selectedFolder : 0, $sidebar );
			} )
			.appendTo( $toolbar );

		$( '<button />', { type: 'button', 'class': 'pgm-mo-icon-button', title: t( 'sort', 'JÃ¤rjestys' ) } )
			.append( icon( 'sort' ) )
			.on( 'click', function() {
				state.sort = state.sort === 'date_desc' ? 'title_asc' : 'date_desc';
				refreshGridIfPossible( $sidebar );
			} )
			.appendTo( $toolbar );

		$( '<button />', { type: 'button', 'class': 'pgm-mo-icon-button', title: t( 'collapseAll', 'Sulje kaikki kansiot' ) } )
			.append( icon( 'no-alt' ) )
			.on( 'click', function() {
				state.expanded = {};
				renderAllSidebars();
			} )
			.appendTo( $toolbar );

		$( '<button />', { type: 'button', 'class': 'pgm-mo-icon-button', title: t( 'expandAll', 'Avaa kaikki kansiot' ) } )
			.append( icon( 'arrow-down-alt2' ) )
			.on( 'click', function() {
				walkFolders( state.folders, function( folder ) {
					state.expanded[ folder.id ] = true;
				} );
				renderAllSidebars();
			} )
			.appendTo( $toolbar );

		return $toolbar;
	}

	function buildBulkPrivacyToolbar( $sidebar ) {
		var $toolbar = $( '<div />', { 'class': 'pgm-mo-bulk-privacy-actions' } );

		$( '<button />', {
			type: 'button',
			'class': 'button button-primary pgm-mo-bulk-privacy-button is-protect',
			title: t( 'bulkProtectTitle', 'Suojaa valitut mediatiedostot' ),
		} )
			.append( icon( 'lock' ), $( '<span />', { 'class': 'pgm-mo-button-label', text: t( 'bulkProtect', 'Suojaa valitut' ) } ) )
			.on( 'click', function() {
				showBulkPrivacyModal( 'hide', $sidebar );
			} )
			.appendTo( $toolbar );

		$( '<button />', {
			type: 'button',
			'class': 'button pgm-mo-bulk-privacy-button is-unprotect',
			title: t( 'bulkUnprotectTitle', 'Poista suojaus valituilta mediatiedostoilta' ),
		} )
			.append( icon( 'unlock' ), $( '<span />', { 'class': 'pgm-mo-button-label', text: t( 'bulkUnprotect', 'Poista suojaus' ) } ) )
			.on( 'click', function() {
				showBulkPrivacyModal( 'make_public', $sidebar );
			} )
			.appendTo( $toolbar );

		$( '<button />', {
			type: 'button',
			'class': 'button pgm-mo-bulk-privacy-button is-move-folder',
			title: t( 'moveToFolderTitle', 'SiirrÃ¤ mediatiedostot kansioon' ),
		} )
			.append( icon( 'folder' ), $( '<span />', { 'class': 'pgm-mo-button-label', text: t( 'moveFiles', 'SiirrÃ¤' ) } ) )
			.on( 'click', function() {
				showMoveMediaModal( null, $sidebar );
			} )
			.appendTo( $toolbar );

		$( '<button />', {
			type: 'button',
			'class': 'button pgm-mo-bulk-privacy-button is-duplicate',
			title: t( 'duplicateSelected', 'Monista valitut' ),
		} )
			.append( icon( 'files' ), $( '<span />', { 'class': 'pgm-mo-button-label', text: t( 'duplicate', 'Monista' ) } ) )
			.on( 'click', function() {
				showDuplicateMediaModal( null, $sidebar );
			} )
			.appendTo( $toolbar );

		$( '<button />', {
			type: 'button',
			'class': 'button pgm-mo-bulk-privacy-button is-export' + ( parseInt( state.selectedFolder, 10 ) > 0 ? '' : ' is-wide' ),
			title: t( 'exportSelected', 'Vie valitut ZIPiksi' ),
		} )
			.append( icon( 'download' ), $( '<span />', { 'class': 'pgm-mo-button-label', text: t( 'exportZipShort', 'Vie ZIP' ) } ) )
			.on( 'click', function() {
				showExportZipModal( null, $sidebar );
			} )
			.appendTo( $toolbar );

		if ( parseInt( state.selectedFolder, 10 ) > 0 ) {
			$( '<button />', {
				type: 'button',
				'class': 'button pgm-mo-bulk-privacy-button is-remove-folder',
				title: t( 'removeFromFolderTitle', 'Irrota valitut tiedostot tÃ¤stÃ¤ kansiosta poistamatta mediatiedostoja.' ),
			} )
				.append( icon( 'folder-x' ), $( '<span />', { 'class': 'pgm-mo-button-label', text: t( 'removeFromFolderShort', 'Irrota' ) } ) )
				.on( 'click', function() {
					showRemoveFromFolderModal( null, $sidebar );
				} )
				.appendTo( $toolbar );
		}

		return $toolbar;
	}

	function buildSecondaryToolbar( $sidebar ) {
		var $toolbar = $( '<div />', { 'class': 'pgm-mo-toolbar pgm-mo-toolbar-secondary' } );
		var hasRealFolder = parseInt( state.selectedFolder, 10 ) > 0;

		$( '<button />', {
			type: 'button',
			'class': 'button pgm-mo-secondary-action',
			title: t( 'rename', 'NimeÃ¤ uudelleen' ),
			disabled: ! hasRealFolder,
		} )
			.append( icon( 'edit' ), $( '<span />', { 'class': 'pgm-mo-button-label', text: t( 'renameShort', 'NimeÃ¤' ) } ) )
			.on( 'click', function() {
				renameFolder( folderById( state.selectedFolder ), $sidebar );
			} )
			.appendTo( $toolbar );

		$( '<button />', {
			type: 'button',
			'class': 'button pgm-mo-secondary-action',
			title: t( 'delete', 'Poista' ),
			disabled: ! hasRealFolder,
		} )
			.append( icon( 'trash' ), $( '<span />', { 'class': 'pgm-mo-button-label', text: t( 'deleteShort', 'Poista' ) } ) )
			.on( 'click', function() {
				deleteFolder( folderById( state.selectedFolder ), $sidebar );
			} )
			.appendTo( $toolbar );

		$( '<button />', {
			type: 'button',
			'class': 'button pgm-mo-secondary-action',
			title: t( 'bulkSelectTitle', 'Valitse useita kerralla' ),
		} )
			.append( icon( 'check-square' ), $( '<span />', { 'class': 'pgm-mo-button-label', text: t( 'bulkSelect', 'Valitse' ) } ) )
			.on( 'click', function() {
				triggerBulkSelect( $sidebar );
			} )
			.appendTo( $toolbar );

		return $toolbar;
	}

	function openSettingsModal() {
		var $overlay = $( '<div />', { 'class': 'pgm-mo-modal-overlay' } );
		var $dialog = $( '<div />', { 'class': 'pgm-mo-modal', role: 'dialog', 'aria-modal': 'true' } );

		function close() {
			$overlay.remove();
		}

		$dialog.append(
			$( '<div />', { 'class': 'pgm-mo-modal-header' } )
				.append( $( '<h2 />', { text: t( 'settings', 'Asetukset' ) } ) )
				.append( $( '<button />', { type: 'button', 'class': 'pgm-mo-modal-close', text: 'Ã—', title: t( 'close', 'Sulje' ) } ).on( 'click', close ) ),
			$( '<div />', { 'class': 'pgm-mo-modal-body' } )
		);
		$overlay.append( $dialog );
		$( document.body ).append( $overlay );
		renderSettingsMain( $dialog.find( '.pgm-mo-modal-body' ) );
	}

	function renderSettingsMain( $body ) {
		$body.empty().append(
			$( '<div />', { 'class': 'pgm-mo-setting-group' } )
				.append( $( '<label />', { text: t( 'libraryLayoutSettings', 'Mediakirjaston nÃ¤kymÃ¤' ) } ) )
				.append(
					$( '<button />', { type: 'button', 'class': 'pgm-mo-manage-card' } )
						.append(
							$( '<span />' ).append( $( '<strong />', { text: t( 'manageLibraryLayoutSettings', 'Hallitse nÃ¤kymÃ¤Ã¤ ja kansiopuuta' ) } ), $( '<small />', { text: libraryLayoutSummaryText() } ) ),
							$( '<span />', { 'class': 'pgm-mo-card-arrow', text: '>' } )
						)
						.on( 'click', function() {
							renderLibraryLayoutSettings( $body );
						} )
				),
			config.canManagePrivateSettings ? $( '<div />', { 'class': 'pgm-mo-setting-group' } )
				.append( $( '<label />', { text: t( 'privateMediaSettings', 'Suojaus ja kirjautuminen' ) } ) )
				.append(
					$( '<button />', { type: 'button', 'class': 'pgm-mo-manage-card' } )
						.append(
							$( '<span />' ).append( $( '<strong />', { text: t( 'managePrivateMediaSettings', 'Hallitse suojausasetuksia' ) } ), $( '<small />', { text: t( 'privateMediaSettingsSummary', 'Login, tiedostopÃ¤Ã¤tteet ja private-varasto' ) } ) ),
							$( '<span />', { 'class': 'pgm-mo-card-arrow', text: '>' } )
						)
						.on( 'click', function() {
							renderPrivateMediaSettings( $body );
						} )
				) : $(),
			config.canManagePrivateSettings ? $( '<div />', { 'class': 'pgm-mo-setting-group' } )
