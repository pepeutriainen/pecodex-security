						} ),
					$( '<h3 />', { text: t( 'libraryLayoutSettings', 'Mediakirjaston nÃ¤kymÃ¤' ) } ),
					$( '<p />', { 'class': 'description', text: t( 'libraryLayoutSettingsHelp', 'SÃ¤Ã¤dÃ¤ ruudukon, jÃ¤rjestyksen, haun ja kansiopuun oletukset yhdessÃ¤ paikassa.' ) } )
				),
			settingSelect( t( 'defaultStartupFolder', 'Oletuskansio avattaessa' ), folderSelectChoices(), state.preferences.startupFolder, function( value ) {
				state.preferences.startupFolder = parseInt( value, 10 ) || 0;
			} ),
			settingSwitch( t( 'infiniteScrollGrid', 'Jatkuva vieritys ruudukkonÃ¤kymÃ¤ssÃ¤' ), state.preferences.infiniteScrollGrid, function( value ) {
				state.preferences.infiniteScrollGrid = value;
			} ),
			settingSelect( t( 'gridSize', 'Ruudukkokoko' ), { small: t( 'gridSmall', 'Pieni' ), medium: t( 'gridMedium', 'Keskikokoinen' ), large: t( 'gridLarge', 'Suuri' ) }, state.preferences.gridSize, function( value ) {
				state.preferences.gridSize = value;
			} ),
			settingSelect( t( 'defaultSort', 'OletusjÃ¤rjestys' ), config.sortOptions || {}, state.preferences.defaultSort, function( value ) {
				state.preferences.defaultSort = value || 'date_desc';
			} ),
			settingSwitch( t( 'deepSearchDefault', 'Hae metatiedoista oletuksena' ), state.preferences.deepSearchDefault, function( value ) {
				state.preferences.deepSearchDefault = value;
			} ),
			settingSwitch( t( 'showFileCounts', 'NÃ¤ytÃ¤ tiedostomÃ¤Ã¤rÃ¤t' ), state.preferences.showCounts, function( value ) {
				state.preferences.showCounts = value;
			} ),
			settingSwitch( t( 'includeChildren', 'SisÃ¤llytÃ¤ alikansiot' ), state.preferences.includeChildren, function( value ) {
				state.preferences.includeChildren = value;
			} ),
			settingSwitch( t( 'showEmptyFolders', 'NÃ¤ytÃ¤ tyhjÃ¤t kansiot' ), state.preferences.showEmptyFolders, function( value ) {
				state.preferences.showEmptyFolders = value;
			} ),
			$saveButton,
			$message
		);
	}

	function aboutRow( label, value ) {
		return $( '<div />', { 'class': 'pgm-mo-about-row' } )
			.append(
				$( '<span />', { text: label } ),
				$( '<strong />', { text: value || '-' } )
			);
