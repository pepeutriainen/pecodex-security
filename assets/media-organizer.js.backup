		$.pgmMoMediaQueryFilterBridgeInstalled = true;
	}

	function exportUrl( folderId, attachmentIds ) {
		var url = new URL( config.adminPostUrl, window.location.origin );
		url.searchParams.set( 'action', config.exportAction || 'pecodex_mo_export' );
		url.searchParams.set( '_wpnonce', config.nonce );
		url.searchParams.set( queryArgs.folder, folderId || 0 );

		if ( attachmentIds && attachmentIds.length ) {
			url.searchParams.set( 'attachment_ids', attachmentIds.join( ',' ) );
		}

		return url.toString();
	}

	function currentMediaFrame( context ) {
		var frame = null;

		if ( context && context.state ) {
			return context;
		}

		if ( context && context.jquery ) {
			frame = frameFromElement( context );
			if ( frame ) {
				return frame;
			}
		}

		if ( context && context.$el && context.$el.jquery ) {
			frame = frameFromElement( context.$el );
			if ( frame ) {
				return frame;
			}
		}

		frame = frameFromBrowser( context );
		if ( frame ) {
			return frame;
		}

		// upload.php-sivulla (Media Library) wp.media.frame on aina oikea pÃ¤Ã¤frame
		// Grid-nÃ¤kymÃ¤ssÃ¤. Emme halua kÃ¤yttÃ¤Ã¤ activeMediaFramea tÃ¤Ã¤llÃ¤, koska jokin
		// muu skripti on voinut luoda piilotetun framen ja kaapata active-viitteen.
		if ( isUploadLibraryScreen() && wp && wp.media ) {
			if ( wp.media.frames && wp.media.frames.browse ) {
				return wp.media.frames.browse;
			}
			if ( wp.media.frame ) {
				return wp.media.frame;
			}
		}

		// GutenbergissÃ¤ ja muissa modaaleissa kÃ¤ytÃ¤mme omaa aktiivista viitettÃ¤,
		// koska wp.media.frame ei aina pÃ¤ivity oikein.
		if ( activeMediaFrame ) {
			try {
				// Varmistetaan ettÃ¤ frame on vielÃ¤ elÃ¤vÃ¤ (ei suljettu)
				if ( activeMediaFrame.state ) {
					return activeMediaFrame;
				}
			} catch ( e ) {}
			activeMediaFrame = null;
		}

		// Viimeinen fallback
		return wp && wp.media && wp.media.frame ? wp.media.frame : null;
	}

	function isOrganizerPage() {
		var page = requestUrl.searchParams.get( 'page' );
		var slug = config.adminPageSlug || 'pecodex-media-library';
		var legacySlug = config.legacyAdminPageSlug || 'pgm-media-organizer';

		return page === slug || page === legacySlug;
	}

	function isUploadLibraryScreen() {
		return $( document.body ).hasClass( 'upload-php' ) && ! isOrganizerPage();
	}

	function isModalBrowser( $browser ) {
		return $browser.closest( '.media-modal, .media-modal-content' ).length > 0;
	}

	function frameFromBrowser( browser ) {
		if ( browser && browser.controller && browser.controller.state ) {
			return browser.controller;
		}
		if ( browser && browser.options && browser.options.controller && browser.options.controller.state ) {
			return browser.options.controller;
		}
		return null;
	}

	function frameFromElement( $context ) {
		var frame;
		var browser;
		var $browser;
		var $modal;

		if ( ! $context || ! $context.length ) {
			return null;
		}

		frame = $context.data( 'pgmMoFrame' );
		if ( frame && frame.state ) {
			return frame;
		}

		browser = $context.data( 'pgmMoBrowserView' );
		frame = frameFromBrowser( browser );
		if ( frame ) {
			return frame;
		}

		$browser = $context.hasClass( 'attachments-browser' ) ? $context : $context.closest( '.attachments-browser' );
		if ( $browser.length ) {
			frame = $browser.data( 'pgmMoFrame' );
			if ( frame && frame.state ) {
				return frame;
			}
			browser = $browser.data( 'pgmMoBrowserView' );
			frame = frameFromBrowser( browser );
			if ( frame ) {
				return frame;
			}
		}

		$modal = $context.closest( '.media-modal, .media-modal-content, .media-frame' );
		if ( $modal.length ) {
			$browser = $modal.find( '.attachments-browser' ).first();
			browser = $browser.data( 'pgmMoBrowserView' );
			frame = frameFromBrowser( browser ) || $browser.data( 'pgmMoFrame' );
			if ( frame && frame.state ) {
				return frame;
			}
		}

		return null;
	}

	function mediaRootFromContext( context ) {
		var $context = $();
		var $root;

		if ( context && context.jquery ) {
			$context = context;
		} else if ( context && context.$el && context.$el.jquery ) {
			$context = context.$el;
		}

		if ( $context.length ) {
			$root = $context.hasClass( 'attachments-browser' ) ? $context : $context.closest( '.attachments-browser' );
			if ( $root.length ) {
				return $root;
			}

			$root = $context.hasClass( 'attachments' ) ? $context : $context.closest( '.attachments' );
			if ( $root.length ) {
				return $root;
			}

			$root = $context.closest( '.upload-php .wrap' );
			if ( $root.length ) {
				return $root;
			}

			$root = $context.closest( '.media-frame, .media-modal, .media-modal-content' ).find( '.attachments-browser' ).first();
			if ( $root.length ) {
				return $root;
			}
		}

		if ( isUploadLibraryScreen() ) {
			$root = $( '.upload-php .wrap' ).first();
			if ( $root.length ) {
				return $root;
			}
		}

		return $();
	}

	function libraryFromFrame( frame ) {
		if ( frame.browserView && frame.browserView.collection && frame.browserView.collection.props ) {
			return frame.browserView.collection;
		}

		if ( frame.state ) {
			try {
				var stateModel = frame.state();
				if ( stateModel && stateModel.get ) {
					var stateLib = stateModel.get( 'library' );
					if ( stateLib && stateLib.props ) {
						return stateLib;
					}
				}
			} catch ( error ) {}
		}

		if ( frame.library && frame.library.props ) {
			return frame.library;
		}

		if ( frame.content && typeof frame.content.get === 'function' ) {
			try {
				var content = frame.content.get();
				if ( content && content.collection && content.collection.props ) {
					return content.collection;
				}
			} catch ( error ) {}
		}

		return null;
	}

	function libraryFromBrowser( browser ) {
		var library = browser && ( browser.collection || ( browser.options && browser.options.library ) );
		var frame;

		if ( library && library.props ) {
			return library;
		}

		frame = frameFromBrowser( browser );
		return frame ? libraryFromFrame( frame ) : null;
	}

	function libraryFromSidebar( $sidebar ) {
		var browser = null;
		var $browser;
		var frame;
		var library;

		if ( ! $sidebar || ! $sidebar.length ) {
			return null;
		}

		browser = $sidebar.data( 'pgmMoBrowserView' ) || null;
		library = libraryFromBrowser( browser );
		if ( library ) {
			return library;
		}

		$browser = $sidebar.closest( '.attachments-browser' );
		browser = $browser.length ? $browser.data( 'pgmMoBrowserView' ) : null;
		library = libraryFromBrowser( browser );
		if ( library ) {
			return library;
		}

		frame = $sidebar.data( 'pgmMoFrame' ) || frameFromBrowser( browser );
		return frame ? libraryFromFrame( frame ) : null;
