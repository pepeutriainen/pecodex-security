			'settings': '<path d="M12.2 2h-.4a2 2 0 0 0-2 1.7l-.2 1.2a7.8 7.8 0 0 0-1.7 1l-1.1-.5a2 2 0 0 0-2.5.9l-.2.3a2 2 0 0 0 .4 2.6l1 .7a7.6 7.6 0 0 0 0 2l-1 .7a2 2 0 0 0-.4 2.6l.2.3a2 2 0 0 0 2.5.9l1.1-.5a7.8 7.8 0 0 0 1.7 1l.2 1.2a2 2 0 0 0 2 1.7h.4a2 2 0 0 0 2-1.7l.2-1.2a7.8 7.8 0 0 0 1.7-1l1.1.5a2 2 0 0 0 2.5-.9l.2-.3a2 2 0 0 0-.4-2.6l-1-.7a7.6 7.6 0 0 0 0-2l1-.7a2 2 0 0 0 .4-2.6l-.2-.3a2 2 0 0 0-2.5-.9l-1.1.5a7.8 7.8 0 0 0-1.7-1l-.2-1.2a2 2 0 0 0-2-1.7Z"></path><circle cx="12" cy="12" r="3"></circle>',
			'trash-2': '<path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path>',
